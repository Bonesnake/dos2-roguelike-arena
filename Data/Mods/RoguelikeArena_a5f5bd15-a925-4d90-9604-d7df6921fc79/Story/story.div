		//END_REGION
		
	}
	KB
	{
		PROC
		PROC_Init_SetItemOwners("FJ_FortJoy_Main")
		THEN
		ItemClearOwner(ITEMGUID_S_FTJ_KitchenLadder_001_27ba0050-2124-4d0f-aaae-6b3af5b3ca85);
		
		IF
		CharacterEnteredTrigger(_Player,_Trigger)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_OwnershipTrigger(_Trigger)
		AND
		NOT DB_CombatCharacters(_Player,_)
		THEN
		PROC_CheckPlayTut(_Player,"TUT_GenericBehaviors");
		
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 5, 1, 0)
		THEN
		DB_ItemOwnerShipClearItem("RC_Main",ITEMGUID_S_RC_DW_ToUndertavernStairs_OnStage_8464a78a-67a7-4298-ab61-a3d6be429839);
		NOT DB_ItemOwnerShipClearItem("RC_Main",ITEMGUID_S_RC_DW_ToUndertavernStairs_404ed36a-1b24-48de-963b-2ac07950ad1f);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		THEN
		DB_ItemOwnerShipClearItem("RC_Main", ITEMGUID_S_RC_DW_PrisonChest_1bcfff11-39b2-4dc9-b4b0-3af19e7d4f45);
		DB_ItemOwnerShipClearItem("RC_Main", ITEMGUID_S_RC_DW_Prison_EvidenceChest_f7409bd4-3673-48b2-a761-8a063734e665);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_CurrentLevel("RC_Main")
		THEN
		ItemClearOwner(ITEMGUID_S_RC_DW_PrisonChest_1bcfff11-39b2-4dc9-b4b0-3af19e7d4f45);
		ItemClearOwner(ITEMGUID_S_RC_DW_Prison_EvidenceChest_f7409bd4-3673-48b2-a761-8a063734e665);
		
	}
	EXIT
	{
		
	}
}
