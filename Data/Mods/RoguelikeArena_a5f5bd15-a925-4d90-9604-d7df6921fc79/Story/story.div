		//Divine Tomb
		DB_Subregion(TRIGGERGUID_S_ARX_DivineTomb_Interlude_SubregionBox_7db10798-bde6-4d78-b831-44d08f8e06fd,"ARX_DivineTomb_Interlude",0);
