		DB_ARX_Cathedral_EndlessPrayer_Pilgrims((CHARACTERGUID)CHARACTERGUID_S_RC_ARX_Cathedral_EndlessPrayer_Pilgrim_08_9b29c5c9-4e6b-4e65-969d-049ce0110d57);
