		PROC
		Proc_DialogFlagSetup((STRING)_Dialog,(GUIDSTRING)_Speaker1,(GUIDSTRING)_Speaker2,(GUIDSTRING)_Speaker3, (GUIDSTRING)_Speaker4, (GUIDSTRING)_Speaker5)
		AND
		DB_GLO_CheckSpeakerNumber(_Speaker2, (REAL)_Dist)
		AND
