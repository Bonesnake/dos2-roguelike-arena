		DB_RoguelikeArena_Skills("Wolf", 4, 0, 0, "Projectile_EnemyFlight_Wolf");
		
		DB_RoguelikeArena_Skills("Wolf", 1, 0, 0, "Target_EnemyHaste_Wolf");
		
		DB_RoguelikeArena_Skills("Wolf", 1, 0, 0, "Target_EnemyCripplingBlow_Wolf");
		DB_RoguelikeArena_Skills("Wolf", 4, 0, 0, "Target_EnemyEnrage_Wolf");
		//END_REGION
		
		//REGION Sourcehound
		DB_RoguelikeArena_Skills("Sourcehound_Melee", 1, 0, 0, "Target_EnemyCripplingBlow");
		DB_RoguelikeArena_Skills("Sourcehound_Melee", 4, 0, 0, "Target_EnemyEnrage");
		DB_RoguelikeArena_Skills("Sourcehound_Melee", 16, 0, 0, "Target_EnemyChallenge");
		
		DB_RoguelikeArena_Skills("Sourcehound_Ranger", 4, 0, 0, "Projectile_EnemyHoundDart");
		DB_RoguelikeArena_Skills("Sourcehound_Ranger", 4, 0, 0, "Projectile_EnemyHoundDart_Fire");
		//END_REGION
		//END_REGION
		
		//DB_RoguelikeArena_Skills(1, 0, "CROC", "Target_EnemyFortify");
		//DB_RoguelikeArena_Skills(1, 0, "CROC", "Projectile_EnemyPyroclasticRock");
		//DB_RoguelikeArena_Skills(1, 0, "CROC", "Target_EnemySerratedEdge");
		//DB_RoguelikeArena_Skills(1, 0, "CROC", "Jump_EnemyCrocodileJump");
		//
		//DB_RoguelikeArena_Skills(1, 0, "TURT", "Projectile_EnemyTurtleBubbles");
		//DB_RoguelikeArena_Skills(1, 0, "TURT", "Rush_EnemyTurtleBatteringRam");
		//DB_RoguelikeArena_Skills(1, 0, "TURT", "Target_EnemyTurtleRockSpikes");
		//
		//DB_RoguelikeArena_Skills(1, 0, "SALA", "Cone_EnemyFlamebreath_Salamander");
		//
		//DB_RoguelikeArena_Skills(1, 0, "BEAR", "Quake_EnemyEarthquake_Bear");
		//
		//DB_RoguelikeArena_Skills(1, 0, "BEET", "Cone_EnemyCorrosiveSpray_Beetle");
		//DB_RoguelikeArena_Skills(1, 0, "BEET", "Jump_EnemyBeetleJump");
		//DB_RoguelikeArena_Skills(1, 0, "BEET", "Projectile_EnemyBeetleDart");
		//DB_RoguelikeArena_Skills(1, 0, "BEET", "Projectile_EnemyBeetleDart_Poison");
		//DB_RoguelikeArena_Skills(1, 0, "BEET", "Projectile_EnemyFlare_Beetle");
		//
		//DB_RoguelikeArena_Skills(1, 0, "BULL", "Rush_EnemyBullRush");
		//END_REGION
		
	}
	KB
	{
		//REGION Equipment
		// Sets equipment level of the character to the specified level.
		PROC
		PROC_RoguelikeArena_CharacterLevelUpEquipmentTo((CHARACTERGUID)_Character, (INTEGER)_Level)
		AND
		DB_RoguelikeArena_EquipmentSlots(_Slot)
		AND
		CharacterGetEquippedItem(_Character, _Slot, _Item)
		THEN
		ItemLevelUpTo((ITEMGUID)_Item, _Level);
		// CharacterUnequipItem(_Character, (ITEMGUID)_Item);
		// CharacterEquipItem(_Character, (ITEMGUID)_Item);
		
		// Prevents a visual bug.
		PROC
		PROC_RoguelikeArena_CharacterLevelUpEquipmentTo((CHARACTERGUID)_Character, (INTEGER)_Level)
		THEN
		ApplyStatus(_Character, "RESTED", 0.0, 0, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION Skills
		PROC
		PROC_RoguelikeArena_CharacterAddRandomSkills((CHARACTERGUID)_Character, (INTEGER)_Level, (INTEGER)_Rank, (STRING)_Class, (STRING)_Specialization)
		AND
		QRY_RoguelikeArena_SetCurrentCharacterSkillCount(_Level, _Rank)
		AND
		DB_Singleton("RoguelikeArena_CurrentCharacterSkillCount", _SkillCount)
		AND
		QRY_RoguelikeArena_SetCurrentCharacterSourceSkillCount(_Level, _Rank)
		AND
		DB_Singleton("RoguelikeArena_CurrentCharacterSourceSkillCount", _SourceSkillCount)
		THEN
		PROC_RoguelikeArena_CharacterAddRandomSkills(_Character, _Level, _Rank, _Class, _Specialization, 0, _SkillCount);
		PROC_RoguelikeArena_CharacterAddRandomSkills(_Character, _Level, _Rank, _Class, _Specialization, 1, _SourceSkillCount);
		
		// Adds skills to the pool.
		PROC
		PROC_RoguelikeArena_CharacterAddRandomSkills((CHARACTERGUID)_Character, (INTEGER)_Level, (INTEGER)_Rank, (STRING)_Class, (STRING)_Specialization, (INTEGER)_Source, (INTEGER)_Count)
		THEN
		PROC_RoguelikeArena_StringPoolClear("SkillPool");
		PROC_RoguelikeArena_StringPoolAddSkills(_Class, _Level, _Rank, _Source);
		PROC_RoguelikeArena_StringPoolAddSkills(_Specialization, _Level, _Rank, _Source);
		
		// Creates "loop" for adding the skills.
		PROC
		PROC_RoguelikeArena_CharacterAddRandomSkills((CHARACTERGUID)_Character, (INTEGER)_Level, (INTEGER)_Rank, (STRING)_Class, (STRING)_Specialization, (INTEGER)_Source, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		PROC_RoguelikeArena_CharacterAddRandomSkill(_Character);
		
		// Selects a random skill from the pool and adds it to the character.
		PROC
		PROC_RoguelikeArena_CharacterAddRandomSkill((CHARACTERGUID)_Character)
		AND
		QRY_RoguelikeArena_StringPoolSelectAndRemoveRandom("SkillPool")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("SkillPool", _Skill)
		THEN
		CharacterAddSkill(_Character, _Skill, 0);
		
		// Adds skills to the pool.
		PROC
		PROC_RoguelikeArena_StringPoolAddSkills((STRING)_Category, (INTEGER)_LevelLimit, (INTEGER)_RankLimit, (INTEGER)_Source)
		AND
		DB_RoguelikeArena_Skills(_Category, _Level, _Rank, _Source, _Skill)
		AND
		_Level <= _LevelLimit
		AND
		_Rank <= _RankLimit
		THEN
		PROC_RoguelikeArena_StringPoolAdd("SkillPool", _Skill);
		
		// Resets skill count.
		QRY
		QRY_RoguelikeArena_SetCurrentCharacterSkillCount((INTEGER)_Level, (INTEGER)_Rank)
		THEN
		DB_Singleton("RoguelikeArena_CurrentCharacterSkillCount", 0);
		
		// Sets skill count. The formula is: Random(Min, Max) + (Level - 1) / (Interval - Rank) + Rank
		QRY
		QRY_RoguelikeArena_SetCurrentCharacterSkillCount((INTEGER)_Level, (INTEGER)_Rank)
		AND
		DB_RoguelikeArena_SkillCountParameters(_SkillCountMin, _SkillCountMax, _Interval)
		AND
		QRY_RoguelikeArena_RandomInclusive(_SkillCountMin, _SkillCountMax)
		AND
		DB_RoguelikeArena_RandomResult(_RandomResult)
		AND
		IntegerSubtract(_Level, 1, _LevelCorrected)
		AND
		IntegerSubtract(_Interval, _Rank, _IntervalCorrected)
		AND
		IntegerDivide(_LevelCorrected, _IntervalCorrected, _Modifier)
		AND
		IntegerSum(_Modifier, _Rank, _ModifierCorrected)
		AND
		IntegerSum(_RandomResult, _ModifierCorrected, _SkillCount)
		THEN
		DB_Singleton("RoguelikeArena_CurrentCharacterSkillCount", _SkillCount);
		
		// Resets source skill count.
		QRY
		QRY_RoguelikeArena_SetCurrentCharacterSourceSkillCount((INTEGER)_Level, (INTEGER)_Rank)
		THEN
		DB_Singleton("RoguelikeArena_CurrentCharacterSourceSkillCount", 0);
		
		// Sets source skill count. Formula is: Enemy Level * (Chance Increase Per Level + Enemy Rank) - Chance Decrease Per Index * Skill Index
		QRY
		QRY_RoguelikeArena_SetCurrentCharacterSourceSkillCount((INTEGER)_Level, (INTEGER)_Rank)
		AND
		DB_RoguelikeArena_SourceSkillChanceParameters(_ChanceIncreasePerLevel, _ChanceDecreasePerIndex)
		AND
		IntegerSum(_ChanceIncreasePerLevel, _Rank, _ChanceIncreasePerLevelRankCorrected)
		AND
		IntegerProduct(_Level, _ChanceIncreasePerLevelRankCorrected, _ChanceIncrease)
		AND
		IntegerSum(_Rank, 1, _SourceSkillMaxCount)
		AND
		QRY_RoguelikeArena_CreateIndices(_SourceSkillMaxCount)
		AND
		DB_RoguelikeArena_CreatedIndices(_SkillIndex)
		AND
		IntegerProduct(_ChanceDecreasePerIndex, _SkillIndex, _ChanceDecrease)
		AND
		IntegerSubtract(_ChanceIncrease, _ChanceDecrease, _Chance)
		AND
		IntegerMin(_Chance, 90, _ChanceCapped)
		AND
		Random(100, _Random)
		AND
		_Random < _ChanceCapped
		THEN
		PROC_RoguelikeArena_IncreaseCurrentCharacterSourceSkillCount();
		
		PROC
		PROC_RoguelikeArena_IncreaseCurrentCharacterSourceSkillCount()
		AND
		DB_Singleton("RoguelikeArena_CurrentCharacterSourceSkillCount", _SkillCountCurrent)
		AND
		IntegerSum(_SkillCountCurrent, 1, _SkillCountNew)
		THEN
		DB_Singleton("RoguelikeArena_CurrentCharacterSourceSkillCount", _SkillCountNew);
		//END_REGION
		
		//REGION Source
		//Sets source points for character. Formula is: Random(Min, Level / (36 / (Rank * Rank + Modifier)))
		PROC
		PROC_RoguelikeArena_CharacterSetSourcePoints((CHARACTERGUID)_Character, (INTEGER)_Level, (INTEGER)_Rank)
		AND
		IntegerProduct(_Rank, _Rank, _RankPow)
		AND
		IntegerSum(_RankPow, 2, _Max)
		AND
		IntegerDivide(36, _Max, _MaxDistribution)
		AND
		IntegerDivide(_Level, _MaxDistribution, _MaxDistributed)
		AND
		QRY_RoguelikeArena_RandomInclusive(0, _MaxDistributed)
		AND
		DB_RoguelikeArena_RandomResult(_Points)
		THEN
		CharacterOverrideMaxSourcePoints(_Character, _Max);
		CharacterAddSourcePoints(_Character, _Points);
		//END_REGION
		
		//REGION Undying
		PROC
		PROC_RoguelikeArena_CharacterMakeUndying((CHARACTERGUID)_Character)
		AND
		GetPosition(_Character, _X, _Y, _Z)
		THEN
		PROC_RoguelikeArena_CharacterMakeUndying(_Character, _X, _Y, _Z);
		
		PROC
		PROC_RoguelikeArena_CharacterMakeUndying((CHARACTERGUID)_Character, (REAL)_X, (REAL)_Y, (REAL)_Z)
		THEN
		ApplyStatus(_Character, "RoguelikeArena_Undying", -1.0);
		DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z);
		
		PROC
		PROC_RoguelikeArena_CharacterSetRespawnPosition((CHARACTERGUID)_Character, (REAL)_X, (REAL)_Y, (REAL)_Z)
		AND
		DB_RoguelikeArena_UndyingCharacters(_Character, _OldX, _OldY, _OldZ)
		THEN
		NOT DB_RoguelikeArena_UndyingCharacters(_Character, _OldX, _OldY, _OldZ);
		DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z);
		
		IF
		CharacterDied(_Character)
		AND
		DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z)
		THEN
		TeleportToPosition(_Character, _X, _Y, _Z, "", 0);
		CharacterResurrect(_Character);
		
		IF
		CharacterResurrected(_Character)
		AND
		DB_RoguelikeArena_UndyingCharacters(_Character, _, _, _)
		THEN
		PROC_RoguelikeArena_CharacterFullRestore(_Character);
		ApplyStatus(_Character, "RoguelikeArena_Respawning", 18.0, 1);
		ApplyStatus(_Character, "RoguelikeArena_Undying", -1.0);
		PROC_RoguelikeArena_CharacterRespawning(_Character);
		
		PROC
		PROC_RoguelikeArena_CharacterRespawning((CHARACTERGUID)_Character)
		THEN
		DB_NOOP(1);
		
		IF
		CharacterStatusRemoved(_Character, "RoguelikeArena_Respawning", _)
		THEN
		PROC_RoguelikeArena_CharacterRespawned(_Character);
		
		PROC
		PROC_RoguelikeArena_CharacterRespawned((CHARACTERGUID)_Character)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_CharacterMakeDying((CHARACTERGUID)_Character)
		AND
		DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z)
		THEN
		RemoveStatus(_Character, "RoguelikeArena_Undying");
		NOT DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z);
		
		QRY
		QRY_RoguelikeArena_CharacterIsUndying((CHARACTERGUID)_Character)
		AND
		DB_RoguelikeArena_UndyingCharacters(_Character, _X, _Y, _Z)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Misc
		// Restores character similarly to the built-in restore proc but without removing all kinds of statuses.
		PROC
		PROC_RoguelikeArena_CharacterFullRestore((CHARACTERGUID)_Character)
		THEN
		CharacterResurrect(_Character);
		CharacterSetHitpointsPercentage(_Character, 100.0);
		CharacterSetArmorPercentage(_Character, 100.0);
		CharacterSetMagicArmorPercentage(_Character, 100.0);
		CharacterResetCooldowns(_Character);
		
		// Restores source points for characters that are alive (does not work for dead characters unfortunately).
		PROC
		PROC_RoguelikeArena_CharacterFullRestore((CHARACTERGUID)_Character)
		AND
		CharacterIsDead(_Character, 0)
		AND
		CharacterGetMaxSourcePoints(_Character, _MaxSourcePoints)
		AND
		CharacterGetSourcePoints(_Character, _SourcePoints)
		AND
		IntegerSubtract(_MaxSourcePoints, _SourcePoints, _SourcePointsToRestore)
		THEN
		CharacterAddSourcePoints(_Character, _SourcePointsToRestore);
		
		// Removes a character from the game.
		PROC
		PROC_RoguelikeArena_CharacterRemove((CHARACTERGUID)_Character)
		THEN
		CharacterDieImmediate(_Character, 0, "None");
		SetOnStage(_Character, 0);
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(567).Title("RoguelikeArena_Companion");
Goal(567)
{
	INIT
	{
		
	}
	KB
	{
		// Makes a character be a companion for the party. Most of this proc is based on GLO_LVHub_Henchmen. Detailed explanations are found there.
		PROC
		PROC_RoguelikeArena_MakeCompanion((CHARACTERGUID)_Character, (STRING)_TransformTemplate, (STRING)_HenchmanPreset, (CHARACTERGUID)_Recruiter)
		AND
		StringConcatenate("Hero Henchman ", _HenchmanPreset, _DefaultFaction)
		THEN
		ObjectSetFlag(_Character, "FTJ_RemoveSourceCollar"); // Not sure if this is actually needed
		DB_GLO_PartyMembers_DefaultFaction(_Character, _DefaultFaction); // Needed for PROC_GLO_PartyMembers_Add
		DB_GLO_PartyMembers_OriginalAlignment(_Character, "Neutral"); // Not sure about this either
		CharacterMakePlayer(_Character, _Recruiter);
		DB_RoguelikeArena_Companions(_Character, _Recruiter);
		TeleportTo(_Character, _Recruiter); // This has to be before PROC_GLO_PartyMembers_Add (unlike seen in GLO_LVHub_Henchmen, which is why henchmen are not chained to recruiter)
		PROC_GLO_PartyMembers_Add(_Character, _Recruiter);
		Transform(_Character, _TransformTemplate, 0);
		CharacterApplyHenchmanPreset(_Character, _HenchmanPreset);
		CharacterRemoveSkill(_Character, "Target_Bless"); // Bless is part of henchmen presets, which should only be added as a level up reward
		Foop(_Character); // Smoke effect
		CharacterSetCustomName(_Character, "Companion");
		
		// Sets up in-party dialog for companions. This specific query is required for PROC_GLO_PartyMember_Add.
		QRY
		QRY_GLO_PartyMembers_GetInPartyDialog((CHARACTERGUID)_Companion)
		AND
		DB_RoguelikeArena_Companions(_Companion, _)
		THEN
		DB_GLO_PartyMembers_InPartyDialog(_Companion, "RoguelikeArena_Companion");
		
		// Manages companion dismissing. This specific proc is required.
		PROC
		PROC_GLO_PartyMembers_MakeNPCHook((CHARACTERGUID)_Companion)
		AND
		DB_RoguelikeArena_Companions(_Companion, _)
		THEN
		CharacterDisappearOutOfSight(_Companion, 0, 0, "RoguelikeArena_Companion_Dismissed", 0);
		
		// This event happens after a companion has been dismissed and has disappeared out of sight.
		IF
		StoryEvent((CHARACTERGUID)_Companion, "RoguelikeArena_Companion_Dismissed")
		AND
		DB_RoguelikeArena_Companions(_Companion, _Recruiter)
		THEN
		PROC_GLO_PartyMembers_TransferInventoryToPlayer(_Companion, _Recruiter);
		NOT DB_RoguelikeArena_Companions(_Companion, _Recruiter);
		PROC_RoguelikeArena_CompanionDismissed(_Companion, _Recruiter);
		
		PROC
		PROC_RoguelikeArena_CompanionDismissed((CHARACTERGUID)_Companion, (CHARACTERGUID)_Recruiter)
		THEN
		DB_NOOP(1);
		
	}
	EXIT
	{
		
	}
}
Goal(568).Title("RoguelikeArena_Debug");
Goal(568)
{
	INIT
	{
		DB_RoguelikeArena_DebugItemTemplate("FUR_Dwarves_Citz_Chair_A_99e1cf50-64e5-4970-a58a-353b2b1992ed");
		
	}
	KB
	{
		IF
		CharacterUsedItem(_Char, ITEMGUID_BLD_Dwarves_Statue_Duna_A_Dynamic_000_7f73c946-0b06-495a-9173-76562955e3b3)
		AND
		DB_RoguelikeArena_CleanupSources(4, _Source)
		THEN
		CreateSurface(_Source, "SurfaceBlood", 64.0, -1.0);
		DebugBreak("Created debug surface");
		
		IF
		CharacterUsedItem(_Char, ITEMGUID_BLD_Dwarves_Statue_Duna_A_Dynamic_001_a369ec0f-f7ec-4f93-abaa-f79ab60c2d5e)
		AND
		DB_RoguelikeArena_CleanupSources(4, _Source)
		THEN
		RemoveSurfaceLayer(_Source, 0, 64.0);
		RemoveSurfaceLayer(_Source, 1, 64.0);
		DebugBreak("Cleaned up debug surface");
		
		PROC
		PROC_RoguelikeArena_DebugBreakInteger((INTEGER)_Message)
		AND
		IntegertoString(_Message, _MessageString)
		THEN
		DebugBreak(_MessageString);
		
		PROC
		PROC_RoguelikeArena_DebugCreateItemAtPosition((REAL)_X, (REAL)_Y, (REAL)_Z)
		AND
		DB_RoguelikeArena_DebugItemTemplate(_Template)
		AND
		CreateItemTemplateAtPosition(_Template, _X, _Y, _Z, _)
		THEN
		DebugBreak("Created debug item");
		
		QRY
		QRY_RoguelikeArena_DebugBreak((STRING)_Message)
		THEN
		DebugBreak(_Message);
		
	}
	EXIT
	{
		
	}
}
Goal(569).Title("RoguelikeArena_Item");
Goal(569)
{
	INIT
	{
		
	}
	KB
	{
		// Rotates an item randomly.
		PROC
		PROC_RoguelikeArena_ItemRandomRotate((ITEMGUID)_Item)
		AND
		Random(360, _IntAngle) // angle is from -180 to +180, but the engine handles converison
		AND
		Real(_IntAngle, _RealAngle)
		THEN
		ItemRotateY(_Item, _RealAngle, 10000.0);
		
		// Teleports an item to a valid position if it is stuck inside another item. Call this before ItemSnapToGround for best results.
		PROC
		PROC_RoguelikeArena_ItemTeleportToValidPosition((ITEMGUID)_Item)
		AND
		GetPosition(_Item, _X, _Y, _Z)
		AND
		FindValidPosition(_X, _Y, _Z, 20.0, _Item, _XValid, _YValid, _ZValid)
		THEN
		TeleportToPosition(_Item, _XValid, _YValid, _ZValid, "", 0);
		
		// Snaps an item to the ground. This may not work if the item is under the ground prior to this call.
		PROC
		PROC_RoguelikeArena_ItemSnapToGround((ITEMGUID)_Item)
		AND
		GetPosition(_Item, _X, _Y, _Z)
		THEN
		ItemMoveToPosition(_Item, _X, _Y, _Z, 10000.0, 0.0, "", 0);
		
		// Removes an item from the game.
		PROC
		PROC_RoguelikeArena_ItemRemove((ITEMGUID)_Item)
		THEN
		SetOnStage(_Item, 0); // Prevents some issues where items are removed from the game but still registered to triggers.
		ItemRemove(_Item);
		
		PROC
		PROC_RoguelikeArena_ItemGenerateTreasure((ITEMGUID)_Item, (STRING)_Treasure, (INTEGER)_Level, (INTEGER)_Times)
		AND
		QRY_RoguelikeArena_CreateIndices(_Times)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		GenerateTreasure(_Item, _Treasure, _Level, NULL_00000000-0000-0000-0000-000000000000);
		
	}
	EXIT
	{
		
	}
}
Goal(570).Title("RoguelikeArena_LevelUpHandler");
Goal(570)
{
	INIT
	{
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_ActiveArena(_Arena, _Level, _Difficulty, _)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_MaxDifficulty)
		AND
		_Difficulty >= _MaxDifficulty
		AND
		IntegerSum(_Level, 1, _NextLevel)
		THEN
		PROC_RoguelikeArena_PartyLevelUpTo(_NextLevel);
		
		PROC
		PROC_RoguelikeArena_PartyLevelUpTo((INTEGER)_Level)
		AND
		DB_IsPlayer(_Player)
		AND
		CharacterIsSummon(_Player, 0)
		THEN
		CharacterLevelUpTo(_Player, _Level);
		
	}
	EXIT
	{
		
	}
}
Goal(571).Title("RoguelikeArena_LevelUpRewards");
Goal(571)
{
	INIT
	{
		
	}
	KB
	{
		// Increases available source points to 2.
		IF
		CharacterLeveledUp(_Character)
		AND
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable(_Character, 4, "SecondSourcePoint")
		AND
		CharacterGetMaxSourcePoints(_Character, _CurrentMax)
		AND
		_CurrentMax < 2
		THEN
		CharacterOverrideMaxSourcePoints(_Character, 2);
		
		// Increases available source points to 3.
		IF
		CharacterLeveledUp(_Character)
		AND
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable(_Character, 9, "ThirdSourcePoint")
		AND
		CharacterGetMaxSourcePoints(_Character, _CurrentMax)
		AND
		_CurrentMax < 3
		THEN
		CharacterOverrideMaxSourcePoints(_Character, 3);
		
		// Adds source vampirism.
		IF
		CharacterLeveledUp(_Character)
		AND
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable(_Character, 2, "SourceVampirism")
		AND
		CharacterHasSkill(_Character, "Target_SourceVampirism", 0)
		THEN
		CharacterAddSkill(_Character, "Target_SourceVampirism", 1);
		
		// Adds bless.
		IF
		CharacterLeveledUp(_Character)
		AND
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable(_Character, 3, "Bless")
		AND
		CharacterHasSkill(_Character, "Target_Bless", 0)
		THEN
		CharacterAddSkill(_Character, "Target_Bless", 1);
		
		// Adds curse.
		IF
		CharacterLeveledUp(_Character)
		AND
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable(_Character, 4, "Curse")
		AND
		CharacterHasSkill(_Character, "Target_Curse", 0)
		THEN
		CharacterAddSkill(_Character, "Target_Curse", 1);
		
		QRY
		QRY_RoguelikeArena_ClaimLevelUpRewardIfAvailable((CHARACTERGUID)_Character, (INTEGER)_Level, (STRING)_Reward)
		AND
		DB_IsPlayer(_Character)
		AND
		CharacterGetLevel(_Character, _CharacterLevel)
		AND
		_CharacterLevel >= _Level
		AND
		NOT DB_RoguelikeArena_LevelUpRewardIsClaimed(_Character, _Reward)
		THEN
		DB_RoguelikeArena_LevelUpRewardIsClaimed(_Character, _Reward);
		
	}
	EXIT
	{
		
	}
}
