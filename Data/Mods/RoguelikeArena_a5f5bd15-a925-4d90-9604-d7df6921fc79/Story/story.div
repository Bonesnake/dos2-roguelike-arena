		PROC
		PROC_RoguelikeArena_ApplyPatch_1_0_1_0()
		AND
		DB_RoguelikeArena_Companions(_Companion, _)
		AND
		DB_RoguelikeArena_AvailableCompanions(_Identity, _Companion)
		AND
		StringConcatenate("AvailableCompanionPool_", _Identity, _Pool)
		THEN
		PROC_RoguelikeArena_GuidStringPoolRemove(_Pool, _Companion);
		//END_REGION
		
		//REGION 1.0.2.0
