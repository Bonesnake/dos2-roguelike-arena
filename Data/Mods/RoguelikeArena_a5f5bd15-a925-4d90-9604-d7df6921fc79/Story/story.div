		ObjectClearFlag(_Char,"Debug_ClearOriginTags",_Inst);
		
		PROC
		Proc_DebugClearStoryTags((CHARACTERGUID)_Char)
		AND
		DB_StoryTag(_Tag)
		AND
		IsTagged(_Char,_Tag,1)
		AND
		StringConcatenate("Cleared ",_Tag,_Line)
		THEN
		DebugText(_Char,_Line);
		ClearTag(_Char,_Tag);
		
		PROC
		Proc_DebugClearJobTags((CHARACTERGUID)_Char)
		AND
		DB_JobTag(_Tag)
		AND
		IsTagged(_Char,_Tag,1)
		AND
		StringConcatenate("Cleared ",_Tag,_Line)
		THEN
		DebugText(_Char,_Line);
		ClearTag(_Char,_Tag);
		
		PROC
		Proc_DebugClearRaceTags((CHARACTERGUID)_Char)
		AND
		DB_RaceTag(_Tag)
		AND
		IsTagged(_Char,_Tag,1)
		AND
		StringConcatenate("Cleared ",_Tag,_Line)
		THEN
		DebugText(_Char,_Line);
		ClearTag(_Char,_Tag);
		
		PROC
		Proc_DebugClearOriginTags((CHARACTERGUID)_Char)
		AND
		DB_OriginTag(_Tag)
		AND
		IsTagged(_Char,_Tag,1)
		AND
		StringConcatenate("Cleared ",_Tag,_Line)
		THEN
		DebugText(_Char,_Line);
		ClearTag(_Char,_Tag);
		
