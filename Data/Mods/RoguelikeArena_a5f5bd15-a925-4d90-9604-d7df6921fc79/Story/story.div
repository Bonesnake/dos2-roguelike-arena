}
Goal(320).Title("GLO_LVHub_Runner");
Goal(320)
{
	INIT
	{
		// Format: ingredient, ingredient-as-string, minimum player level
		
		DB_LV_Runner_Ingredient((ITEMGUID)CON_Potion_A_Empty_cd6e86ca-e9be-444e-a7df-d295ec6bb578,"CON_Potion_A_Empty_cd6e86ca-e9be-444e-a7df-d295ec6bb578",1);
		DB_LV_Runner_Ingredient(BOOK_Paper_Sheet_A_45a70721-3974-43fe-a1bf-1200ab6bf20e,"BOOK_Paper_Sheet_A_45a70721-3974-43fe-a1bf-1200ab6bf20e",1);
		DB_LV_Runner_Ingredient(LOOT_Tooth_A_1688a197-3081-4de2-ad66-37ab3f0ba14e,"LOOT_Tooth_A_1688a197-3081-4de2-ad66-37ab3f0ba14e",1);
		DB_LV_Runner_Ingredient(LOOT_Claw_A_b6468ac7-4d87-431f-aba7-1bec96596943,"LOOT_Claw_A_b6468ac7-4d87-431f-aba7-1bec96596943",1);
		DB_LV_Runner_Ingredient(LOOT_Tusk_A_0af953f1-9afb-4da0-8527-9ee0a5ecc450,"LOOT_Tusk_A_0af953f1-9afb-4da0-8527-9ee0a5ecc450",1);
		DB_LV_Runner_Ingredient(LOOT_Antler_A_423d4d3c-d8d6-41e2-9d3d-7f1503f07a46,"LOOT_Antler_A_423d4d3c-d8d6-41e2-9d3d-7f1503f07a46",1);
		DB_LV_Runner_Ingredient(LOOT_Paw_A_Rabbit_A_b4ed739a-fad9-4431-840c-412d4773f868,"LOOT_Paw_A_Rabbit_A_b4ed739a-fad9-4431-840c-412d4773f868",1);
		DB_LV_Runner_Ingredient(LOOT_Foot_Chicken_A_5afe1823-046c-4035-84cc-9892464424ca,"LOOT_Foot_Chicken_A_5afe1823-046c-4035-84cc-9892464424ca",1);
