		PROC
		ProcCrimeOnCustomSensibleAction((CHARACTERGUID)_NPC,_,_,_,_,_Char,_,_,_,_)
		AND
		DB_ARX_Sewers_ThievesGuild_Troll(_NPC)
		AND
		NOT DB_ARX_Sewers_ThievesGuild_CrimeRunning(_NPC)
		THEN
