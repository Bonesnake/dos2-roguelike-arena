		DB_QuestDef_UpdateEvent("CORE_Chapter4","RC_Malady_MetBI","RC_BI_MetMalady");
		DB_QuestDef_UpdateEvent("CORE_Chapter4","RC_Malady_LearnedDealBI","RC_BI_LearnRiverHasContract");
