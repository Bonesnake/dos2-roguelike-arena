		RegionStarted("ARX_EndGame")
		THEN
		GoalCompleted;
		
		
		IF
		DB_CheckLevelStart("ARX_EndGame")
		AND
		DB_CurrentLevel("ARX_EndGame")
		THEN
		GoalCompleted;
		
