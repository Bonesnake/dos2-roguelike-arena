		AND
		UserGetFlag(_Char,"RC_DW_LovrikToldUsLivyInKitchen",1)
		AND
		CharacterIsDead(CHARACTERGUID_S_RC_DW_Tavern_WaiterLivy_c202f327-07a6-4a72-80e5-b007915b5309,0)
		AND
		QueryOnlyOnce("RC_DW_VB_WaiterLivy_Escaped")
