		THEN
		ObjectSetFlag(_Char,"QuestUpdate_RC_DW_SurpriseDate_Lovrik_DeathRevenge");
		
		IF
		ObjectFlagSet("QuestUpdate_RC_DW_SurpriseDate_Thugs_Dead",(CHARACTERGUID)_Char,_)
		AND
		PartyGetFlag(_Char,"RC_DW_SeenDead_Lovrik",1)
		THEN
		ObjectSetFlag(_Char,"QuestUpdate_RC_DW_SurpriseDate_Lovrik_DeathRevenge");
		
