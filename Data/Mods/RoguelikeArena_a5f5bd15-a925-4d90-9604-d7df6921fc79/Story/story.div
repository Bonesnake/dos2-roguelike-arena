		DB_RoguelikeArena_CleanupSources(7, TRIGGERGUID_RoguelikeArena_SurfaceCleanupTrigger_003_02169f95-e7ca-450a-aba9-81a0b97a66b7);
		DB_RoguelikeArena_CleanupSources(7, TRIGGERGUID_RoguelikeArena_SurfaceCleanupTrigger_004_5255e0a4-db62-4e4b-a72a-cc2dd9e04487);
		
		// Radius, from, to, offset.
		// DB_RoguelikeArena_SurfaceCleanupParameters(64.0, -8, 8, 4.0);
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_ArenaEnded(_Arena, _Level, _Difficulty, _Players)
		THEN
		PROC_RoguelikeArena_CleanUp(_Arena);
		
		PROC
		PROC_RoguelikeArena_CleanUp((INTEGER)_Arena)
		THEN
		PROC_RoguelikeArena_CleanUpCharacters(_Arena);
		PROC_RoguelikeArena_CleanUpItems(_Arena);
		PROC_RoguelikeArena_CleanUpSurfaces(_Arena);
		
		PROC
		PROC_RoguelikeArena_CleanUpCharacters((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		IsTagged(_Character, "IGNORE_CLEANUP", 0)
		THEN
		PROC_RoguelikeArena_CharacterRemove((CHARACTERGUID)_Character);
		
		PROC
		PROC_RoguelikeArena_CleanUpItems((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_ArenaItems(_Arena, _Item)
		AND
		IsTagged(_Item, "IGNORE_CLEANUP", 0)
		THEN
		PROC_RoguelikeArena_ItemRemove((ITEMGUID)_Item);
		
		PROC
		PROC_RoguelikeArena_CleanUpSurfaces((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_CleanupSources(_Arena, _Source)
		THEN
		RemoveSurfaceLayer(_Source, 0, 64.0);
		RemoveSurfaceLayer(_Source, 1, 64.0);
		
		// Does not seem to work on the level, but works on the region strangely.
		// Cleans up surfaces. Surface cleanup has a very limited height, hence this proc runs the cleanup process on multiple y positions.
		// PROC
		// PROC_RoguelikeArena_CleanUpSurfaces((INTEGER)_Arena)
		// AND
		// DB_RoguelikeArena_CleanupSources(_Arena, _Source)
		// AND
		// GetPosition(_Source, _SourceX, _SourceY, _SourceZ)
		// AND
		// Integer(_SourceX, _SourceXInt)
		// AND
		// IntegertoString(_SourceXInt, _SourceXString)
		// AND
		// QRY_RoguelikeArena_DebugBreak(_SourceXString)
		// AND
		// Integer(_SourceZ, _SourceZInt)
		// AND
		// IntegertoString(_SourceZInt, _SourceZString)
		// AND
		// QRY_RoguelikeArena_DebugBreak(_SourceZString)
		// AND
		// DB_RoguelikeArena_SurfaceCleanupParameters(_Radius, _From, _To, _Offset)
		// AND
		// QRY_RoguelikeArena_CreateIndices(_From, _To)
		// AND
		// DB_RoguelikeArena_CreatedIndices(_Index)
		// AND
		// Real(_Index, _IndexReal)
		// AND
		// RealProduct(_Offset, _IndexReal, _OffsetY)
		// AND
		// RealSum(_SourceY, _OffsetY, _Y)
		// THEN
		// RemoveSurfaceLayerAtPosition(_SourceX, _Y, _SourceZ, 0, _Radius);
		// RemoveSurfaceLayerAtPosition(_SourceX, _Y, _SourceZ, 1, _Radius);
		
	}
	EXIT
	{
		
	}
}
Goal(545).Title("RoguelikeArena_Arena_Combat");
Goal(545)
{
	INIT
	{
		
	}
	KB
	{
		// Enables arena mode for characters entering an arena.
		PROC
		PROC_RoguelikeArena_CharacterEnteredArena(_Character, _Arena)
		THEN
		SetInArena(_Character, 1);
		
		// Disables arena mode for characters exiting an arena.
		PROC
		PROC_RoguelikeArena_CharacterLeftArena(_Character, _Arena)
		AND
		CharacterIsDead(_Character, 0)
		AND
		CharacterIsPolymorphInteractionDisabled(_Character, 0)
		THEN
		SetInArena(_Character, 0);
		
		// Triggers when an enemy dies.
		PROC
		PROC_RoguelikeArena_CharacterDiedInArena(_Character, _Arena)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		NOT QRY_RoguelikeArena_AnyEnemiesInCombat(_CombatID)
		// AND
		// IsCombatActive(_CombatID, 1)
		THEN
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID);
		
		// Triggers when an enemy goes off stage.
		PROC
		PROC_RoguelikeArena_CharacterWentOnStageInArena(_Character, _Bool, _Arena)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		_Bool == 0
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		NOT QRY_RoguelikeArena_AnyEnemiesInCombat(_CombatID)
		// AND
		// IsCombatActive(_CombatID, 1)
		THEN
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID);
		
		// Triggers when an enemy leaves an arena.
		PROC
		PROC_RoguelikeArena_CharacterLeftArena(_Character, _Arena)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		NOT QRY_RoguelikeArena_AnyEnemiesInCombat(_CombatID)
		// AND
		// IsCombatActive(_CombatID, 1)
		THEN
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID);
		
		// Triggers when an enemy exits combat.
		PROC
		PROC_RoguelikeArena_ObjectLeftArenaCombat(_Object, _Arena, _CombatID)
		AND
		ObjectIsCharacter(_Object, 1)
		AND
		GetFaction(_Object, "Evil NPC")
		AND
		NOT QRY_RoguelikeArena_AnyEnemiesInCombat(_CombatID)
		// AND
		// IsCombatActive(_CombatID, 1)
		THEN
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnemiesDied((INTEGER)_Arena, (INTEGER)_CombatID)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_EndArenaCombat((INTEGER)_Arena, (INTEGER)_CombatID)
		THEN
		EndCombat(_CombatID);
		
		PROC
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		CharacterIsPlayer(_Character, 1)
		THEN
		SetInArena(_Character, 0);
		PROC_RoguelikeArena_CharacterFullRestore(_Character);
		
		PROC
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _CombatID)
		THEN
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded((INTEGER)_Arena, (INTEGER)_CombatID)
		THEN
		DB_NOOP(1);
		
		//REGION Events
		IF
		CombatRoundStarted(_CombatID, _Round)
		AND
		DB_RoguelikeArena_Arenas(_Arena)
		AND
		QRY_RoguelikeArena_CombatIsInArena(_CombatID, _Arena)
		THEN
		PROC_RoguelikeArena_ArenaCombatRoundStarted(_Arena, _CombatID, _Round);
		
		// Triggered when a new round has started in an arena.
		PROC
		PROC_RoguelikeArena_ArenaCombatRoundStarted((INTEGER)_Arena, (INTEGER)_CombatID, (INTEGER)_Round)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Queries
		// Returns whether any players are currently in combat.
		QRY
		QRY_RoguelikeArena_AnyPlayersInCombat((INTEGER)_CombatID)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		CharacterIsPlayer(_Character, 1)
		AND
		CharacterIsDead(_Character, 0)
		THEN
		DB_NOOP(1);
		
		// Returns whether any enemies are currently in combat.
		QRY
		QRY_RoguelikeArena_AnyEnemiesInCombat((INTEGER)_CombatID)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		CharacterIsDead(_Character, 0)
		THEN
		DB_NOOP(1);
		
		// Returns whether combat with _CombatID is inside _Arena.
		QRY
		QRY_RoguelikeArena_CombatIsInArena((INTEGER)_CombatID, (INTEGER)_Arena)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		THEN
		DB_NOOP(1);
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(546).Title("RoguelikeArena_Arena_Containers");
Goal(546)
{
	INIT
	{
		// Min, max, min increase per difficulty, max increase per difficulty.
		DB_RoguelikeArena_ContainerCountParameters(3, 5, 2, 3);
		
		DB_RoguelikeArena_ContainerRankRanges(0, 0, 0, 30);
		DB_RoguelikeArena_ContainerRankRanges(0, 1, 30, 55);
		DB_RoguelikeArena_ContainerRankRanges(0, 2, 55, 75);
		DB_RoguelikeArena_ContainerRankRanges(0, 3, 75, 90);
		DB_RoguelikeArena_ContainerRankRanges(0, 4, 90, 100);
		
		DB_RoguelikeArena_ContainerRankRanges(1, 0, 0, 25);
		DB_RoguelikeArena_ContainerRankRanges(1, 1, 25, 50);
		DB_RoguelikeArena_ContainerRankRanges(1, 2, 50, 70);
		DB_RoguelikeArena_ContainerRankRanges(1, 3, 70, 85);
		DB_RoguelikeArena_ContainerRankRanges(1, 4, 85, 100);
		
		DB_RoguelikeArena_ContainerRankRanges(2, 0, 0, 20);
		DB_RoguelikeArena_ContainerRankRanges(2, 1, 20, 40);
		DB_RoguelikeArena_ContainerRankRanges(2, 2, 40, 60);
		DB_RoguelikeArena_ContainerRankRanges(2, 3, 60, 80);
		DB_RoguelikeArena_ContainerRankRanges(2, 4, 80, 100);
		
		DB_RoguelikeArena_ContainerRankRanges(3, 0, 0, 15);
		DB_RoguelikeArena_ContainerRankRanges(3, 1, 15, 30);
		DB_RoguelikeArena_ContainerRankRanges(3, 2, 30, 50);
		DB_RoguelikeArena_ContainerRankRanges(3, 3, 50, 75);
		DB_RoguelikeArena_ContainerRankRanges(3, 4, 75, 100);
		
		DB_RoguelikeArena_ContainerRankRanges(4, 0, 0, 10);
		DB_RoguelikeArena_ContainerRankRanges(4, 1, 10, 25);
		DB_RoguelikeArena_ContainerRankRanges(4, 2, 25, 45);
		DB_RoguelikeArena_ContainerRankRanges(4, 3, 45, 70);
		DB_RoguelikeArena_ContainerRankRanges(4, 4, 70, 100);
		
		DB_RoguelikeArena_ContainerTemplates(0, "RoguelikeArena_Container_Rank1_9bdb25d3-8168-4a37-afab-7dd804555e18", "RoguelikeArena_Container_Rank1");
		DB_RoguelikeArena_ContainerTemplates(1, "RoguelikeArena_Container_Rank2_9000b256-c3a7-4cc7-9294-e6d085397ed2", "RoguelikeArena_Container_Rank2");
		DB_RoguelikeArena_ContainerTemplates(2, "RoguelikeArena_Container_Rank3_9dd4cb0c-9d53-4ba1-91db-6fcd6ad10f26", "RoguelikeArena_Container_Rank3");
		DB_RoguelikeArena_ContainerTemplates(3, "RoguelikeArena_Container_Rank4_9709290c-20a1-4f9d-a56b-c97d9a2a6cff", "RoguelikeArena_Container_Rank4");
		DB_RoguelikeArena_ContainerTemplates(4, "RoguelikeArena_Container_Rank5_48bfa64c-6b53-4750-bf2b-b1c8353fb8f2", "RoguelikeArena_Container_Rank5");
		
	}
	KB
	{
		// Calculates the amount of containers to be spawned, then spawns that amount.
		PROC
		PROC_RoguelikeArena_SpawnContainers((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		DB_RoguelikeArena_ContainerCountParameters(_ContainerCountMin, _ContainerCountMax, _ContainerCountMinIncreasePerDifficulty, _ContainerCountMaxIncreasePerDifficulty)
		AND
		IntegerProduct(_Difficulty, _ContainerCountMinIncreasePerDifficulty, _ContainerCountMinModifier)
		AND
		IntegerProduct(_Difficulty, _ContainerCountMaxIncreasePerDifficulty, _ContainerCountMaxModifier)
		AND
		IntegerSum(_ContainerCountMin, _ContainerCountMinModifier, _ContainerCountMinModified)
		AND
		IntegerSum(_ContainerCountMax, _ContainerCountMaxModifier, _ContainerCountMaxModified)
		AND
		QRY_RoguelikeArena_RandomInclusive(_ContainerCountMinModified, _ContainerCountMaxModified)
		AND
		DB_RoguelikeArena_RandomResult(_ContainerCount)
		THEN
		PROC_RoguelikeArena_SpawnContainers(_Arena, _Level, _Difficulty, _ContainerCount);
		
		// Spawns the containers.
		PROC
		PROC_RoguelikeArena_SpawnContainers((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		PROC_RoguelikeArena_SpawnContainer(_Arena, _Level, _Difficulty);
		
		PROC
		PROC_RoguelikeArena_SpawnContainer((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		Random(99, _Random)
		AND
		DB_RoguelikeArena_ContainerRankRanges(_Difficulty, _Rank, _Min, _Max)
		AND
		_Random >= _Min
		AND
		_Random < _Max
		AND
		DB_RoguelikeArena_ContainerTemplates(_Rank, _Template, _Treasure)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_EVENT")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		CreateItemTemplateAtPosition(_Template, _X, _Y, _Z, _Container)
		THEN
		PROC_RoguelikeArena_ItemRandomRotate(_Container);
		// PROC_RoguelikeArena_ItemTeleportToValidPosition(_Container);
		// PROC_RoguelikeArena_ItemSnapToGround(_Container);
		ItemLevelUpTo(_Container, _Level);
		GenerateTreasure(_Container, _Treasure, _Level, NULL_00000000-0000-0000-0000-000000000000);
		
	}
	EXIT
	{
		
	}
}
Goal(547).Title("RoguelikeArena_Arena_DefeatTheChampion");
Goal(547)
{
	INIT
	{
		DB_RoguelikeArena_ChampionEnemyBuffs("BLESSED");
		DB_RoguelikeArena_ChampionEnemyBuffs("CLEAR_MINDED");
		DB_RoguelikeArena_ChampionEnemyBuffs("ENCOURAGED");
		DB_RoguelikeArena_ChampionEnemyBuffs("FORTIFIED");
		DB_RoguelikeArena_ChampionEnemyBuffs("HASTED");
		DB_RoguelikeArena_ChampionEnemyBuffs("MAGIC_SHELL");
		DB_RoguelikeArena_ChampionEnemyBuffs("RESTED");
		DB_RoguelikeArena_ChampionEnemyBuffs("WINGS");
		
		DB_RoguelikeArena_ChampionEnemyAbilities("Leadership");
		DB_RoguelikeArena_ChampionEnemyAbilities("Perseverance");
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_StartDefeatTheChampion((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		THEN
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _Level, _Difficulty, _Players);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		DB_Singleton("RoguelikeArena_SpawnAsChampion", 1);
		PROC_RoguelikeArena_SpawnEnemy(_Arena, _Level, _Difficulty);
		DB_Singleton("RoguelikeArena_SpawnAsChampion", 0);
		
		//REGION Thrall spawns
		PROC
		PROC_RoguelikeArena_EnemySpawned(_Thrall, _Arena, _)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _, _, _)
		AND
		NOT DB_Singleton("RoguelikeArena_SpawnAsChampion", 1)
		THEN
		DB_RoguelikeArena_ChampionThralls(_Arena, _Thrall);
		ApplyStatus(_Thrall, "RoguelikeArena_Thrall", -1.0);
		//END_REGION
		
		//REGION Champion spawns
		PROC
		PROC_RoguelikeArena_EnemySpawned(_Enemy, _Arena, _)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _, _Difficulty, _)
		AND
		DB_Singleton("RoguelikeArena_SpawnAsChampion", 1)
		THEN
		PROC_RoguelikeArena_StringPoolClear("ChampionEnemyBuffs");
		PROC_RoguelikeArena_StringPoolAddChampionEnemyBuffs();
		PROC_RoguelikeArena_MakeChampionEnemy(_Enemy, _Difficulty);
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Enemy);
		
		// Sets up basic stuff.
		PROC
		PROC_RoguelikeArena_MakeChampionEnemy((CHARACTERGUID)_Character, (INTEGER)_Difficulty)
		AND
		CharacterGetDisplayName(_Character, _, _CharacterName)
		AND
		StringConcatenate("Champion ", _CharacterName, _ChampionName)
		THEN
		ApplyStatus(_Character, "RoguelikeArena_Champion", -1.0);
		CharacterSetCustomName(_Character, _ChampionName);
		SetTag(_Character, "AI_PREFERRED_TARGET");
		CharacterAddSourcePoints(_Character, _Difficulty);
		SetIsBoss(_Character, 1);
		
		// Adds a status.
		PROC
		PROC_RoguelikeArena_MakeChampionEnemy(_Character, _Difficulty)
		AND
		DB_RoguelikeArena_ChampionThralls(_Arena, _Thrall)
		AND
		QRY_RoguelikeArena_StringPoolSelectAndRemoveRandom("ChampionEnemyBuffs")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("ChampionEnemyBuffs", _Buff)
		THEN
		ApplyStatus(_Character, _Buff, -1.0, 1, _Thrall);
		DB_RoguelikeArena_ChampionEnemyActiveBuffs(_Character, _Buff, _Thrall);
		
		// Adds abilities.
		PROC
		PROC_RoguelikeArena_MakeChampionEnemy(_Character, _Difficulty)
		AND
		DB_RoguelikeArena_ChampionThralls(_Arena, _Thrall)
		AND
		DB_RoguelikeArena_ChampionEnemyAbilities(_Ability)
		THEN
		CharacterAddAbility(_Character, _Ability, 1);
		//END_REGION
		
		//REGION Thrall dies
		PROC
		PROC_RoguelikeArena_CharacterDiedInArena(_Character, _Arena)
		AND
		DB_RoguelikeArena_ChampionThralls(_Arena, _Character)
		THEN
		NOT DB_RoguelikeArena_ChampionThralls(_Arena, _Character);
		PROC_RoguelikeArena_ChampionThrallDied(_Arena, _Character);
		
		// Removes the status effect.
		PROC
		PROC_RoguelikeArena_ChampionThrallDied((INTEGER)_Arena, (CHARACTERGUID)_)
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Champion)
		THEN
		PlayEffect(_Champion, "RS3_FX_GP_ScriptedEvent_GhostDissipate_01");
		
		PROC
		PROC_RoguelikeArena_ChampionThrallDied(_Arena, _Thrall)
		AND
		DB_RoguelikeArena_ChampionEnemyActiveBuffs(_Champion, _Buff, _Thrall)
		THEN
		RemoveStatus(_Champion, _Buff);
		NOT DB_RoguelikeArena_ChampionEnemyActiveBuffs(_Champion, _Buff, _Thrall);
		
		// Removes abilities.
		PROC
		PROC_RoguelikeArena_ChampionThrallDied(_Arena, _)
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Champion)
		AND
		DB_RoguelikeArena_ChampionEnemyAbilities(_Ability)
		THEN
		CharacterRemoveAbility(_Champion, _Ability, 1);
		
		// Stops the beam effect.
		PROC
		PROC_RoguelikeArena_ChampionThrallDied(_Arena, _Thrall)
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Champion)
		AND
		GetUUID(_Thrall, _UUID)
		AND
		StringConcatenate("RoguelikeArena_Thrall_", _UUID, _BeamName)
		THEN
		PROC_StopLoopBeamEffect(_Champion, _BeamName);
		//END_REGION
		
		//REGION Champion Dies
		PROC
		PROC_RoguelikeArena_CharacterDiedInArena(_Character, _Arena)
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Character)
		THEN
		NOT DB_RoguelikeArena_ChampionEnemy(_Arena, _Character);
		PROC_RoguelikeArena_ChampionEnemyDied(_Arena, _Character);
		
		// Kills remaining thralls.
		PROC
		PROC_RoguelikeArena_ChampionEnemyDied((INTEGER)_, (CHARACTERGUID)_Champion)
		AND
		DB_CombatCharacters(_Champion, _CombatID)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		CharacterIsDead(_Character, 0)
		THEN
		CharacterDie(_Character, 1, "Explode");
		
		// Cleans up the beam effect.
		PROC
		PROC_RoguelikeArena_ChampionEnemyDied(_Arena, _Champion)
		AND
		DB_RoguelikeArena_ChampionThralls(_Arena, _Thrall)
		AND
		GetUUID(_Thrall, _UUID)
		AND
		StringConcatenate("RoguelikeArena_Thrall_", _UUID, _BeamName)
		THEN
		PROC_StopLoopBeamEffect(_Champion, _BeamName);
		//END_REGION
		
		//REGION Misc
		// Plays a beam effect between thralls and the champion. Note: this would make more sense in the spawn proc, but that doesn't work reliably for some reason.
		PROC
		PROC_RoguelikeArena_ArenaCombatRoundStarted(_Arena, _, _Round)
		AND
		_Round == 1
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, _Champion)
		AND
		DB_RoguelikeArena_ChampionThralls(_Arena, _Thrall)
		AND
		GetUUID(_Thrall, _UUID)
		AND
		StringConcatenate("RoguelikeArena_Thrall_", _UUID, _BeamName)
		THEN
		PROC_LoopBeamEffect("RS3_FX_Skills_Soul_ShacklesOfPain_LinkBeam_01", _Champion, _Thrall, "Dummy_BodyFX", "Dummy_BodyFX", _BeamName, "RoguelikeArena_Level");
		
		// Reapplies status effect to the champion.
		PROC
		PROC_RoguelikeArena_ObjectArenaTurnStarted(_Object, _Arena)
		AND
		ObjectIsCharacter(_Object, 1)
		AND
		DB_RoguelikeArena_ChampionEnemy(_Arena, (CHARACTERGUID)_Object)
		AND
		DB_RoguelikeArena_ChampionEnemyActiveBuffs(_Object, _Buff, _Thrall)
		AND
		HasActiveStatus(_Object, _Buff, 0)
		THEN
		ApplyStatus(_Object, _Buff, -1.0, 1, _Thrall);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_DefeatTheChampionEnded(_Arena);
		
		PROC
		PROC_RoguelikeArena_DefeatTheChampionEnded((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _Level, _Difficulty, _Players)
		THEN
		NOT DB_RoguelikeArena_DefeatTheChampion(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_DefeatTheChampionEnded(_Arena)
		AND
		DB_RoguelikeArena_DefeatTheChampion(_Arena, _Level, _Difficulty, _Players)
		THEN
		NOT DB_RoguelikeArena_DefeatTheChampion(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_StringPoolAddChampionEnemyBuffs()
		AND
		DB_RoguelikeArena_ChampionEnemyBuffs(_Buff)
		THEN
		PROC_RoguelikeArena_StringPoolAdd("ChampionEnemyBuffs", _Buff);
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
