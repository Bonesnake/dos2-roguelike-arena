		DB_TUT_LowerDeck_WindegoExplosionPoints(TRIGGERGUID_S_TUT_CargoDeck_Isolation_Explosion_001_74dce1d1-e6eb-434b-a2d5-67d9b0e9c34e,"Projectile_EnemyFireball",0);
