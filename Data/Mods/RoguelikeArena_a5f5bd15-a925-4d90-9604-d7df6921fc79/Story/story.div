		ObjectClearFlag(_Player,"EG_Debug_DealWithDevil");
		GlobalSetFlag("ARX_TheDoctor_PactSealed");
		UserSetFlag(_Player, "ARX_TheDoctor_UserAcceptedThePact", 0);
		ObjectSetFlag(CHARACTERGUID_S_ARX_DoctorsHouse_TheDoctor_83083470-c543-45b3-ac8a-108df0daca8d,"ARX_TheDoctor_HasBloodVial");
		SetTag(_Player,"BLOODBOUND");
		
