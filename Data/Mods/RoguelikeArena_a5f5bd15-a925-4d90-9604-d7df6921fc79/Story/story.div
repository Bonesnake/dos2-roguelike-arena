		DB_ARX_DoctorsPact_Char((CHARACTERGUID)_Player,NULL_00000000-0000-0000-0000-000000000000);
		UserSetFlag(_Player, "ARX_TheDoctor_UserAcceptedThePact", 0);
		SetTag(_Player,"BLOODBOUND");
		
		IF
