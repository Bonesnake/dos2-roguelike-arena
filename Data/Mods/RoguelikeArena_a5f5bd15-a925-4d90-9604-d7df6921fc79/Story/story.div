Goal(556).Title("RoguelikeArena_Arena_Portals");
Goal(556)
{
	INIT
	{
		DB_RoguelikeArena_ArenaTeleporterItems((ITEMGUID)ITEMGUID_RoguelikeArena_Portal_000_25d2e6a5-4449-457e-bc76-ed41995c1a72);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_7e26861b-822a-8a89-3a43-1853b4f24006);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_a0041fea-0535-83d0-3903-5b9401b39ab6);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_a8aa8cbb-59d4-8544-4d49-b11d411c690f);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_68b1cea8-c0bc-81d9-3a8b-df1a7c77bd66);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_53f93b2e-fb73-8292-6ac7-12590ba69c43);
		DB_RoguelikeArena_ArenaTeleporterItems(ITEMGUID_RoguelikeArena_Portal_000__000_417a5f3a-703b-8fbe-4a0c-bbe47c14a969);
		
	}
	KB
	{
		IF
		CharacterUsedItem(_Character, _UsedItem)
		AND
		DB_RoguelikeArena_ArenaTeleporterItems(_UsedItem)
		AND
		DB_RoguelikeArena_RegionTeleportTriggers(0, _Trigger)
		THEN
		TeleportTo(_Character, _Trigger, "", 1);
		
		// Prevents the use of teleporters in combat.
		PROC
		ProcBlockUseOfItem(_Player, _Item)
		AND
		DB_RoguelikeArena_ArenaTeleporterItems(_Item)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_CombatCharacters(_Player, _)
		THEN
		DB_CustomUseItemResponse(_Player, _Item, 0);
		Proc_StartDialog(1, "GLO_AD_CannotUseNow", _Player);
		
	}
	EXIT
	{
		
	}
}
Goal(557).Title("RoguelikeArena_Arena_PurgeTheSpirits");
Goal(557)
{
	INIT
	{
		DB_RoguelikeArena_SpiritTemplate("RoguelikeArena_SpiritChicken_f8495e10-cdf9-40fd-b62b-e8145e97bf6f");
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_StartPurgeTheSpirits((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		THEN
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _Level, _Difficulty, _Players);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		PROC_RoguelikeArena_SpawnSpirits(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_SpawnSpirits((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		AND
		QRY_RoguelikeArena_RandomCount(_Difficulty, 2, 1, 1)
		AND
		DB_RoguelikeArena_RandomResult(_SpiritCount)
		AND
		IntegerProduct(_SpiritCount, _Players, _SpiritCountMultiplied)
		AND
		IntegerDivide(_SpiritCountMultiplied, 4, _SpiritCountAdjusted)
		AND
		IntegerMax(_SpiritCountAdjusted, 1, _SpiritCountCorrected)
		THEN
		PROC_RoguelikeArena_SpawnSpirits(_Arena, _Level, _Difficulty, _Players, _SpiritCountCorrected);
		
		PROC
		PROC_RoguelikeArena_SpawnSpirits((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_EVENT")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		DB_RoguelikeArena_SpiritTemplate(_SpiritTemplate)
		AND
		CharacterCreateAtPosition(_X, _Y, _Z, _SpiritTemplate, 0, _Spirit)
		THEN
		DB_RoguelikeArena_Spirits(_Arena, _Spirit);
		CharacterLevelUpTo(_Spirit, _Level);
		PROC_RoguelikeArena_SpiritSpawned(_Spirit, _Arena);
		
		// Triggered when a spirit is spawned inside an arena.
		PROC
		PROC_RoguelikeArena_SpiritSpawned((CHARACTERGUID)_Spirit, (INTEGER)_Arena)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_EnemySpawned(_Enemy, _Arena, _)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _, _, _)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ENEMY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		THEN
		PROC_RoguelikeArena_CharacterMakeUndying(_Enemy, _X, _Y, _Z);
		
		PROC
		PROC_RoguelikeArena_CharacterEnteredArena(_Character, _Arena)
		AND
		CharacterIsPlayer(_Character, 1)
		AND
		CharacterIsSummon(_Character, 0)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _, _, _)
		AND
		CharacterHasSkill(_Character, "Target_SourceVampirism", 0)
		THEN
		CharacterAddSkill(_Character, "Target_SourceVampirism");
		
		PROC
		PROC_RoguelikeArena_CharacterEnteredArena(_Character, _Arena)
		AND
		CharacterIsPlayer(_Character, 1)
		AND
		CharacterIsSummon(_Character, 0)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _, _, _)
		AND
		CharacterHasSkill(_Character, "Shout_SpiritVision", 0)
		THEN
		CharacterAddSkill(_Character, "Shout_SpiritVision");
		
		PROC
		PROC_RoguelikeArena_CharacterLeftArena(_Character, _Arena)
		AND
		CharacterHasSkill(_Character, "Shout_SpiritVision", 1)
		THEN
		CharacterRemoveSkill(_Character, "Shout_SpiritVision");
		
		PROC
		PROC_RoguelikeArena_CharacterRespawning(_Character)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _, _, _)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ENEMY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		THEN
		PROC_RoguelikeArena_CharacterSetRespawnPosition(_Character, _X, _Y, _Z);
		PROC_RoguelikeArena_DestroySpiritInArena(_Arena);
		
		// Destroys 1 spirit that is not yet being destroyed.
		PROC
		PROC_RoguelikeArena_DestroySpiritInArena((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_Spirits(_Arena, _Spirit)
		AND
		NOT DB_RoguelikeArena_SpiritDestroying(_Spirit)
		AND
		NOT DB_Singleton("RoguelikeArena_DestroyOnlyOneSpirit", 1)
		AND
		GetPosition(_Spirit, _X, _Y, _Z)
		THEN
		DestroyGhost(_Spirit);
		PlayEffectAtPosition("RS3_FX_GP_ScriptedEvent_SourceJar_Break_01", _X, _Y, _Z);
		DB_RoguelikeArena_SpiritDestroying(_Spirit);
		DB_Singleton("RoguelikeArena_DestroyOnlyOneSpirit", 1);
		
		PROC
		PROC_RoguelikeArena_DestroySpiritInArena(_Arena)
		THEN
		DB_Singleton("RoguelikeArena_DestroyOnlyOneSpirit", 0);
		
		IF
		CharacterGhostDestroyed(_, _Ghost)
		AND
		DB_RoguelikeArena_Spirits(_Arena, _Ghost)
		THEN
		PROC_RoguelikeArena_SpiritDestroyedInArena(_Ghost, _Arena);
		SetOnStage(_Ghost, 0); // Prevents issues where spirits no longer exist but are still registered inside the arena
		
		PROC
		PROC_RoguelikeArena_SpiritDestroyedInArena((CHARACTERGUID)_Spirit, (INTEGER)_Arena)
		AND
		DB_RoguelikeArena_Spirits(_Arena, _Spirit)
		THEN
		NOT DB_RoguelikeArena_Spirits(_Arena, _Spirit);
		
		PROC
		PROC_RoguelikeArena_SpiritDestroyedInArena(_Spirit, _Arena)
		AND
		DB_RoguelikeArena_SpiritDestroying(_Spirit)
		THEN
		NOT DB_RoguelikeArena_SpiritDestroying(_Spirit);
		
		PROC
		PROC_RoguelikeArena_SpiritDestroyedInArena(_Spirit, _Arena)
		AND
		NOT QRY_RoguelikeArena_AnySpiritsInArena(_Arena)
		AND
		DB_CombatCharacters(_Spirit, _CombatID)
		THEN
		PROC_RoguelikeArena_LastSpiritDestroyed(_Arena, _CombatID);
		
		QRY
		QRY_RoguelikeArena_AnySpiritsInArena((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_Spirits(_Arena, _)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_LastSpiritDestroyed((INTEGER)_Arena, (INTEGER)_)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		QRY_RoguelikeArena_CharacterIsUndying(_Character)
		THEN
		PROC_RoguelikeArena_CharacterMakeDying(_Character);
		
		PROC
		PROC_RoguelikeArena_LastSpiritDestroyed(_Arena, _)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		CharacterIsDead(_Character, 0)
		THEN
		CharacterDie(_Character, 1, "Explode");
		
		PROC
		PROC_RoguelikeArena_LastSpiritDestroyed(_Arena, _CombatID)
		THEN
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_PurgeTheSpiritsEnded(_Arena);
		
		PROC
		PROC_RoguelikeArena_PurgeTheSpiritsEnded((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_PurgeTheSpirits(_Arena, _Level, _Difficulty, _Players)
		THEN
		NOT DB_RoguelikeArena_PurgeTheSpirits(_Arena, _Level, _Difficulty, _Players);
		
	}
	EXIT
	{
		
	}
}
Goal(558).Title("RoguelikeArena_Arena_SourceBeacons");
Goal(558)
{
	INIT
	{
		DB_RoguelikeArena_SourceBeaconTemplate("RoguelikeArena_SourceBeacon_e5a92070-79ab-4ac6-b521-f8837bc16b46");
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_SpawnSourceBeacons((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		QRY_RoguelikeArena_RandomCount(_Difficulty, 1, 3, 1)
		AND
		DB_RoguelikeArena_RandomResult(_SourceBeaconCount)
		THEN
		PROC_RoguelikeArena_SpawnSourceBeacons(_Arena, _Level, _Difficulty, _SourceBeaconCount);
		
		PROC
		PROC_RoguelikeArena_SpawnSourceBeacons((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		PROC_RoguelikeArena_SpawnSourceBeacon(_Arena, _Level, _Difficulty);
		
		PROC
		PROC_RoguelikeArena_SpawnSourceBeacon((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		DB_RoguelikeArena_SourceBeaconTemplate(_Template)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_EVENT")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		CreateItemTemplateAtPosition(_Template, _X, _Y, _Z, _SourceBeacon)
		THEN
		PROC_RoguelikeArena_ItemRandomRotate(_SourceBeacon);
		// PROC_RoguelikeArena_ItemTeleportToValidPosition(_SourceBeacon);
		// PROC_RoguelikeArena_ItemSnapToGround(_SourceBeacon);
		ItemLevelUpTo(_SourceBeacon, _Level);
		SetInArena(_SourceBeacon, 1);
		DB_RoguelikeArena_SourceBeacons(_Arena, _SourceBeacon);
		PROC_RoguelikeArena_SourceBeaconSpawned(_SourceBeacon, _Arena);
		
		// Triggered when a source beacon is spawned inside an arena.
		PROC
		PROC_RoguelikeArena_SourceBeaconSpawned((ITEMGUID)_SourceBeacon, (INTEGER)_Arena)
		THEN
		DB_NOOP(1);
		
		// Make sure beacons don't remain hostile after combat ends.
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_SourceBeacons(_Arena, _SourceBeacon)
		AND
		IsInArena(_SourceBeacon, 1)
		THEN
		SetInArena(_SourceBeacon, 0);
		SetCanJoinCombat(_SourceBeacon, 0);
		SetCanFight(_SourceBeacon, 0);
		NOT DB_RoguelikeArena_SourceBeacons(_Arena, _SourceBeacon);
		
	}
	EXIT
	{
		
	}
}
