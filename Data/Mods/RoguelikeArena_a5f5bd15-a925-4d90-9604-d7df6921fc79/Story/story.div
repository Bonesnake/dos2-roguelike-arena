		PROC
		Proc_ARX_TheWeakening_River_ReachedGate_A()
		AND
		DB_InRegion(_,TRIGGERGUID_S_ARX_TheWeakening_River_ReachedGate_Trigger_2661fb76-e44a-46d6-b926-b96b3171a55c)
		THEN
