Goal(598).Title("RoguelikeArena_ZZ_Patches");
Goal(598)
{
	INIT
	{
		// Important: the mod version needs to be changed at 2 places within this script when updating the mod (it should match the version inside Project Settings)
		// Note: the mod version was untracked before 1.1.0.0 and this script did not exist on 1.0.0.0, so some special cases are handled separately
		DB_RoguelikeArena_ModVersion(1, 1, 0, 0); // Change this when updating the mod !!!
		
	}
	KB
	{
		// Updates mod version.
		PROC
		PROC_RoguelikeArena_SavegameLoaded((INTEGER)_Major, (INTEGER)_Minor, (INTEGER)_Revision, (INTEGER)_Build)
		THEN
		NOT DB_RoguelikeArena_ModVersion(_Major, _Minor, _Revision, _Build);
		DB_RoguelikeArena_ModVersion(1, 1, 0, 0); // Change this when updating the mod !!!
		
		QRY
		QRY_RoguelikeArena_ShouldApplyPatch((INTEGER)_LoadedMajor, (INTEGER)_, (INTEGER)_, (INTEGER)_, (INTEGER)_PatchMajor, (INTEGER)_, (INTEGER)_, (INTEGER)_)
		AND
		_LoadedMajor < _PatchMajor
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_RoguelikeArena_ShouldApplyPatch(_LoadedMajor, _LoadedMinor, _, _, _PatchMajor, _PatchMinor, _, _)
		AND
		_LoadedMajor == _PatchMajor
		AND
		_LoadedMinor < _PatchMinor
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_RoguelikeArena_ShouldApplyPatch(_LoadedMajor, _LoadedMinor, _LoadedRevision, _, _PatchMajor, _PatchMinor, _PatchRevision, _)
		AND
		_LoadedMajor == _PatchMajor
		AND
		_LoadedMinor == _PatchMinor
		AND
		_LoadedRevision < _PatchRevision
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_RoguelikeArena_ShouldApplyPatch(_LoadedMajor, _LoadedMinor, _LoadedRevision, _LoadedBuild, _PatchMajor, _PatchMinor, _PatchRevision, _PatchBuild)
		AND
		_LoadedMajor == _PatchMajor
		AND
		_LoadedMinor == _PatchMinor
		AND
		_LoadedRevision == _PatchRevision
		AND
		_LoadedBuild < _PatchBuild
		THEN
		DB_NOOP(1);
		
		// Handles a special case where an 1.0.0.0 save game is loaded after 1.1.0.0.
		IF
		SavegameLoaded(_, _, _, _)
		AND
		DB_RoguelikeArena_ModVersion(_Major, _Minor, _Revision, _Build)
		AND
		SysCount("DB_RoguelikeArena_AvailableCompanions", 2, _Count)
		AND
		_Count == 0
		THEN
		NOT DB_RoguelikeArena_ModVersion(_Major, _Minor, _Revision, _Build);
		DB_RoguelikeArena_ModVersion(1, 0, 0, 0);
		
		// Predicts save game version to be 1.0.0.0.
		IF
		SavegameLoaded(_, _, _, _)
		AND
		NOT DB_RoguelikeArena_ModVersion(_, _, _, _)
		AND
		SysCount("DB_RoguelikeArena_AvailableCompanions", 2, _Count)
		AND
		_Count == 0
		THEN
		DB_RoguelikeArena_ModVersion(1, 0, 0, 0);
		
		// Predicts save game version to be 1.0.1.0.
		IF
		SavegameLoaded(_, _, _, _)
		AND
		NOT DB_RoguelikeArena_ModVersion(_, _, _, _)
		AND
		NOT DB_RoguelikeArena_SpawnTriggers(1, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_000_8ab9c409-7d47-4ed0-bb02-7f8e1f7eae2e)
		THEN
		DB_RoguelikeArena_ModVersion(1, 0, 1, 0);
		
		// Predicts save game version to be 1.0.5.0.
		IF
		SavegameLoaded(_, _, _, _)
		AND
		NOT DB_RoguelikeArena_ModVersion(_, _, _, _)
		THEN
		DB_RoguelikeArena_ModVersion(1, 0, 5, 0); // Latest untracked version
		
		IF
		SavegameLoaded(_, _, _, _)
		AND
		DB_RoguelikeArena_ModVersion(_Major, _Minor, _Revision, _Build)
		THEN
		PROC_RoguelikeArena_SavegameLoaded(_Major, _Minor, _Revision, _Build);
		
		//REGION 1.0.1.0
		PROC
		PROC_RoguelikeArena_SavegameLoaded(_Major, _Minor, _Revision, _Build)
		AND
		QRY_RoguelikeArena_ShouldApplyPatch(_Major, _Minor, _Revision, _Build, 1, 0, 1, 0)
		THEN
		DebugBreak("Applying patch 1.0.1.0");
		PROC_RoguelikeArena_ApplyPatch_1_0_1_0();
		
		PROC
		PROC_RoguelikeArena_ApplyPatch_1_0_1_0()
		THEN
		DB_RoguelikeArena_AvailableCompanions("HumanMale", (CHARACTERGUID)CHARACTERGUID_RoguelikeArena_Companion_000_c4a2faca-e1e2-4fc9-90dd-a05c8e8fc113);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_001_c6c954d3-b839-4c88-ba44-bee1c469fc5d);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_002_d380599f-33b5-4dad-af96-338fe7226453);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_003_95657b67-79f5-4c2c-a6f0-5b209c35d8c1);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_004_8a8ef927-f365-4fa4-b017-d9aa94c44e15);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_005_411b2516-c451-4949-adc1-118360318101);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_006_d4549dd7-2430-4e45-a8e7-ec2bcea34562);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_007_03792e23-d55c-4904-9a7f-80b5607d4e18);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_008_9613a61a-362d-48b9-a115-ac732e399343);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_009_1fdc64f4-3e2b-48b4-b284-48bef4170cc9);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_010_0229457f-e140-4492-ba0e-6766e962da16);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_011_9f2c9779-820c-4257-9005-a37096bdf498);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_012_d4b2d14d-c5ee-4384-b844-11a0de8302db);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_013_31af7ded-5c50-4c5b-a4cf-b93e06bdfd37);
		DB_RoguelikeArena_AvailableCompanions("HumanMale", CHARACTERGUID_RoguelikeArena_Companion_014_0d17c35d-1937-4738-bc95-4c7b9a370e43);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_015_6402ae78-724b-4b05-b1ea-5fcac33b0bf7);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_016_bbf2d7b2-dcea-441b-8010-90808ef00199);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_017_83f003cb-c679-42bf-bf1f-cfee10fb67df);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_018_81762fcd-d60c-47fb-8a9e-164f9f3565c1);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_019_00a8001b-a859-40e7-9bf0-29561ba0b3cd);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_020_5780eeb8-4111-4e00-986f-b5f7ef0dde5a);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_021_24ef676d-f68a-48aa-a882-15a7161aa6a6);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_022_703d7cf7-e584-4587-9476-5736b84b9f58);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_023_564ca72d-a658-474e-8988-4877d0fb8af4);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_024_8fffdddb-248c-4137-a49a-eacd421e9ce7);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_025_d8f5d4fb-9b9e-43d0-8eb9-c89c67e15572);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_026_4653c875-cfec-4521-ab87-7da900cf6511);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_027_3f8c5849-fdeb-4208-aef8-abbe3b3b6d3c);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_028_37c4e402-bf32-4215-b399-7ac0c08e4419);
		DB_RoguelikeArena_AvailableCompanions("HumanFemale", CHARACTERGUID_RoguelikeArena_Companion_029_f1d362ec-2cf8-4032-a1ba-425aa9ddd894);
