		DB_IgnoreAssault(CHARACTERGUID_S_ARX_HorrorSleep_Sunset_Newt_1f46750f-1d62-4676-aaa7-9ec226c96428);
		
		//DB_ARX_HorrorSleep_Sunset_DragonEgg_StatusToHatch("WARM");
