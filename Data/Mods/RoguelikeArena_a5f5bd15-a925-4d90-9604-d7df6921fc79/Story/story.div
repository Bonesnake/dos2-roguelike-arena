		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_000_67a9bc1b-aa7d-4b33-bc42-3ae90db6c4f9);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_001_8dacdb1f-3276-44a8-9d00-76a2279d9f84);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_002_da5d2cff-5b79-4e16-97e9-bab2486359c0);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_003_a3bc2405-f29c-4138-a8c3-8d2d864a0b88);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_004_676d2c45-cb5d-4f5d-aa56-0e722dfd1174);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_005_91027f0d-aa02-4714-8875-020f681f81f1);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_006_daba434a-edb3-483c-8cf1-753625e53557);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_007_97f2b8b3-7bde-4914-993f-0138ff2c123b);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_008_60061b24-f75c-45b2-8849-248eefeef6a5);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_009_07e8cc0c-77d1-49a7-b44f-2e09e694caea);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_010_4b0deaac-a434-4570-8e86-d9bd323362da);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_011_86c3d679-ec08-4ac7-a316-b2ba4b4e6d0b);
		
	}
	KB
	{
		// Resets pool when there are no available spawners in the pool.
		QRY
		QRY_RoguelikeArena_GetRandomPositionInArena((INTEGER)_Arena, (STRING)_SpawnerTag)
		AND
		IntegertoString(_Arena, _ArenaString)
		AND
		StringConcatenate("RoguelikeArena_SpawnerPool_", _ArenaString, _PoolPart)
		AND
		StringConcatenate(_PoolPart, _SpawnerTag, _Pool)
		AND
		NOT DB_RoguelikeArena_GuidStringPool(_Pool, _, _)
		AND
		DB_RoguelikeArena_SpawnTriggers(_Arena, _Trigger)
		AND
		IsTagged(_Trigger, _SpawnerTag, 1)
		THEN
		PROC_RoguelikeArena_GuidStringPoolAdd(_Pool, _Trigger);
		
		// Selects a random spawner.
		QRY
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, _SpawnerTag)
		AND
		IntegertoString(_Arena, _ArenaString)
		AND
		StringConcatenate("RoguelikeArena_SpawnerPool_", _ArenaString, _PoolPart)
		AND
		StringConcatenate(_PoolPart, _SpawnerTag, _Pool)
		AND
		QRY_RoguelikeArena_GuidStringPoolSelectAndRemoveRandom(_Pool)
		AND
		DB_RoguelikeArena_GuidStringPoolSelectedValue(_Pool, _Trigger)
		AND
		GetPosition(_Trigger, _X, _Y, _Z)
		THEN
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z);
		
		IF
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		DB_RoguelikeArena_RandomPositionResult(_XOther, _YOther, _ZOther)
		AND
		NOT QRY_RoguelikeArena_ArePositionsEqual(_X, _Y, _Z, _XOther, _YOther, _ZOther)
		THEN
		NOT DB_RoguelikeArena_RandomPositionResult(_XOther, _YOther, _ZOther);
		
		QRY
		QRY_RoguelikeArena_ArePositionsEqual((REAL)_X, (REAL)_Y, (REAL)_Z, (REAL)_XOther, (REAL)_YOther, (REAL)_ZOther)
		AND
		_X == _XOther
		AND
		_Y == _YOther
		AND
		_Z == _ZOther
		THEN
		DB_NOOP(1);
		
	}
	EXIT
	{
		
	}
}
Goal(561).Title("RoguelikeArena_Arena_Surfaces");
Goal(561)
{
	INIT
	{
		DB_RoguelikeArena_SurfaceTypes("SurfaceBlood");
		DB_RoguelikeArena_SurfaceTypes("SurfaceBloodElectrified");
		DB_RoguelikeArena_SurfaceTypes("SurfaceBloodFrozen");
		DB_RoguelikeArena_SurfaceTypes("SurfaceFire");
		DB_RoguelikeArena_SurfaceTypes("SurfaceOil");
		DB_RoguelikeArena_SurfaceTypes("SurfacePoison");
		DB_RoguelikeArena_SurfaceTypes("SurfaceSource");
		DB_RoguelikeArena_SurfaceTypes("SurfaceWater");
		DB_RoguelikeArena_SurfaceTypes("SurfaceWaterElectrified");
		DB_RoguelikeArena_SurfaceTypes("SurfaceWaterFrozen");
		DB_RoguelikeArena_SurfaceTypes("SurfaceWeb");
		
		PROC_RoguelikeArena_StringPoolAddSurfaceTypes();
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_CreateSurfaces((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		QRY_RoguelikeArena_RandomCount(_Difficulty, 1, 1, 1)
		AND
		DB_RoguelikeArena_RandomResult(_SurfaceCount)
		THEN
		PROC_RoguelikeArena_CreateSurfaces(_Arena, _Level, _Difficulty, _SurfaceCount);
		
		PROC
		PROC_RoguelikeArena_CreateSurfaces((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		PROC_RoguelikeArena_CreateSurface(_Arena, _Level, _Difficulty);
		
		PROC
		PROC_RoguelikeArena_CreateSurface((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		QRY_RoguelikeArena_StringPoolSelectRandom("SurfaceTypePool")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("SurfaceTypePool", _SurfaceType)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_EVENT")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		THEN
		CreateSurfaceAtPosition(_X, _Y, _Z, _SurfaceType, 2.0, -1.0);
		PROC_RoguelikeArena_SurfaceCreated(_X, _Y, _Z, _SurfaceType, _Arena);
		
		// Triggered when a surface is created inside an arena.
		PROC
		PROC_RoguelikeArena_SurfaceCreated((REAL)_X, (REAL)_Y, (REAL)_Z, (STRING)_SurfaceType, (INTEGER)_Arena)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_StringPoolAddSurfaceTypes()
		AND
		DB_RoguelikeArena_SurfaceTypes(_SurfaceType)
		THEN
		PROC_RoguelikeArena_StringPoolAdd("SurfaceTypePool", _SurfaceType);
		
	}
	EXIT
	{
		
	}
}
Goal(562).Title("RoguelikeArena_Arena_SurvivalMode");
Goal(562)
{
	INIT
	{
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_StartSurvivalMode((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		AND
		QRY_RoguelikeArena_RandomCount(_Difficulty, 2, 1, 1)
		AND
		DB_RoguelikeArena_RandomResult(_MaxWave)
		THEN
		DB_RoguelikeArena_SurvivalMode(_Arena, _Level, _Difficulty, _Players);
		DB_RoguelikeArena_CurrentWave(_Arena, 1);
		DB_RoguelikeArena_MaxWave(_Arena, _MaxWave);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		PROC_RoguelikeArena_SurvivalModeWaveStarted(_Arena, 1);
		
		PROC
		PROC_RoguelikeArena_EnemySpawned(_Enemy, _Arena, _)
		AND
		DB_RoguelikeArena_SurvivalMode(_Arena, _, _, _)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ENEMY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		THEN
		PROC_RoguelikeArena_CharacterMakeUndying(_Enemy, _X, _Y, _Z);
		
		PROC
		PROC_RoguelikeArena_CharacterRespawned(_Character)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		DB_RoguelikeArena_SurvivalMode(_Arena, _, _, _)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ENEMY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		THEN
		PROC_RoguelikeArena_CharacterSetRespawnPosition(_Character, _X, _Y, _Z);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatRoundStarted(_Arena, _CombatID, _Round)
		AND
		DB_RoguelikeArena_CurrentWave(_Arena, _CurrentWave)
		AND
		DB_RoguelikeArena_MaxWave(_Arena, _MaxWave)
		THEN
		PROC_RoguelikeArena_SurvivalModeCombatRoundStarted(_Arena, _CombatID, _Round, _CurrentWave, _MaxWave);
		
		PROC
		PROC_RoguelikeArena_SurvivalModeCombatRoundStarted((INTEGER)_Arena, (INTEGER)_CombatID, (INTEGER)_Round, (INTEGER)_CurrentWave, (INTEGER)_MaxWave)
		AND
		_Round > 1
		AND
		QRY_RoguelikeArena_AnyPlayersInCombat(_CombatID)
		AND
		_CurrentWave >= _MaxWave
		THEN
		PROC_RoguelikeArena_LastWaveSurvived(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_SurvivalModeCombatRoundStarted(_Arena, _CombatID, _Round, _CurrentWave, _MaxWave)
		AND
		_Round > 1
		AND
		QRY_RoguelikeArena_AnyPlayersInCombat(_CombatID)
		AND
		_CurrentWave < _MaxWave
		AND
		IntegerSum(_CurrentWave, 1, _NextWave)
		THEN
		NOT DB_RoguelikeArena_CurrentWave(_Arena, _CurrentWave);
		DB_RoguelikeArena_CurrentWave(_Arena, _NextWave);
		PROC_RoguelikeArena_SurvivalModeWaveStarted(_Arena, _NextWave);
		
		// Shows a notification about waves survived.
		PROC
		PROC_RoguelikeArena_SurvivalModeWaveStarted((INTEGER)_Arena, (INTEGER)_Wave)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		CharacterIsPlayer(_Character, 1)
		AND
		IntegerSubtract(_Wave, 1, _WavesSurvived)
		AND
		IntegertoString(_WavesSurvived, _WavesSurvivedString)
		AND
		DB_RoguelikeArena_MaxWave(_Arena, _MaxWave)
		AND
		IntegertoString(_MaxWave, _MaxWaveString)
		AND
		StringConcatenate(_WavesSurvivedString, "/", _NotificationPart1)
		AND
		StringConcatenate(_MaxWaveString, " waves survived", _NotificationPart2)
		AND
		StringConcatenate(_NotificationPart1, _NotificationPart2, _Notification)
		THEN
		ShowNotification(_Character, _Notification);
		
		// Prevent race conditions where the last enemy dies on their own turn and gets resurrected after the combat ends.
		PROC
		PROC_RoguelikeArena_SurvivalModeWaveStarted(_Arena, _Wave)
		AND
		DB_RoguelikeArena_MaxWave(_Arena, _MaxWave)
		AND
		_Wave == _MaxWave
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		QRY_RoguelikeArena_CharacterIsUndying(_Character)
		THEN
		PROC_RoguelikeArena_CharacterMakeDying(_Character);
		
		PROC
		PROC_RoguelikeArena_LastWaveSurvived((INTEGER)_Arena, (INTEGER)_CombatID)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		QRY_RoguelikeArena_CharacterIsUndying(_Character)
		THEN
		PROC_RoguelikeArena_CharacterMakeDying(_Character);
		
		PROC
		PROC_RoguelikeArena_LastWaveSurvived(_, _CombatID)
		AND
		DB_CombatCharacters(_Character, _CombatID)
		AND
		GetFaction(_Character, "Evil NPC")
		AND
		CharacterIsDead(_Character, 0)
		THEN
		CharacterDie(_Character, 1, "Explode");
		
		PROC
		PROC_RoguelikeArena_LastWaveSurvived(_Arena, _CombatID)
		THEN
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_SurvivalMode(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_SurvivalModeEnded(_Arena);
		
		PROC
		PROC_RoguelikeArena_SurvivalModeEnded((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_SurvivalMode(_Arena, _Level, _Difficulty, _Players)
		THEN
		NOT DB_RoguelikeArena_SurvivalMode(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_SurvivalModeEnded(_Arena)
		AND
		DB_RoguelikeArena_CurrentWave(_Arena, _CurrentWave)
		THEN
		NOT DB_RoguelikeArena_CurrentWave(_Arena, _CurrentWave);
		
		PROC
		PROC_RoguelikeArena_SurvivalModeEnded(_Arena)
		AND
		DB_RoguelikeArena_MaxWave(_Arena, _MaxWave)
		THEN
		NOT DB_RoguelikeArena_MaxWave(_Arena, _MaxWave);
		
	}
	EXIT
	{
		
	}
}
Goal(563).Title("RoguelikeArena_Arena_TeamDeathmatch");
