		DB_TrespassTrigger((TRIGGERGUID)HouseTest_ForbetenArea_fb085e7e-6820-4776-9a35-6369a6fe8ec5,(TRIGGERGUID)Traspassing_Trigger_Exist_bdc5b3da-041a-4d98-bb68-149869203e83);
