		DB_RoguelikeArena_SpawnTriggers(6, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_008_8544b18f-08e6-4b1d-bc21-8b7776593c05);
		DB_RoguelikeArena_SpawnTriggers(6, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_009_5e4d5de1-403d-4fbf-a7c0-f7abb030b26d);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_000_67a9bc1b-aa7d-4b33-bc42-3ae90db6c4f9);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_001_8dacdb1f-3276-44a8-9d00-76a2279d9f84);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_002_da5d2cff-5b79-4e16-97e9-bab2486359c0);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_003_a3bc2405-f29c-4138-a8c3-8d2d864a0b88);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_004_676d2c45-cb5d-4f5d-aa56-0e722dfd1174);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_005_91027f0d-aa02-4714-8875-020f681f81f1);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_006_daba434a-edb3-483c-8cf1-753625e53557);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_007_97f2b8b3-7bde-4914-993f-0138ff2c123b);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_008_60061b24-f75c-45b2-8849-248eefeef6a5);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_009_07e8cc0c-77d1-49a7-b44f-2e09e694caea);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_010_4b0deaac-a434-4570-8e86-d9bd323362da);
		DB_RoguelikeArena_SpawnTriggers(7, TRIGGERGUID_RoguelikeArena_AllySpawnerTrigger_011_86c3d679-ec08-4ac7-a316-b2ba4b4e6d0b);
		//END_REGION
		
		//REGION 1.1.0.0
		PROC
		PROC_RoguelikeArena_SavegameLoaded(_Major, _Minor, _Revision, _Build)
		AND
		QRY_RoguelikeArena_ShouldApplyPatch(_Major, _Minor, _Revision, _Build, 1, 1, 0, 0)
		THEN
		DebugBreak("Applying patch 1.1.0.0");
		PROC_RoguelikeArena_ApplyPatch_1_1_0_0();
		
		PROC
		PROC_RoguelikeArena_ApplyPatch_1_1_0_0()
		AND
		DB_RoguelikeArena_CleanupRegisteredObjects(_Object, _Arena)
		AND
		ObjectIsCharacter(_Object, 1)
		THEN
		DB_RoguelikeArena_ArenaCharacters(_Arena, (CHARACTERGUID)_Object);
		
		PROC
		PROC_RoguelikeArena_ApplyPatch_1_1_0_0()
		AND
		DB_RoguelikeArena_CleanupRegisteredObjects(_Object, _Arena)
		AND
		ObjectIsItem(_Object, 1)
		THEN
		DB_RoguelikeArena_ArenaItems(_Arena, (ITEMGUID)_Object);
		
		PROC
		PROC_RoguelikeArena_ApplyPatch_1_1_0_0()
		AND
		DB_RoguelikeArena_CleanupRegisteredObjects(_Object, _Arena)
		THEN
		DB_RoguelikeArena_ArenaObjects(_Arena, _Object);
		NOT DB_RoguelikeArena_CleanupRegisteredObjects(_Object, _Arena);
		
		PROC
		PROC_RoguelikeArena_ApplyPatch_1_1_0_0()
		THEN
		PROC_RoguelikeArena_InitArenaGameModeStory();
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(599).Title("Sandbox");
Goal(599)
{
	INIT
	{
		DB_CheckLevelStart("_TMPL_Sandbox");
		
	}
	KB
	{
		IF
		RegionStarted("_TMPL_Sandbox")
		THEN
		GoalCompleted;
		
		IF
		DB_CheckLevelStart("_TMPL_Sandbox")
		AND
		DB_CurrentLevel("_TMPL_Sandbox")
		THEN
		GoalCompleted;
		
	}
	EXIT
	{
		NOT DB_CheckLevelStart("_TMPL_Sandbox");
		
	}
}
Goal(600).Title("Shared_CombatDialogs");
Goal(600)
{
	INIT
	{
		
	}
	KB
	{
		//REGION Interrupt repeated automated dialogs for characters entering combat
		IF
		ObjectEnteredCombat(_Char,_)
		AND
		DB_DialogNPCs(_ID,_Char,_)
		AND
		DB_DialogName(_DialogName, _ID)
		AND
		NOT DB_CombatDialogs_NoStop((STRING)_DialogName)
		AND
		DialogGetCategory(_ID,"Repeated automated NPC Dialog")
		THEN
		ProcForceStopDialog(_Char);
		//END_REGION
		
		
	}
	EXIT
	{
		
	}
}
Goal(601).Title("Shared_DOS_CharacterCreation");
Goal(601)
{
	INIT
	{
		
	}
	KB
	{
		PROC
		ProcSetupGenericOrigin((CHARACTERGUID)S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe)
		AND
		Random(7,_Rand)
		AND
		DB_UndeadRacePresets(_Rand,_Preset)
		THEN
		CharacterApplyRacePreset(CHARACTERGUID_S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe,_Preset);
		// Caught in 
		ObjectSetFlag(CHARACTERGUID_S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe,"DEBUG_UndeadPresetDelay");
		// Used below to apply the class preset after the race transformation is complete,
		// as the race influences the class preset (undead get hoods)
		DB_DEBUG_ClassPresetDelay(S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe);
		
		PROC
		ProcSetupGenericOrigin((CHARACTERGUID)S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe)
		AND
		NOT DB_DEBUG_ClassPresetDelay(S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe)
		THEN
		DB_ApplyPreset(S_Player_GenericOrigin_7b6c1f26-fe4e-40bd-a5d0-e6ff58cef4fe,"Conjurer");
		
		IF
		ObjectTransformed(_Player, _)
		AND
		DB_DEBUG_ClassPresetDelay(_Player)
		THEN
		NOT DB_DEBUG_ClassPresetDelay(_Player);
		DB_ApplyPreset((CHARACTERGUID)_Player,"Conjurer");
		ProcMarkUndeadOrigin((CHARACTERGUID)_Player);
		DB_RestartUndeadCrime((CHARACTERGUID)_Player);
		PROC_DOS_CharacterCreation_ClearOriginalRaceTags(_Player);
		PROC_GLO_SetOriginalRaceTag(_Player);
		
		PROC
		PROC_DOS_CharacterCreation_ClearOriginalRaceTags((CHARACTERGUID)_Player)
		AND
		DB_Shapeshifting_OriginalRaces(_, _Tag)
		THEN
		ClearTag(_Player, _Tag);
		
		IF
		TextEventSet("applyundeadpreset")
		AND
		CharacterGetHostCharacter(_Player)
		AND
		DB_UndeadRacePresets(0,_Preset)
		THEN
		DB_DEBUG_ClassPresetDelay(_Player);
		CharacterApplyRacePreset(_Player,_Preset);
		
	}
	EXIT
	{
		
	}
}
Goal(602).Title("Shared_DOS_HenchmenRecruiter");
Goal(602)
{
	INIT
	{
		
	}
	KB
	{
		//REGION Setup
		
		PROC
		PROC_Shared_DOS_Henchmen_AddRecruiter((CHARACTERGUID)_Recruiter, (STRING)_Dialog)
		THEN
		DB_Shared_DOS_Henchmen_Recruiter((CHARACTERGUID)_Recruiter);
		DB_Dialogs(_Recruiter, _Dialog);
		
		
		PROC
		PROC_Shared_DOS_Henchmen_AddHenchman((CHARACTERGUID)_Recruiter, (CHARACTERGUID)_Henchman, (STRING)_Preset, (STRING)_PriceGroupName, (INTEGER)_MoneyVarIndex)
		THEN
		DB_Shared_DOS_Henchmen_PriceGroup(_Recruiter, _PriceGroupName, _MoneyVarIndex, _Preset);
		DB_Shared_DOS_Henchmen_Recruitee(_Recruiter, _Preset, _Henchman);
		//END_REGION
		
		
		//REGION Init
		
		PROC
		PROC_Shared_DOS_Henchmen_Init((CHARACTERGUID)_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		THEN
		CharacterSetCanTrade(_Recruiter, 0);
		CharacterDisableCrime(_Recruiter, "ActiveUndead");
		
		
		IF
		DB_Shared_DOS_Henchmen_Recruiter((CHARACTERGUID)_Recruiter)
		AND
		DB_Dialogs(_Recruiter, _Dialog)
		AND
		DB_Shared_DOS_Henchmen_PriceGroup(_Recruiter, _, _GoldVarIndex, _)
		THEN
		DB_DialogMoneyTransfer(_GoldVarIndex, _Dialog, 0);
		
		
		PROC
		PROC_Shared_DOS_Henchmen_Init(_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruitee(_Recruiter, _Preset, _Char)
		AND
		StringConcatenate("Shared_DOS_ToBeHired_", _Preset, _ToBeHiredFlag)
		AND
		StringConcatenate("Shared_DOS_Hired_", _Preset, _HiredFlag)
		THEN
		DB_Shared_DOS_Henchmen_HiredFlags(_Preset, _ToBeHiredFlag, _HiredFlag, _Recruiter);
		SetOnStage(_Char, 0);
		
		
		// All regular player characters are made players in CC, and then NPCs afterwards
		// -> DB_GLO_PartyMembers_DefaultFaction is set for them. This is not the case
		// for the henchmen, so define it in advance.
		PROC
		PROC_Shared_DOS_Henchmen_Init(_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruitee(_Recruiter, _Preset, _Char)
		AND
		StringConcatenate("Hero Henchman ", _Preset, _DefaultFaction)
		THEN
		DB_GLO_PartyMembers_DefaultFaction(_Char, _DefaultFaction);
		
		
		QRY
		QRY_GLO_PartyMembers_GetInPartyDialog((CHARACTERGUID)_Henchman)
		AND
		DB_Shared_DOS_Henchmen_Recruitee(_, _, _Henchman)
		THEN
		DB_GLO_PartyMembers_InPartyDialog(_Henchman, "GLO_Henchman");
		
		//END_REGION
		
		
		//REGION Recruitment dialog
		IF
		ObjectFlagSet(_PricesFlag,(CHARACTERGUID)_Recruiter, _ID)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		AND
		DB_Dialogs(_Recruiter, _Dialog)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		CharacterGetLevel((CHARACTERGUID)_Player, _Level)
		AND
		DB_Shared_DOS_Henchmen_PriceGroup(_Recruiter, _PricesFlag, _GoldVarIndex, _Preset)
		AND
		CharacterGetHenchmanPresetPrice(_Player, _Preset, _Price)
		AND
		DB_FirstGoal_MoneyDialogVar(_GoldVarIndex, _VarName)
		THEN
		ObjectClearFlag(_Recruiter, _PricesFlag);
		DialogSetVariableInt(_Dialog, _VarName, _Price);
		
		
		IF
		ObjectFlagSet(_ToBeHiredFlag,(CHARACTERGUID)_Recruiter, _ID)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_HiredFlags(_Preset, _ToBeHiredFlag, _HiredFlag, _Recruiter)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		DB_DialogName(_Dialog, _ID)
		AND
		CharacterGetHenchmanPresetPrice((CHARACTERGUID)_Player, _Preset, _Price)
		AND
		DB_FirstGoal_MoneyDialogVar(1, _VarName)
		THEN
		DB_Shared_DOS_Henchmen_HireAfterDialog(_Preset, _ID, _Recruiter);
		// This gold value only updates the when the dialog starts, so we also have to manually
		// update the dialog var as well
		DB_DialogMoneyTransfer(1, _Dialog, _Price);
		DialogSetVariableInt(_Dialog, _VarName, _Price);
		
		
		
		IF
		ObjectFlagCleared(_ToBeHiredFlag, (CHARACTERGUID)_Recruiter, _ID)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_HiredFlags(_Preset, _ToBeHiredFlag, _HiredFlag, _Recruiter)
		THEN
		NOT DB_Shared_DOS_Henchmen_HireAfterDialog(_Preset, _ID, _Recruiter);
		//END_REGION
		
		
		
		//REGION Recruiting
		
		IF
		ObjectFlagSet("Shared_DOS_HenchmenHireConfirmed",(CHARACTERGUID)_Recruiter, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		DB_Shared_DOS_Henchmen_HireAfterDialog(_Preset, _ID, _Recruiter)
		AND
		DB_Shared_DOS_Henchmen_HiredFlags(_Preset, _ToBeHiredFlag, _HiredFlag, _Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruitee(_Recruiter, _Preset, _Henchman)
		THEN
		ObjectClearFlag(_Recruiter, _ToBeHiredFlag);
		ObjectSetFlag(_Recruiter, _HiredFlag);
		ObjectClearFlag(_Recruiter, "Shared_DOS_HenchmenHireConfirmed");
		DB_GLO_PartyMembers_OriginalAlignment(_Henchman, "Neutral");
		PROC_Shared_DOS_Henchmen_AddToParty(_Henchman, _Preset,(CHARACTERGUID)_Player, _ID);
		
		
		PROC
		PROC_Shared_DOS_Henchmen_AddToParty((CHARACTERGUID)_Henchman,(STRING)_Preset,(CHARACTERGUID)_Player, (INTEGER)_ID)
		AND
		GlobalGetFlag("GEN_MaxPlayerCountReached", 0)
		AND
		GetUUID(_Henchman, _UUID)
		AND
		StringConcatenate("Shared_DOS_Henchmen_MadePlayer_", _UUID, _HenchmanMadePlayerOnlyOnce)
		AND
		QueryOnlyOnce(_HenchmanMadePlayerOnlyOnce)
		THEN
		DB_Shared_DOS_Henchmen_Recruited((CHARACTERGUID)_Player, _Preset, _Henchman);
		SetOnStage(_Henchman,1);
		CharacterMakePlayer(_Henchman, _Player);
		
		PROC
		PROC_Shared_DOS_Henchmen_AddToParty((CHARACTERGUID)_Henchman,(STRING)_Preset,(CHARACTERGUID)_Player, (INTEGER)_ID)
		AND
		GlobalGetFlag("GEN_MaxPlayerCountReached", 0)
		THEN
		PROC_GLO_PartyMembers_Add(_Henchman,(CHARACTERGUID)_Player);
		CharacterApplyHenchmanPreset(_Henchman, _Preset);
		TeleportTo(_Henchman, _Player);
		Foop(_Henchman);
		ObjectSetDialogFlag(_Player, "GEN_TransferNPCPayment", _ID);
		
		//END_REGION
		
		//REGION Dismissing Henchmen
		PROC
		PROC_GLO_PartyMembers_MakeNPCHook((CHARACTERGUID)_Henchman)
		AND
		NOT DB_GLO_PartyMembers_BlockReturnToRecruitmentPosition(_Henchman)
		AND
		DB_Shared_DOS_Henchmen_Recruited(_Player, _Preset, _Henchman)
		THEN
		CharacterDisappearOutOfSight(_Henchman, 0, 0, "Shared_DOS_Henchmen_Dismissed", 0);
		
		IF
		StoryEvent((CHARACTERGUID)_Henchman,"Shared_DOS_Henchmen_Dismissed")
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruited(_Player,_Preset,_Henchman)
		AND
		DB_Shared_DOS_Henchmen_HiredFlags(_Preset,_ToBeHiredFlag,_HiredFlag, _Recruiter)
		AND
		// Prevent making the henchman available for hire again if it's only a temporary dismissal
		NOT DB_GLO_PartyMembers_TempRemoved(_,_Henchman)
		THEN
		NOT DB_Shared_DOS_Henchmen_Recruited(_Player,_Preset,_Henchman);
		PROC_GLO_PartyMembers_TransferInventoryToPlayer(_Henchman,_Player);
		ObjectClearFlag(_Recruiter,_HiredFlag);
		
		//END_REGION
		
		//REGION Disable/enable henchmen recruiting
		
		PROC
		PROC_Shared_DOS_DisableHenchmenRecruiting((CHARACTERGUID)_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		THEN
		ObjectSetFlag(_Recruiter,"Shared_DOS_HecnhmenRecruiter_Blocked");
		
		PROC
		PROC_Shared_DOS_EnableHenchmenRecruiting((CHARACTERGUID)_Recruiter)
		AND
		DB_Shared_DOS_Henchmen_Recruiter(_Recruiter)
		THEN
		ObjectClearFlag(_Recruiter,"Shared_DOS_HecnhmenRecruiter_Blocked");
		
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
