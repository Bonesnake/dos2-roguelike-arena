		ProcClearStoryMove(CHARACTERGUID_S_Player_Beast_f25ca124-a4d2-427b-af62-df66df41a978);
		
		IF
		ObjectFlagSet("Recruit_Fane",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_Fane_02a77f1f-872b-49ca-91ab-32098c443beb,_Player);
