		DB_ARX_TheDoctor_Vaults(ITEMGUID_S_ARX_DoctorsHouse_Vault_Case_04_5adcec57-b366-42c0-b06e-e23bc372ee64,TRIGGERGUID_S_ARX_DoctorsHouse_Vault_Case_04_Trig_93f68b5c-0f8b-4885-a6df-daadfa0d7997);
