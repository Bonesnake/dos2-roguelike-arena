Goal(291).Title("GLO_Dallis");
Goal(291)
{
	INIT
	{
		ProcDeclareCounter("GLO_DallisDefeatedCounter");
		CharacterSetImmortal(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,1);
		
	}
	KB
	{
		//REGION Dallis Defeated in Fort Joy
		
		IF
		GlobalFlagSet("FTJ_DallisDefeatedInGhetto")
		AND
		DB_IsPlayer((CHARACTERGUID)_Player)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_FTJ_Escape_DallisDefeatedInGhetto");
		
		IF
		GlobalFlagSet("FTJ_DallisGhettoEventEnd")
		THEN
		CrimeAreaSetTensionModifier(TRIGGERGUID_S_FTJ_CrimeRegion_DallsScene_6e23e5d6-4dae-405f-9364-0fe332e9d440,0);
		
		
		IF
		GlobalFlagSet("FTJ_DallisDefeatedInGhetto")
		AND
		GetPosition(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_X,_Y,_Z)
		THEN
		Proc_DallisTransformAndLeave();
		
		//Loot
		IF
		DB_DallisDefeatedItemDrop((ITEMGUID)_DallisLoot)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		GetPosition(_DallisLoot,_X,_Y,_Z)
		AND
		_Region == "FJ_FortJoy_Main"
		THEN
		ItemLevelUpTo(_DallisLoot,5);
		NOT DB_DallisDefeatedItemDrop(_DallisLoot);
		ItemScatterAt(_DallisLoot,_X,_Y,_Z);
		
		IF
		CharacterStatusApplied(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"DALLISDRAGON",_)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "FJ_FortJoy_Main"
		THEN
		GlobalSetFlag("FTJ_DallisDefeatedInGhetto");
		//ClearScriptframe(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572);
		
		//END_REGION
		
		//REGION Dallis Defeated in LV_HoE
		//First Time defeating
		IF
		GlobalFlagSet("LV_HoE_DallisTransformation")
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",0)
		AND
		DB_IsPlayer((CHARACTERGUID)_Player)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_LV_Main_DefeatedDallisLV");
		
		IF
		GlobalFlagSet("LV_HoE_DallisTransformation")
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",1)
		AND
		DB_IsPlayer((CHARACTERGUID)_Player)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_LV_Main_DefeatedDallisFTJLV");
		
		
		IF
		GlobalFlagSet("LV_HoE_DallisTransformation")
		THEN
		Proc_DallisTransformAndLeave();
		
		IF
		StoryEvent(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"GEN_GoOffStage")
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "LV_HoE_Main"
		THEN
		Proc_LV_FinishAssaultEarly();
		
		//Loot
		IF
		DB_DallisDefeatedItemDrop((ITEMGUID)_DallisLoot)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "LV_HoE_Main"
		AND
		GetPosition(TRIGGERGUID_S_LV_HoE_DallisItemDrop_Point_97ef63e5-2f0a-4c4a-aba6-438e2f092be6,_X,_Y,_Z)
		THEN
		ItemLevelUpTo(_DallisLoot,9);
		ItemToTransform(_DallisLoot,_X,_Y,_Z,0.0,0.0,0.0,1,NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_DallisDefeatedItemDrop(_DallisLoot);
		ItemScatterAt(_DallisLoot,_X,_Y,_Z);
		
		
		IF
		CharacterStatusApplied(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"DALLISDRAGON",_)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "LV_HoE_Main"
		THEN
		GlobalSetFlag("LV_HoE_DallisTransformation");
		
		
		
		//END_REGION
		
		//REGION Dallis defeated in the Endgame
		IF
		DB_DallisDefeatedItemDrop(_DallisLoot)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		GetPosition(_DallisLoot,_X,_Y,_Z)
		AND
		_Region == "ARX_EndGame"
		AND
		CharacterIsDead(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,0)
		THEN
		ItemLevelUpTo(_DallisLoot,20);
		NOT DB_DallisDefeatedItemDrop(_DallisLoot);
		ItemScatterAt(_DallisLoot,_X,_Y,_Z);
		
		//Dallis in Dragon Form, send to inventory
		IF
		DB_DallisDefeatedItemDrop(_DallisLoot)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "ARX_EndGame"
		AND
		CharacterIsDead(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,1)
		THEN
		ItemLevelUpTo(_DallisLoot,20);
		NOT DB_DallisDefeatedItemDrop(_DallisLoot);
		ItemToInventory(_DallisLoot,CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572);
		
		//END_REGION
		
		//REGION Dallis Drops
		
		IF
		CharacterStatusApplied(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"UNCONSCIOUS",_)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "ARX_EndGame"
		AND
		QueryOnlyOnce("EG_DallisLootInstantiate_Once")
		THEN
		Proc_DallisLootInstantiate();
		Proc_RemoveWeapons(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572);
		
		IF
		CharacterDying(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region == "ARX_EndGame"
		AND
		QueryOnlyOnce("EG_DallisLootInstantiate_Once")
		THEN
		Proc_DallisLootInstantiate();
		Proc_RemoveWeapons(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572);
		
		PROC
		Proc_DallisTransformAndLeave()
		THEN
		Proc_DallisLootInstantiate();
		
		
		//Third Kill
		PROC
		Proc_DallisLootInstantiate()
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",2)
		AND
		GetPosition(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_X,_Y,_Z)
		AND
		RealSum(_Y,0.5,_NewY)
		AND
		RealSum(_Z,1.0,_NewZ_A)
		AND
		RealSubtract(_Z,1.0,_NewZ_B)
		AND
		CreateItemTemplateAtPosition("UNI_Dallis_Stage3_HammerA_d770ec8f-fbe1-4f69-b9fe-23b150053ce4",_X,_NewY,_NewZ_A,_DallisDualHammer_A)
		AND
		CreateItemTemplateAtPosition("UNI_Dallis_Stage3_HammerB_bbdfc369-e556-4497-b82d-cdd0fa1184c6",_X,_NewY,_NewZ_B,_DallisDualHammer_B)
		THEN
		DB_DallisDefeatedItemDrop(_DallisDualHammer_A);
		DB_DallisDefeatedItemDrop(_DallisDualHammer_B);
		ProcIncreaseCounter("GLO_DallisDefeatedCounter");
		
		//Second Kill
		PROC
		Proc_DallisLootInstantiate()
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",1)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region != "ARX_EndGame"
		THEN
		DB_DallisLootInstantiate_QueueEquipmentTransform("UNI_Dallis_Stage3");
		
		PROC
		Proc_DallisLootInstantiate()
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",1)
		AND
		GetPosition(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_X,_Y,_Z)
		AND
		RealSum(_Y,0.5,_NewY)
		AND
		RealSum(_Z,1.0,_NewZ_A)
		AND
		RealSubtract(_Z,1.0,_NewZ_B)
		AND
		CreateItemTemplateAtPosition("UNI_Dallis_Stage2_Hammer_0ed20f88-6b3e-44eb-bef8-b340dbf816c6",_X,_NewY,_NewZ_A,_Dallis1hHammer)
		AND
		CreateItemTemplateAtPosition("UNI_Dallis_Stage2_Shield_14983d61-a34d-46ff-8300-ad4a2f54246e",_X,_NewY,_NewZ_B,_Shield)
		THEN
		DB_DallisDefeatedItemDrop(_Dallis1hHammer);
		DB_DallisDefeatedItemDrop(_Shield);
		ProcIncreaseCounter("GLO_DallisDefeatedCounter");
		
		//First Kill
		PROC
		Proc_DallisLootInstantiate()
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",0)
		AND
		GetRegion(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		_Region != "ARX_EndGame"
		THEN
		DB_DallisLootInstantiate_QueueEquipmentTransform("UNI_Dallis_Stage2");
		
		PROC
		Proc_DallisLootInstantiate()
		AND
		DB_GlobalCounter("GLO_DallisDefeatedCounter",0)
		AND
		GetPosition(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_X,_Y,_Z)
		AND
		RealSum(_Y,0.5,_NewY)
		AND
		CreateItemTemplateAtPosition("QUEST_Dallis_WPN_Hammer_cfc41e62-faf6-48ac-8ac6-91eb4ede70fc",_X,_NewY,_Z,_DallisHammer)
		THEN
		DB_DallisDefeatedItemDrop(_DallisHammer);
		ProcIncreaseCounter("GLO_DallisDefeatedCounter");
		
		IF
		CharacterEnteredRegion(S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_Region)
		AND
		DB_DallisLootInstantiate_QueueEquipmentTransform(_EquipmentSet)
		THEN
		CharacterTransformAppearanceToWithEquipmentSet(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,_EquipmentSet,0);
		NOT DB_DallisLootInstantiate_QueueEquipmentTransform(_EquipmentSet);
		
		//END_REGION
		
		//REGION Dallis Transformation
		
		
		PROC
		Proc_DallisTransformAndLeave()
		THEN
		CharacterLaunchIteratorAroundObject(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,10.0,"DallisDragonFormKnockdown");
		
		
		PROC
		Proc_DallisTransformAndLeave()
		THEN
		PlayAnimation(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"cast_ground_start","FTJ_DallisDragonFormLeave");
		
		IF
		StoryEvent(_Char,"FTJ_DallisDragonFormLeave")
		THEN
		PlayAnimation(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"transform_and_fly","GEN_GoOffStage");
		TeleportTo(ITEMGUID_S_GLO_DallisDragonFormLeave_DragonSoundHelper_592ebc35-693f-44c0-872e-5ccc6a3bbd05,CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572);
		PlaySound(ITEMGUID_S_GLO_DallisDragonFormLeave_DragonSoundHelper_592ebc35-693f-44c0-872e-5ccc6a3bbd05,"Creatures_Dragon_ABC_Custom_Transform_From_Lizard_And_Fly_Out_01");
		
		/*
		IF
		StoryEvent(_Char,"FTJ_DallisDragonFormLeave_01")
		THEN
		PlayAnimation(_Char,"transform_and_fly","GEN_GoOffStage");
		*/
		
		IF
		StoryEvent((CHARACTERGUID)_Char,"DallisDragonFormKnockdown")
		AND
		_Char != NULL_00000000-0000-0000-0000-000000000000
		AND 
		_Char != CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572
		THEN
		ApplyStatus(_Char,"KNOCKED_DOWN",1.0,-1);
		Proc_ShakeCameraForTime(_Char,5000);
		
		IF
		StoryEvent(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"GEN_GoOffStage")
		THEN
		SetStoryEvent(CHARACTERGUID_S_GLO_Dallis_69b951dc-55a4-44b8-a2d5-5efedbd7d572,"ResetDragonForm");
		
		
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(292).Title("GLO_DeadOrder");
Goal(292)
{
	INIT
	{
		// Public interface:
		//  * DB_GLO_DeadOrder_ID("YourUniqueIdentifier")
		//
		//    Define if you are interested in keeping track of the order in which players die.
		//
		//  * PROC_GLO_DeadOrder_CharacterReset((CHARACTERGUID)_Player,(STRING)_Identifier)
		//
		//    Call to clear the recorded dead order of a particular character
		//
		//  * QRY_GLO_DeadOrder_Elegible((CHARACTERGUID)_Char,"YourUniqueIdentifier")
		//
		//    Called to determine whether a particular character that died is elegible for
		//    your purpose (it won't keep track of dead players for which this query fails).
		//
		//  * QRY_GLO_DeadOrder_LastStandingElegibleForUser((INTEGER)_UserID,"YourUniqueIdentifier")
		//
		//    Call to get the last standing (last died) character of the user with ID _UserID that
		//    corresponds to your criteria as defined by your QRY_GLO_DeadOrder_Elegible(). If there
		//    is any such character, it will be returned as
		//    DB_GLO_DeadOrder_LastStandingElegibleForUser(_UserID,_Char,"YourUniqueIdentifier").
		//
		//    Note that since _UserID may be invalid in the next frame, this result must be
		//    consumed immediately. If no character was found, the query will return false and no
		//    DB_GLO_DeadOrder_LastStandingElegibleForUser(_UserID,_Char,"YourUniqueIdentifier")
		//    will be set after it returns
		//
		//    To know when to call this routine for a particular UserID, register for events from
		//    from the GLO_AllDead goal.
		
	}
	KB
	{
		IF
		DB_GLO_DeadOrder_ID((STRING)_Identifier)
		AND
		StringConcatenate("GLO_DeadOrder_EligibleDeadOrder_",_Identifier,_CounterName)
		THEN
		ProcDeclareCounter(_CounterName);
		
		// Make signature of QRY_GLO_DeadOrder_Eligible known
		QRY
		QRY_GLO_DeadOrder_Eligible((CHARACTERGUID)_Char,"DummyForCompileTime")
		THEN
		DB_NOOP(1);
		
		//REGION Return the last standing avatar for the specified user (if any)
		// We only check the user when actually requesting the last killed avatar,
		// as UserIDs can change at any time due to disconnects etc
		// Interface: 
		//    QRY_GLO_DeadOrder_LastStandingEligibleForUser((INTEGER)_UserID,(STRING)_Identifier)
		//      result: returns false if none, sets DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_Avatar,_Identifier) if one
		
		QRY
		QRY_GLO_DeadOrder_LastStandingEligibleForUser((INTEGER)_UserID,(STRING)_Identifier)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_GLO_DeadOrder_EligibleDeadOrder(_Player,(INTEGER)_Order,_Identifier)
		AND
		// Use temporary variable to work around Osiris compiler bug (DOSTWO-10671)
		CharacterGetReservedUserID(_Player,_Temp)
		AND
		_Temp == _UserID
		THEN
		PROC_GLO_DeadOrder_SetLastStandingEligibleForUser(_UserID,_Order,_Player,_Identifier);
		
		// Remove remnant from previous invocation, if any
		PROC
		PROC_GLO_DeadOrder_SetLastStandingEligibleForUser((INTEGER)_UserID,(INTEGER)_Order,(CHARACTERGUID)_Player,(STRING)_Identifier)
		AND
		DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_PreviousPlayer,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_PreviousPlayer,_Identifier);
		
		// Initially found result
		PROC
		PROC_GLO_DeadOrder_SetLastStandingEligibleForUser((INTEGER)_UserID,(INTEGER)_Order,(CHARACTERGUID)_Player,(STRING)_Identifier)
		THEN
		DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_Order,_Identifier);
		DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_Player,_Identifier);
		
		// Look for better result
		PROC
		PROC_GLO_DeadOrder_SetLastStandingEligibleForUser((INTEGER)_UserID,(INTEGER)_Order,(CHARACTERGUID)_Player,(STRING)_Identifier)
		AND
		DB_GLO_DeadOrder_EligibleDeadOrder(_NewPlayer,_NewOrder,_Identifier)
		AND
		DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_CurrentOrder,_Identifier)
		AND
		_NewOrder > _CurrentOrder
		AND
		CharacterGetReservedUserID(_NewPlayer,_UserID)
		AND
		DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_CurrentPlayer,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_CurrentPlayer,_Identifier);
		NOT DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_CurrentOrder,_Identifier);
		DB_GLO_DeadOrder_LastStandingEligibleForUser(_UserID,_NewPlayer,_Identifier);
		DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_NewOrder,_Identifier);
		
		PROC
		PROC_GLO_DeadOrder_SetLastStandingEligibleForUser((INTEGER)_UserID,(INTEGER)_Order,(CHARACTERGUID)_Player,(STRING)_Identifier)
		AND
		DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_NewOrder,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_LastStandingEligibleOrderForUser(_UserID,_NewOrder,_Identifier);
		//END_REGION //Return the last standing avatar for the specified user (if any)
		
		//REGION Remove resurrected characters that had been recorded
		IF
		CharacterResurrected(_Player)
		AND
		DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_DeadOrder,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_DeadOrder,_Identifier);
		//END_REGION //Record Eligible characters (avatars and undead companions)
		
		//REGION External clearing of dead order for characters
		PROC
		PROC_GLO_DeadOrder_CharacterReset((CHARACTERGUID)_Player,(STRING)_Identifier)
		AND
		DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_DeadOrder,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_DeadOrder,_Identifier);
		//END_REGION
		
		//REGION Reset Eligible order counter when all avatars are alive, to avoid eventually overflowing the counter
		IF
		CharacterResurrected(_Player)
		AND
		DB_GLO_DeadOrder_ID(_Identifier)
		AND
		NOT DB_GLO_DeadOrder_EligibleDeadOrder(_,_,_Identifier)
		AND
		StringConcatenate("GLO_DeadOrder_EligibleDeadOrder_",_Identifier,_CounterName)
		THEN
		ProcDeclareCounter(_CounterName);
		PROC_GLO_DeadOrder_ResetEligibleDeadOrderDB(_Identifier);
		
		QRY
		QRY_GLO_DeadOrder_AnyEligibleDead((STRING)_Identifier)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_Dead(_Player)
		AND
		QRY_GLO_DeadOrder_Eligible(_Player,_Identifier)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GLO_DeadOrder_ResetEligibleDeadOrderDB((STRING)_Identifier)
		AND
		DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_Order,_Identifier)
		THEN
		NOT DB_GLO_DeadOrder_EligibleDeadOrder(_Player,_Order,_Identifier);
		//END_REGION //Reset Eligible order counter when all avatars are alive, to avoid eventually overflowing the counter
		
	}
	EXIT
	{
		
	}
}
Goal(293).Title("GLO_DialogSkillCheck");
Goal(293)
{
	INIT
	{
		//DB_CanUseSkillCheck(_Dialog,_Skill,_SourcePointCost)
		//Flag is created by StringConcatenate("PlayerCanUse_",_Skill,_Flag)
		//For Example : Bless would be PlayerCanUse_TargetBless
		
	}
	KB
	{
		//Can Use Skill Checks (For Dialog)
		
		IF
		DialogStarted(_Dialog,_Id)
		AND
		DB_CanUseSkillCheck(_Dialog,_Skill,_SourceCost)
		AND
		DialogGetInvolvedPlayer(_Id,1,(CHARACTERGUID)_Player)
		AND
		CharacterHasSkill(_Player,_Skill,1)
		AND
		_SourceCost > 0
		AND
		HasActiveStatus(_Player,"SOURCE_MUTED",0)
		AND
		CharacterGetSourcePoints(_Player,_Int)
		AND
		_Int >= _SourceCost
		THEN
		Proc_CanUseSkillCheck_FlagSetUp(_Player,_Skill,_Dialog);
		
		IF
		DialogStarted(_Dialog,_Id)
		AND
		DB_CanUseSkillCheck(_Dialog,_Skill,_SourceCost)
		AND
		DialogGetInvolvedPlayer(_Id,1,(CHARACTERGUID)_Player)
		AND
		CharacterHasSkill(_Player,_Skill,1)
		AND
		_SourceCost == 0
		THEN
		Proc_CanUseSkillCheck_FlagSetUp(_Player,_Skill,_Dialog);
		
		//Set Up and Store the Flag
		PROC
		Proc_CanUseSkillCheck_FlagSetUp((CHARACTERGUID)_Player,(STRING)_Skill,(STRING)_Dialog)
		AND
		StringConcatenate("PlayerCanUse_",_Skill,_Flag)
		THEN
		ObjectSetFlag(_Player,_Flag);
		DB_CanUseSkillCheck_FlagRemover(_Player,_Dialog,_Flag);
		
		IF
		DialogEnded(_Dialog,_Id)
		AND
		DialogGetInvolvedPlayer(_Id,1,(CHARACTERGUID)_Player)
		AND
		DB_CanUseSkillCheck_FlagRemover(_Player,_Dialog,_Flag)
		THEN
		ObjectClearFlag(_Player,_Flag);
		
		
		
	}
	EXIT
	{
		
	}
}
Goal(294).Title("GLO_Divinity_Origins");
Goal(294)
{
	INIT
	{
		DB_Origins_InitialRegion("FJ_FortJoy_Main");
		
		DB_OriginRecruitmentDialog((CHARACTERGUID)CHARACTERGUID_S_Player_Sebille_c8d55eaf-e4eb-466a-8f0d-6a9447b5b24c,"Sebille_Recruitment");
		DB_OriginRecruitmentDialog(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295,"Lohse_Recruitment");
		DB_OriginRecruitmentDialog(CHARACTERGUID_S_Player_RedPrince_a26a1efb-cdc8-4cf3-a7b2-b2f9544add6f,"RedPrince_Recruitment");
		DB_OriginRecruitmentDialog(CHARACTERGUID_S_Player_Ifan_ad9a3327-4456-42a7-9bf4-7ad60cc9e54f,"Ifan_Recruitment");
