		ObjectFlagSet("Debug_CoS_DarkNightOfTheSoul",_Player,_)
		AND
		DB_OriginRecruitmentLocation_Region(_,_Char,_,_)
		AND
		NOT DB_IsPlayer(_Char)
		THEN
		ObjectClearFlag(_Char,"CoS_CompanionReJoinAvatar");
		DB_CoS_AotO_Competitors(_Char);
		CharacterDie(_Char,0,"DoT");
		// The body has to be in CoS_Ending for the ghost to show up
		TeleportTo(_Char,TRIGGERGUID_S_CoS_AotO_SpawnPoint_Player_001_b35a1fb2-9c3a-40f8-a687-22f776eba5a1);
		
		IF
		ObjectFlagSet("Debug_CoS_DarkNightOfTheSoul",(CHARACTERGUID)_Player,_)
		THEN
		ObjectClearFlag(_Player,"Debug_CoS_DarkNightOfTheSoul");
		GlobalSetFlag("CoS_AfterArenaOfTheOne");
		DB_CoS_AfterArenaOfTheOne(1);
		PartySetFlag(_Player,"QuestUpdate_CoS_ArenaOfTheOne_End");
		CharacterTeleportPartiesToTrigger(TRIGGERGUID_S_CoS_LV_HoE_RegionStart_fda0f33f-8438-4057-bdff-5b3c945bdb20,"");
		
		//END_REGION
		
		
		//REGION Endgame
		PROC
		PROC_Debug_FixateCompanions()
		AND
		DB_CompanionAvatarBond(_Companion,_Avatar)
		AND
		DB_Companion_FixatedFlag(_Companion,_Flag)
		THEN
		ObjectSetFlag(_Avatar,_Flag);
		
		IF
		GlobalFlagSet("EG_Debug_AddJahan")
		THEN
		DB_EG_BoatNPCs((CHARACTERGUID)CHARACTERGUID_S_GLO_Jahan_4d222cfd-49c8-41d3-8cb7-2a2b56232633,"EG_Epilogue_Jahan",TRIGGERGUID_S_EG_Epilogue_JahanPoint_5f94b39d-2929-4651-8989-ebac328b9609);
		
		IF
		ObjectFlagSet("EG_ToStairs",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_ToStairs");
		CharacterTeleportPartiesToTrigger(TRIGGERGUID_S_ARX_Crypt_LastAutosave_655f136f-a25d-4329-8ee7-5adee39dba2d,"");
		PROC_Debug_FixateCompanions();
		
		IF
		ObjectFlagSet("EG_ToEndgameStart",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_ToEndgameStart");
		CharacterTeleportPartiesToTrigger(TRIGGERGUID_S_ARX_EndGame_Enter_bd166e2a-7623-490e-94df-78079e7cbacc,"");
		PROC_Debug_FixateCompanions();
		
		IF
		ObjectFlagSet("EG_ToEpilogue",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_ToEpilogue");
		CharacterTeleportPartiesToTrigger(TRIGGERGUID_S_EG_LV_PlayerArrivalTrigger_f0f200ee-ac5f-4ae7-9422-714a8a779365,"Debug_EG_ToEpilogue");
		PROC_Debug_FixateCompanions();
		
		IF
		GlobalFlagSet("EG_ResetCompanions")
		THEN
		GlobalClearFlag("EG_ResetCompanions");
		DB_OriginInPartyDialog((CHARACTERGUID)CHARACTERGUID_S_Player_RedPrince_a26a1efb-cdc8-4cf3-a7b2-b2f9544add6f,"RedPrince");
		DB_OriginInPartyDialog(CHARACTERGUID_S_Player_Sebille_c8d55eaf-e4eb-466a-8f0d-6a9447b5b24c,"Sebille");
		DB_OriginInPartyDialog(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295,"Lohse");
		DB_OriginInPartyDialog(CHARACTERGUID_S_Player_Ifan_ad9a3327-4456-42a7-9bf4-7ad60cc9e54f,"Ifan");
		DB_OriginInPartyDialog(CHARACTERGUID_S_Player_Beast_f25ca124-a4d2-427b-af62-df66df41a978,"Beast");
		DB_OriginInPartyDialog(CHARACTERGUID_S_Player_Fane_02a77f1f-872b-49ca-91ab-32098c443beb,"Fane");
		
		IF
		StoryEvent(_,"Debug_EG_ToEpilogue")
		THEN
		PROC_EG_Epilogue_Start();
		
		IF
		ObjectFlagSet("EG_Debug_Gareth_Alive",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_Debug_Gareth_Alive");
		CharacterResurrect(CHARACTERGUID_S_FTJ_SW_Warrior_SeekerCaptain_1329f018-23e4-4717-9bc8-074b28d04c54);
		GlobalSetFlag("CoS_GarethRevenge_Resolution_Peaceful");
		
		IF
		ObjectFlagSet("EG_Debug_Gareth_Dead",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_Debug_Gareth_Dead");
		CharacterDie(CHARACTERGUID_S_FTJ_SW_Warrior_SeekerCaptain_1329f018-23e4-4717-9bc8-074b28d04c54,0,"");
		
		IF
		ObjectFlagSet("EG_Debug_Malady_Alive",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_Debug_Malady_Alive");
		CharacterResurrect(CHARACTERGUID_S_GLO_River_f4931ebe-10b0-43c4-9182-640cf052717e);
		
		IF
		ObjectFlagSet("EG_Debug_Malady_Dead",_Player,_)
		THEN
		ObjectClearFlag(_Player,"EG_Debug_Malady_Dead");
		CharacterSetImmortal(CHARACTERGUID_S_GLO_River_f4931ebe-10b0-43c4-9182-640cf052717e,0);
		CharacterDie(CHARACTERGUID_S_GLO_River_f4931ebe-10b0-43c4-9182-640cf052717e,0,"");
		
		IF
		ObjectFlagSet("EG_Debug_Tarquin_Alive",_Player,_)
		THEN
