Goal(377).Title("RC_BI_Druid");
Goal(377)
{
	INIT
	{
		DB_Ghosts(CHARACTERGUID_S_RC_BI_Druid_121a1be4-24af-4e4e-ae9f-c679b2982e50, S_RC_BI_Druid_Ghost_702eda68-de52-47ee-bdba-b763c2053322,"RC_BI_Druid_Ghost");
		 
		DB_ShovelArea(TRIGGERGUID_S_RC_BI_DruidSecret_Area_d076dcf7-957e-4fe7-8c4b-1cdff937caf4,"RC_BI_DruidSecret",ITEMGUID_S_RC_BI_DruidSecret_Pile_3f88bd4b-2c38-4c6d-8ff5-506818369250);
		DB_ShovelRewardItemAppear("RC_BI_DruidSecret",ITEMGUID_S_RC_BI_DruidSecret_Package_5c96cc52-c332-40e3-b7fd-0838b68c803d,TRIGGERGUID_S_RC_BI_DruidSecret_Point_4749d42d-4a10-484f-8dd7-42ed591428dd);
		
		CharacterSetAnimationOverride(S_RC_BI_Druid_Ghost_702eda68-de52-47ee-bdba-b763c2053322,"Insane_01_Loop");
		
	}
	KB
	{
		IF
		GameBookInterfaceClosed(ITEMGUID_S_RC_BI_Archive_Document_Sourcerer_30534651-6c6d-492e-bd45-aadb5e830100,_Player)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_BI_Druid_ArchiveInfo");
		
		IF
		ObjectFlagSet("QuestUpdate_RC_BI_Druid_Rewarded",(CHARACTERGUID)_Player,_)
		THEN
		AddSecret(_Player,"RC_BI_DruidsSecret");
		
		PROC
		Proc_RC_BI_BlackRingKilled()
		THEN
		ObjectSetFlag(S_RC_BI_Druid_Ghost_702eda68-de52-47ee-bdba-b763c2053322,"RC_BI_BlackRingKilled");
		CharacterSetAnimationOverride(S_RC_BI_Druid_Ghost_702eda68-de52-47ee-bdba-b763c2053322,"");
		CharacterMoveTo(S_RC_BI_Druid_Ghost_702eda68-de52-47ee-bdba-b763c2053322,TRIGGERGUID_S_RC_BI_DruidPoint_e22e7f2b-2c7a-40dd-b8ce-dd9262f16817,0,"",0);
		
		PROC
		ProcShovelRewards(_,"RC_BI_DruidSecret")
		AND
		DB_IsPlayer(_Player)
		THEN
		ProcHideMarker((CHARACTERGUID)_Player,"RC_BI_DruidsSecretStuff");
		
	}
	EXIT
	{
		
	}
}
Goal(378).Title("RC_BI_GibberishTreeEncounter");
Goal(378)
{
	INIT
	{
		DB_BI_AncestorTree_Wizard((CHARACTERGUID)S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d);
		DB_BI_AncestorTree_Wizard(S_RC_BI_AncestorTree_Blackring_002_ce4b11ce-0f4b-487b-a67c-4123134e1b8b);
		DB_BI_AncestorTree_Wizard(S_RC_BI_AncestorTree_Blackring_003_ec71afef-c81f-4c56-b81d-7bc73958478d);
		DB_BI_AncestorTree_Wizard(S_RC_BI_AncestorTree_Blackring_004_f1ca4587-d0e9-415c-a0c9-c0dd0a992748);
		
		DB_Ghosts(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d,CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_Ghost_2da07e30-5fd8-4282-a001-f107bc997e67,"RC_BI_AncestorTree_Blackring_Ghost");
		
		ProcTriggerRegisterForPlayers(S_RC_BI_AncestorTree_Area_f3e22261-796e-4052-a2b2-8208373648db);
		DB_TrespassTrigger(TRIGGERGUID_S_RC_BI_AncestorTree_Platfom_Area_db5dd411-306d-415c-a9c7-62f7b789fdbf,NULL_00000000-0000-0000-0000-000000000000,"RC_BI_TrespassCrime");
		
		DB_BI_AncestorTree_Enemy_BlackRing((CHARACTERGUID)CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d);
		DB_BI_AncestorTree_Enemy_BlackRing(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_002_ce4b11ce-0f4b-487b-a67c-4123134e1b8b);
		DB_BI_AncestorTree_Enemy_BlackRing(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_003_ec71afef-c81f-4c56-b81d-7bc73958478d);
		DB_BI_AncestorTree_Enemy_BlackRing(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_004_f1ca4587-d0e9-415c-a0c9-c0dd0a992748);
		DB_BI_AncestorTree_Enemy_BlackRing(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531);
		
	}
	KB
	{
		IF
		DB_BI_AncestorTree_Enemy_BlackRing(_BlackRing)
		THEN
		DB_DontCreateMurder(_BlackRing);
		
		IF
		CharacterEnteredTrigger(_PLayer,TRIGGERGUID_S_RC_BI_BloodIslandRegion_9c0a84b1-314c-4262-b33b-26cfcdfc10ee)
		AND
		DB_IsPlayer(_Player)
		AND
		QueryOnlyOnce("RC_BI_AncestorTreePromised")
		THEN
		PROC_LoopEffect("RS3_FX_GP_ScriptedEvent_Resurrection_01",CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531,"RC_BI_AncestorTreePromised","RC_Main","");
		
		IF 
		GameBookInterfaceClosed(ITEMGUID_S_RC_BI_AncestorTree_Letter_6d1c5c28-5815-436d-8332-8cd60a93ef9b,_Player)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_RC_BI_TheTruth_BlackringLetter");
		
		IF
		CharacterCharacterEvent(_Blackring,_Player,"RC_BI_AncestorTree_BlackringTalk")
		AND
		DB_IsPlayer(_Player)
		AND
		UserGetFlag(_Player,"RC_BI_AncestorTree_SawBlackring",0)
		THEN
		Proc_StartDialog(0,"RC_BI_AncestorTree_Blackring_Warning",S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d,_Player);
		UserSetFlag(_Player,"RC_BI_AncestorTree_SawBlackring");
		
		IF
		DialogStarted("RC_BI_AncestorTree_Blackring_Warning",_)
		AND
		DB_BI_AncestorTree_Wizard(_Wizard)
		THEN
		CharacterSetReactionPriority(_Wizard,"TortureCall",0);
		Proc_RC_BI_AncestorTree_StopRitual();
		
		IF
		DialogRequestFailed("RC_BI_AncestorTree_Blackring_Warning",_)
		THEN
		CharacterSetRelationFactionToFaction("RC_BI_AncestorTree_Blackring","Hero",0);
		CharacterSetRelationFactionToFaction("Hero","RC_BI_AncestorTree_Blackring",0);
		Proc_RC_BI_AncestorTree_StopRitual();
		
		IF
		DialogEnded("RC_BI_AncestorTree_Blackring_Warning",_)
		AND
		DB_BI_AncestorTree_Wizard(_Wizard)
		THEN
		CharacterSetReactionPriority(_Wizard,"TortureCall",800);
		
		IF
		ObjectEnteredCombat((CHARACTERGUID)_Ring,_ID)
		AND
		DB_BI_AncestorTree_Wizard(_Ring)
		AND
		QueryOnlyOnce("RC_BI_GibberishTreeFight")
		THEN
		DialogRequestStop(S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d);
		CharacterResurrect(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531);
		DB_BI_AncestorTree_Enemy_BlackRing(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531);
		CharacterSetCustomName(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531,"RC_BlackRingDestroyer_Undead");
		
		IF
		CharacterResurrected(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531)
		THEN
		ApplyStatus(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531,"QUEST_PROMISE",-1.0,1);
		PROC_StopLoopEffect(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531,"RC_BI_AncestorTreePromised");
		PlayEffect(CHARACTERGUID_S_RC_BI_AncestorTree_Blackring_005_ffaeae79-c8c7-422b-be80-c0190836b531,"RS3_FX_GP_ScriptedEvent_Replenish_SourcePoint_01");
		
		//REGION Ritual Interruption
		IF
		CharacterOnCrimeSensibleActionNotification(_Wizard,_,_CrimeID,_,_,_,_,_,_,_)
		AND
		CrimeGetType(_CrimeID, "RC_BI_TrespassCrime")
		AND
		DB_BI_AncestorTree_Wizard(_Wizard)
		THEN
		Proc_RC_BI_AncestorTree_StopRitual();
		
		PROC
		Proc_RC_BI_AncestorTree_StopRitual()
		AND
		DB_BI_AncestorTree_Wizard(_BlackRing)
		THEN
		ClearScriptframe(_BlackRing);
		
		IF
		ObjectFlagSet("RC_BI_AncestorTree_BlackRingHostile",(CHARACTERGUID)_Player,_)
		THEN
		CharacterSetRelationFactionToFaction("RC_BI_AncestorTree_Blackring","Hero",0);
		CharacterSetRelationFactionToFaction("Hero","RC_BI_AncestorTree_Blackring",0);
		
		IF
		AttackedByObject((CHARACTERGUID)_Character,(CHARACTERGUID)_Player,_,_,_)
		AND
		DB_BI_AncestorTree_Wizard(_Character)
		AND
		DB_IsPlayer(_Player)
		THEN
		CharacterSetRelationFactionToFaction("RC_BI_AncestorTree_Blackring","Hero",0);
		CharacterSetRelationFactionToFaction("Hero","RC_BI_AncestorTree_Blackring",0);
		
		IF
		CharacterDied(_Character)
		AND
		DB_BI_AncestorTree_Enemy_BlackRing(_Character)
		THEN
		NOT DB_BI_AncestorTree_Enemy_BlackRing(_Character);
		Proc_RC_BI_CheckEnemyBlackRingAreDead();
		
		PROC
		Proc_RC_BI_CheckEnemyBlackRingAreDead()
		AND
		QRY_IsEmptyDB("DB_BI_AncestorTree_Enemy_BlackRing",1)
		THEN
		GlobalSetFlag("RC_BI_EnemyBlackRingAreDead");
		Proc_RC_BI_BlackRingKilled();
		
		IF
		CharacterDied(_Character)
		AND
		DB_BI_AncestorTree_Wizard(_Character)
		AND
		QueryOnlyOnce("RC_BI_AncestorTree_RitualInterrupted")
		THEN
		SetRelationFactionToPlayers("RC_BI_AncestorTree_Blackring",0);
		CharacterSetReactionPriority(S_RC_BI_AncestorTree_Blackring_001_5c413561-15bf-4cd7-8db6-f69df9bf978d,"TortureCall",0);
		Proc_RC_BI_AncestorTree_StopRitual();
		
		//END_REGION
		
		IF
		RegionEnded("RC_Main")
		THEN
		GoalCompleted;
		
		
	}
	EXIT
	{
		ProcTriggerUnregisterForPlayers(S_RC_BI_AncestorTree_Area_f3e22261-796e-4052-a2b2-8208373648db);
		ProcTriggerUnregisterForPlayers(S_RC_BI_AncestorTree_Platfom_Area_db5dd411-306d-415c-a9c7-62f7b789fdbf);
		
	}
}
Goal(379).Title("RC_BI_MassGrave");
Goal(379)
{
	INIT
	{
		// QDD Link: https://sites.google.com/a/larian.com/larian-wikisite/home/quest-design-documentation/blood-island---the-mass-grave
		// Narrative Link: https://docs.google.com/document/d/1xsM00fv_ORRPTd2eulCJW6uR4kxkcwuGVnR93L0pKzY/edit#bookmark=id.4cfrapxs8303
		// Flowchart Link: https://www.lucidchart.com/documents/edit/aee81536-fda9-48c1-aae5-1d2b0be95dfd
		// Review Link: http://www.google.com/url?q=http%3A%2F%2Fgojira%3A8082%2Fbrowse%2FDOSTWO-12765&sa=D&sntz=1&usg=AFQjCNHBLphiRGM74l6Od9YPmp01uKJ5gg
		
		DB_Ghosts(S_RC_BI_MassGrave_Priest_6e24d7d2-396e-4459-9987-df2d4b2cf427,"RC_BI_MassGrave_Ghost"); 
		
		DB_RC_BI_MassGrave((ITEMGUID)S_RC_BI_MassGrave_Pile_20_ed54a0f5-32fa-4827-96d2-caa8c6d23a78,"RC_BI_MassGrave_Corpse_1");
		DB_RC_BI_MassGrave(S_RC_BI_MassGrave_Pile_21_bbfac810-a6f9-4ffc-a8f0-3842cad03107,"RC_BI_MassGrave_Corpse_2");
		DB_RC_BI_MassGrave(S_RC_BI_MassGrave_Pile_01_edc39683-b309-4aab-9313-ac0c5414022d,"RC_BI_MassGrave_Corpse_3");
		
		ProcTriggerRegisterForPlayers(TRIGGERGUID_S_RC_BI_MassGrave_Area_971ea0b3-12a5-49a5-aa3c-4f267c0a992a);
		
		
		
	}
	KB
	{
		IF
		CharacterEnteredTrigger(_Player,TRIGGERGUID_S_RC_BI_MassGrave_Area_971ea0b3-12a5-49a5-aa3c-4f267c0a992a)
		AND
		UserGetFlag(_Player,"RC_BI_MassGraveDiscovered",0)
		THEN
		UserSetFlag(_Player,"RC_BI_MassGraveDiscovered");
		StartVoiceBark("RC_BI_VB_MassGrave",_Player);
		
		IF
		CharacterUsedItem(_Player,_Pile)
		AND
		DB_RC_BI_MassGrave(_Pile,_Dialogue)
		THEN
		Proc_StartDialog(0,_Dialogue,_Pile,_Player);
		
	}
	EXIT
	{
		
	}
}
Goal(380).Title("RC_BI_SourceBridge");
Goal(380)
{
	INIT
	{
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_000_de6955bb-a6bd-4b52-b564-bf61fe67357a);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_001_03de49c6-5d68-4cc4-9e60-d33791b05dc6);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_002_f627ed89-58d0-4013-8375-0f9f64ed3d61);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_003_4aa076b9-d014-43ac-b0dc-1cb127b78b83);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_004_3bb07a9b-2d5a-488a-be2f-4d8ead14dcb2);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_005_e91228e8-8737-46de-bad3-d31e1e995a8e);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_006_30e03fb0-1559-4149-8230-9339f981d750);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_007_51682a61-0263-44f8-84cb-acb014252837);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_008_32a62e6f-daae-4cc1-9de2-9e01bd768996);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_009_ec96ceb5-8440-4f6a-89ea-d04e93bcab7f);
		DB_BI_SourceBridge(ITEMGUID_S_RC_BI_SourceBridge_Platform_010_dd8db5dc-69d9-4387-8d5e-b720814276ed);
		
		ProcTriggerRegisterForPlayers(TRIGGERGUID_S_RC_BI_SourceBridge_Area_7fd4e4e7-0719-4ae0-8d07-7b09d50963a3);
		DB_RC_BI_ArrivedIsland_VB_Triggers((TRIGGERGUID)TRIGGERGUID_S_RC_BI_VB_ArrivedIsland_2415c7bf-a5a5-46d1-9e96-b8bd81138308);
		DB_RC_BI_ArrivedIsland_VB_Triggers(TRIGGERGUID_S_RC_BI_VB_ArrivedIsland_Boat_dadbb8f9-04a9-45ae-9c10-217d508e48cc);
		
		DB_RC_BI_SourceTraps(ITEMGUID_S_RC_BI_SourceBridge_PressurePlate_2_6832c548-f653-4715-a412-4535d0594e56);
		DB_RC_BI_SourceTraps(IITEMGUID_S_RC_BI_SourceBridge_PressurePlate_008_fe3acef8-2f56-40a6-9279-5190969e951e);
		DB_RC_BI_SourceTraps(ITEMGUID_S_RC_BI_SourceBridge_PressurePlate_006_0e664546-437e-4a01-961c-c83bf7b2b78c);
		DB_RC_BI_SourceTraps(ITEMGUID_S_RC_BI_SourceBridge_PressurePlate_007_b0cce9a2-71cf-40e0-bf42-c4b6f701c062);
		
	}
	KB
	{
		IF
		ItemGhostRevealed(_Item)
		AND
		DB_BI_SourceBridge(_Item)
		AND
		GetClosestAlivePlayer(_Item,_Player,_Dist)
		AND
		_Dist < 20.0
		AND
		GlobalGetFlag("RC_BI_BridgeRevealed",0)
		THEN
		StartVoiceBark("RC_BI_VB_SawSourceBridge",_Player);
		UserSetFlag(_Player,"RC_BI_VB_SawSourceBridge");
		GlobalSetFlag("RC_BI_BridgeRevealed");
		
		IF
		ItemGhostRevealed(_Item)
		AND
		DB_BI_SourceBridge(_Item)
		THEN
		ObjectSetFlag(_Item,"RC_BI_RevealedPlatform");
		
		IF
		DB_RC_BI_ArrivedIsland_VB_Triggers(_Trigger)
		THEN
		ProcTriggerRegisterForPlayers(_Trigger);
		
		IF
		CharacterEnteredTrigger(_Player,TRIGGERGUID_S_RC_BI_SourceBridge_Area_7fd4e4e7-0719-4ae0-8d07-7b09d50963a3)
		AND
		GlobalGetFlag("RC_BI_BridgeRevealed",0)
		AND
		UserGetFlag(_Player,"RC_BI_VB_SawBrokenBridge",0)
		THEN
		UserSetFlag(_Player,"RC_BI_VB_SawBrokenBridge");
		StartVoiceBark("RC_BI_VB_BrokenBridge",_Player);
		
		IF
		CharacterEnteredTrigger(_Player,TRIGGERGUID_S_RC_BI_SourceBridge_Area_7fd4e4e7-0719-4ae0-8d07-7b09d50963a3)
		AND
		GlobalGetFlag("RC_BI_BridgeRevealed",1)
		AND
		UserGetFlag(_Player,"RC_BI_VB_SawSourceBridge",0)
		THEN
		StartVoiceBark("RC_BI_VB_SawSourceBridge",_Player);
		UserSetFlag(_Player,"RC_BI_VB_SawSourceBridge");
		GlobalSetFlag("RC_BI_BridgeRevealed");
		
		IF
		CharacterEnteredTrigger(_Player,_Trigger)
		AND
		DB_RC_BI_ArrivedIsland_VB_Triggers(_Trigger)
		AND
		UserGetFlag(_Player,"RC_BI_VB_CrossedBridge",0)
		THEN
		UserSetFlag(_Player,"RC_BI_VB_CrossedBridge");
		StartVoiceBark("RC_BI_VB_CrossedBridge",_Player); 
		
	}
	EXIT
	{
		
	}
}
