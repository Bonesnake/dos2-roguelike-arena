Goal(167).Title("CoS_ArenaOfTheOne");
Goal(167)
{
	INIT
	{
		DB_CheckLevelStart("CoS_Main_Ending");
		
	}
	KB
	{
		IF
		RegionStarted("CoS_Main_Ending")
		THEN
		GoalCompleted;
		
		IF
		DB_CheckLevelStart("CoS_Main_Ending")
		AND
		DB_CurrentLevel("CoS_Main_Ending")
		THEN
		GoalCompleted;
		
	}
	EXIT
	{
		
	}
}
