		AND
		DB_IsPlayer(_Char)
		AND
		ObjectGetFlag(_Char,"RC_DW_LovrikToldUsLivyInKitchen",1)
		AND
		GlobalGetFlag("RC_DW_Tavern_WaiterLivy_InitiateOutofSight",0)
		THEN
