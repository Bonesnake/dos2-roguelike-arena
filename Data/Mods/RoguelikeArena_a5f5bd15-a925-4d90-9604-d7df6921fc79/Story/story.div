	INIT
	{
		DB_ARX_DemonAmbush((CHARACTERGUID)CHARACTERGUID_S_ARX_DemonAmbush1_cfd1a537-df32-46fc-9878-2c4181fd3c14, "ARX_Demon1Spotted","ARX_DemonAmbush_Demon1Spotted");
