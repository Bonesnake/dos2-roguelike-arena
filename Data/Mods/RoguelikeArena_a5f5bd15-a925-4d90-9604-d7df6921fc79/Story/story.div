	}
}
Goal(540).Title("RoguelikeArena_Arena_AutoSave");
Goal(540)
{
	INIT
	{
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_ArenaStarted(_, _, _Difficulty, _)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_MaxDifficulty)
		AND
		IntegerDivide(_MaxDifficulty, 2, _MaxDifficultyHalved)
		AND
		IntegerSum(_MaxDifficultyHalved, 1, _TargetDifficulty)
		AND
		_Difficulty == _TargetDifficulty
		THEN
		AutoSave();
		
		PROC
		PROC_RoguelikeArena_ArenaStarted(_, _, _Difficulty, _)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_MaxDifficulty)
		AND
		_Difficulty == _MaxDifficulty
		THEN
		AutoSave();
		
	}
	EXIT
	{
		
	}
}
Goal(541).Title("RoguelikeArena_Arena_Battleground");
Goal(541)
{
	INIT
	{
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_StartBattleground((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		THEN
		DB_RoguelikeArena_Battleground(_Arena, _Level, _Difficulty, _Players);
		DB_Singleton("RoguelikeArena_SpawnAsAlly", 1);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		DB_Singleton("RoguelikeArena_SpawnAsAlly", 0);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		PROC_RoguelikeArena_SpawnEnemies(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_EnemySpawned(_Enemy, _Arena, _)
		AND
		DB_RoguelikeArena_Battleground(_Arena, _, _, _)
		AND
		DB_Singleton("RoguelikeArena_SpawnAsAlly", 1)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ALLY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		IntegertoString(_Arena, _ArenaString)
		AND
		StringConcatenate(_ArenaString, "-Ally", _CombatGroupID)
		THEN
		TeleportToPosition(_Enemy, _X, _Y, _Z, "", 0);
		SetFaction(_Enemy, "Good NPC"); // This doesn't always work for some reason
		SetCombatGroupID(_Enemy, _CombatGroupID);
		DB_RoguelikeArena_BattlegroundAllies(_Enemy);
		
		// Changes ally alignment if it previously failed.
		PROC
		PROC_RoguelikeArena_ArenaCombatRoundStarted(_Arena, _, _Round)
		AND
		_Round == 1
		AND
		DB_RoguelikeArena_BattlegroundAllies(_Ally)
		AND
		GetFaction(_Ally, "Evil NPC")
		THEN
		SetFaction(_Ally, "Good NPC");
		
		PROC
		PROC_RoguelikeArena_ArenaCombatRoundStarted(_Arena, _, _Round)
		AND
		DB_RoguelikeArena_BattlegroundAllies(_Ally)
		THEN
		NOT DB_RoguelikeArena_BattlegroundAllies(_Ally);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID)
		AND
		DB_RoguelikeArena_Battleground(_Arena, _, _, _)
		AND
		DB_RoguelikeArena_ArenaCharacters(_Arena, _Character)
		AND
		GetFaction(_Character, "Good NPC")
		AND
		CharacterIsDead(_Character, 0)
		THEN
		CharacterDie(_Character, 1, "Explode");
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnemiesDied(_Arena, _CombatID)
		AND
		DB_RoguelikeArena_Battleground(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_EndArenaCombat(_Arena, _CombatID);
		
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_Battleground(_Arena, _, _, _)
		THEN
		PROC_RoguelikeArena_BattlegroundEnded(_Arena);
		
		PROC
		PROC_RoguelikeArena_BattlegroundEnded((INTEGER)_Arena)
		AND
		DB_RoguelikeArena_Battleground(_Arena, _Level, _Difficulty, _Players)
		THEN
		NOT DB_RoguelikeArena_Battleground(_Arena, _Level, _Difficulty, _Players);
		
	}
	EXIT
	{
		
	}
}
Goal(542).Title("RoguelikeArena_Arena_BlessedStatues");
Goal(542)
{
	INIT
	{
		DB_RoguelikeArena_BlessedStatueTemplate("RoguelikeArena_BlessedStatue_5cd13db1-fb4b-4843-8aa3-5ba7da5a2d6c");
		
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceFireBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceOilBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfacePoisonBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceWaterBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceWaterElectrifiedBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceWaterFrozenBlessed");
		DB_RoguelikeArena_BlessedStatueSurfaceTypes("SurfaceWebBlessed");
		
		PROC_RoguelikeArena_StringPoolAddBlessedStatueSurfaceTypes();
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_SpawnBlessedStatues((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		QRY_RoguelikeArena_RandomCount(_Difficulty, 1, 3, 1)
		AND
		DB_RoguelikeArena_RandomResult(_BlessedStatueCount)
		THEN
		PROC_RoguelikeArena_SpawnBlessedStatues(_Arena, _Level, _Difficulty, _BlessedStatueCount);
		
		PROC
		PROC_RoguelikeArena_SpawnBlessedStatues((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Count)
		AND
		QRY_RoguelikeArena_CreateIndices(_Count)
		AND
		DB_RoguelikeArena_CreatedIndices(_)
		THEN
		PROC_RoguelikeArena_SpawnBlessedStatue(_Arena, _Level, _Difficulty);
		
		PROC
		PROC_RoguelikeArena_SpawnBlessedStatue((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty)
		AND
		DB_RoguelikeArena_BlessedStatueTemplate(_BlessedStatueTemplate)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_EVENT")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		CreateItemTemplateAtPosition(_BlessedStatueTemplate, _X, _Y, _Z, _BlessedStatue)
		AND
		QRY_RoguelikeArena_StringPoolSelectRandom("BlessedStatueSurfaceTypePool")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("BlessedStatueSurfaceTypePool", _SurfaceType)
		THEN
		PROC_RoguelikeArena_ItemRandomRotate(_BlessedStatue);
		// PROC_RoguelikeArena_ItemTeleportToValidPosition(_BlessedStatue);
		// PROC_RoguelikeArena_ItemSnapToGround(_BlessedStatue);
		DB_RoguelikeArena_BlessedStatues(_BlessedStatue, _SurfaceType);
		PROC_RoguelikeArena_BlessedStatueSpawned(_BlessedStatue, _Arena, _SurfaceType);
		
		// Triggered when a blessed statue is spawned inside an arena. _SurfaceType is the type of surface the statue creates when used.
		PROC
		PROC_RoguelikeArena_BlessedStatueSpawned((ITEMGUID)_BlessedStatue, (INTEGER)_Arena, (STRING)_SurfaceType)
		THEN
		DB_NOOP(1);
		
		IF
		CharacterUsedItemTemplate(_Character, _Template, _Item)
		AND
		DB_RoguelikeArena_BlessedStatueTemplate(_BlessedStatueTemplate)
		AND
		_Template == _BlessedStatueTemplate
		AND
		GetPosition(_Item, _X, _Y, _Z)
		AND
		DB_RoguelikeArena_BlessedStatues(_Item, _SurfaceType)
		THEN
		CreateSurfaceAtPosition(_X, _Y, _Z, _SurfaceType, 3.0, 12.0);
		ApplyStatus(_Character, "BLESSED", 12.0);
		
		PROC
		PROC_RoguelikeArena_ItemRemove(_Item)
		AND
		DB_RoguelikeArena_BlessedStatues(_Item, _SurfaceType)
		THEN
		NOT DB_RoguelikeArena_BlessedStatues(_Item, _SurfaceType);
		
		PROC
		PROC_RoguelikeArena_StringPoolAddBlessedStatueSurfaceTypes()
		AND
		DB_RoguelikeArena_BlessedStatueSurfaceTypes(_SurfaceType)
		THEN
		PROC_RoguelikeArena_StringPoolAdd("BlessedStatueSurfaceTypePool", _SurfaceType);
		
	}
	EXIT
	{
		
	}
}
Goal(543).Title("RoguelikeArena_Arena_Chest");
Goal(543)
{
	INIT
	{
		DB_RoguelikeArena_ChestTemplates(1, "RoguelikeArena_Chest_Rank1_12120a7d-76dd-4dc7-9b5d-fd91c60686f1", "RoguelikeArena_Chest_Rank1");
		DB_RoguelikeArena_ChestTemplates(2, "RoguelikeArena_Chest_Rank2_e023f315-696b-492c-958d-cd00694f8f4a", "RoguelikeArena_Chest_Rank2");
		DB_RoguelikeArena_ChestTemplates(3, "RoguelikeArena_Chest_Rank3_b36982b7-5e5b-4e3d-831c-bf594b29a8c9", "RoguelikeArena_Chest_Rank3");
		DB_RoguelikeArena_ChestTemplates(4, "RoguelikeArena_Chest_Rank4_8ef15111-6318-4b78-a154-58f35fa744a5", "RoguelikeArena_Chest_Rank4");
		DB_RoguelikeArena_ChestTemplates(5, "RoguelikeArena_Chest_Rank5_539587db-c187-430b-9d3c-c8e166193559", "RoguelikeArena_Chest_Rank5");
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_ArenaCombatEnded(_Arena, _)
		AND
		DB_RoguelikeArena_ActiveArena(_Arena, _Level, _Difficulty, _Players)
		THEN
		PROC_RoguelikeArena_SpawnChest(_Arena, _Level, _Difficulty, _Players);
		
		PROC
		PROC_RoguelikeArena_SpawnChest((INTEGER)_Arena, (INTEGER)_Level, (INTEGER)_Difficulty, (INTEGER)_Players)
		AND
		DB_RoguelikeArena_ChestTemplates(_Difficulty, _Template, _Treasure)
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_CHEST")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		CreateItemTemplateAtPosition(_Template, _X, _Y, _Z, _Chest)
		AND
		SysCount("DB_RoguelikeArena_EnabledMutators", 1, _EnabledMutators)
		AND
		IntegerProduct(_EnabledMutators, _Players, _MutatorTreasureCount)
		THEN
		ItemLevelUpTo(_Chest, _Level);
		PROC_RoguelikeArena_ItemGenerateTreasure(_Chest, _Treasure, _Level, _Players);
		PROC_RoguelikeArena_ItemGenerateTreasure(_Chest, "RoguelikeArena_Mutator", _Level, _MutatorTreasureCount);
		ItemRotateToAngleY(_Chest, 180.0, 10000.0);
		// PROC_RoguelikeArena_ItemSnapToGround(_Chest);
		PlayEffectAtPosition("RS3_FX_GP_ScriptedEvent_Teleport_GenericSmoke_01", _X, _Y, _Z);
		PROC_RoguelikeArena_ChestSpawned(_Chest, _Arena);
		
		// Triggered when a chest is spawned inside an arena.
		PROC
		PROC_RoguelikeArena_ChestSpawned((ITEMGUID)_Chest, (INTEGER)_Arena)
		THEN
		DB_NOOP(1);
		
	}
	EXIT
	{
		
	}
}
