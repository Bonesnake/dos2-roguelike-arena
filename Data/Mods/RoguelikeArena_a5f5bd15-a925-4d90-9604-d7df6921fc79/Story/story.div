		DB_RC_DW_SurpriseDate_Magisters((CHARACTERGUID)CHARACTERGUID_S_RC_DW_Tavern_Magister_SurpriseDate_02_dab75366-9ca9-49b1-ad4b-9a79da1d7de6);
		
