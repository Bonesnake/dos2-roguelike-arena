		Proc_StartDialog(0,"ARX_Sewers_ThievesGuild_Thief_02",CHARACTERGUID_S_ARX_Sewers_ThievesGuild_ThiefLeader_aae19753-a36c-432e-a62e-be6f4ea35611,_Char);
		
