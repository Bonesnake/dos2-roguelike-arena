		DB_FTJ_SW_RiverSurfaceEncounter(ITEMGUID_S_FTJ_SW_EmitterRiverSurface1_fb67d25e-0e34-4c5e-9ac5-ca3aa1cd5f73, CHARACTERGUID_S_FTJ_VoidlingAmbush_001_eedb56aa-aad1-4de2-8097-3fd7241be1ec);
