		AND
		ObjectGetFlag(_Char,"QuestUpdate_RC_DW_SurpriseDate_SexHappened",1)
		THEN
		ObjectSetFlag(_Char,"QuestUpdate_RC_DW_SurpriseDate_Lovrik_DeathRevenge");
		
		IF
		ObjectFlagSet("RC_DW_SeenDead_Lovrik",_Char,_)
		AND
