		Proc_ARX_Sewers_ThievesGuild_Disappear_Dialog(_Char);
		
		PROC
		ProcCrimeOnCustomSensibleAction((CHARACTERGUID)_NPC,_,_,_,_,_Char,_,_,_,_)
		AND
