		THEN
		ProcObjectTimer(_Player,"RC_DW_WC_Debug_InitedWreckerCave_WaitForRegionStarted",500);
		
		PROC
		ProcObjectTimerFinished(_Player,"RC_DW_WC_Debug_InitedWreckerCave_WaitForRegionStarted")
		THEN
