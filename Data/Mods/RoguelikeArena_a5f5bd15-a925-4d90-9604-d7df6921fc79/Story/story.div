		DB_ARX_JournalEntry_Condition("QuestUpdate_ARX_DisappearanceOfArhu_ConfirmCatCapture","QuestUpdate_ARX_KemmVault_KemmVault_EnteredTheVault","QuestUpdate_ARX_DisappearanceOfArhu_FoundVault");
		
