}
Goal(203).Title("DEBUG_RegionEvents");
Goal(203)
{
	INIT
	{
		//DB_DebugTags(_Region,_Tag,_OnlyAvatar)
		DB_DebugTags("RC_Main","CHAMPION_FTJ",1);
		
		//DB_DebugGlobalFlags(_Region,_Flag)
		DB_DebugGlobalFlags("RC_Main","FTJ_SW_GarethAtShelter");
		DB_DebugGlobalFlags("RC_Main","FTJ_SW_ToldTarleneGarethAtShelter");
		DB_DebugGlobalFlags("RC_Main","FTJ_SW_AllInjuredSeekersHealed");
		
		//DB_DebugPlayerCharacterFlags(_Region,_Flag)
		DB_DebugPlayerCharacterFlags("RC_Main","RC_FTJ_OlgoGuard_004_OfferedToMeet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_OlgoGuard_004_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_ShrineSendToHoE");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_MetKniles");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_RemoveSourceCollar");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_HasMet_EscapedPrisoner");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_HasMetHan");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_Samadel_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_ToldTarleneGarethAtShelter");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_TurnCoatMagister_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_RiverHasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_HasMetGareth");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_GoddessStatue_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_Squire_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_InjuredDoctorHasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_InjuredSeeker_001_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_InjuredSeeker_002_HasMet");
		DB_DebugPlayerCharacterFlags("RC_Main","FTJ_SW_DefeatedSeeker_001_Hasmet");
		
		//DB_DebugObjectFlags(_Region,_Object,_Flag)
		DB_DebugObjectFlags("RC_Main",CHARACTERGUID_S_FTJ_SW_SeekerNearSourceTotem_302a752b-d9fa-4e00-b214-f722dc4fa8d6,"FTJ_SW_ToldTarleneGarethAtShelter");
		
	}
	KB
	{
		//REGION Temp
		IF
		TextEventSet("DW")
		THEN
		ProcDoDebugSetup("RC_Main");
		
		IF
		ObjectFlagSet("Debug_RC_Main_Setup",_Player,_)
		THEN
		ProcDoDebugSetup("RC_Main");
		
		//END_REGION
		
		//REGION Remove Fane ELF shapeshift status in the tutorial level
		IF
		DB_DebugProfileChar((CHARACTERGUID)S_Player_Fane_02a77f1f-872b-49ca-91ab-32098c443beb)
		THEN
		RemoveStatus(CHARACTERGUID_S_Player_Fane_02a77f1f-872b-49ca-91ab-32098c443beb,"FANE_ELF");
		//END_REGION
		
		//REGION Source collars
		PROC
		ProcSetupDebugParty()
		AND
		DB_DebugProfileChar(_Char)
		AND
		GetItemForItemTemplateInInventory(_Char,"RC_FTJ_Amulet_SourceCollar_8bf8b97c-556e-4e69-8fc7-39241783dcc1",_)
		THEN
		Proc_GLO_SourceCollars_EquipSourceCollar(_Char);
		
		PROC
		ProcSetupDebugParty()
		AND
		DB_DebugProfileChar(_Char)
		AND
		NOT GetItemForItemTemplateInInventory(_Char,"RC_FTJ_Amulet_SourceCollar_8bf8b97c-556e-4e69-8fc7-39241783dcc1",_)
		THEN
		ObjectSetFlag(_Char,"FTJ_RemoveSourceCollar");
		RemoveStatus(_Char,"SOURCE_MUTED");
		//END_REGION
		
		//REGION Special case handling
		IF
		ObjectFlagSet("FTJ_SW_ShrineSendToHoE",_Char,_)
		AND
		DB_InDebugSetup(1)
		THEN
		DB_FTJ_SW_CompanionHadHoEExperience((CHARACTERGUID)_Char);
		ProcObjectTimerCancel(_Char,"FTJ_SW_GiveCompanionBless");
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(204).Title("DOS2_SavegamePatching");
Goal(204)
{
	INIT
	{
		//don't run patch for new games
		DB_AppliedZaleskar_Patch(1);
		DB_AppliedZaleskar_Patch(2);
		
	}
	KB
	{
		//REGION DOS2EE-5709
		// Bug: waypoints get disabled at the start of Act 1.5, but not re-enabled for companions that were assigned
		//   to another player than the original recruiter.
		// Reason: those companions are NPCs at the start of Act 2, and PROC_UnblockWaypointUsage() did nothing for
		//   characters not in DB_IsPlayer()
		// Solution:
		//   * make PROC_UnblockWaypointUsage() also work for characters not in DB_IsPlayer(), because
		//     PROC_BlockWaypointUsage() already checked if they were players
		//   * since we block waypoint shrines in only a few places, we can explicitly filter those out and remove
		//     blocking for everyone else.
		QRY
		QRY_DOS2_SavegamePatching_WaypointsShouldBeEnabled((CHARACTERGUID)_Player)
		AND
		// Horror sleep arena
		NOT DB_InRegion(_Player, S_ARX_HorrorSleep_Arena_1b8cf005-392f-434a-a564-ecae6778fab0)
		AND
		// Meistr dream scene
		NOT DB_InRegion(_Player, S_RC_DW_Meistr_DreamScene_f206d532-488e-469f-bb2a-5fb4270aa438)
		AND
		// Gods scene in the swamps; since the bug manifests itself after Fort Joy, filter it out completely
		NOT DB_CurrentLevel("FJ_FortJoy_Main")
		AND
		// End game
		NOT DB_CurrentLevel("ARX_EndGame")
		THEN
		DB_NOOP(1);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		DB_BlockWaypointUsage((CHARACTERGUID)_Player)
		AND
		QRY_DOS2_SavegamePatching_WaypointsShouldBeEnabled(_Player)
		THEN
		PROC_UnblockWaypointUsage(_Player);
		
		QRY
		QRY_DOS2_SavegamePatching_NoWayPointsUnlocked((CHARACTERGUID)_Player)
		AND
		NOT DB_WaypointUnlocked(_, _Player)
		THEN
		DB_NOOP(1); 
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_IsPlayer(_Player)
		AND
		QRY_DOS2_SavegamePatching_WaypointsShouldBeEnabled(_Player)
		AND
		// Double negation to prevent setting the state multiple times
		NOT QRY_DOS2_SavegamePatching_NoWayPointsUnlocked(_Player)
		AND
		// Homestead key is currently disabled
		DB_HomesteadKeyState(_Player, 3)
		THEN
		PROC_SetHomesteadKey_Enabled(_Player);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_IsPlayer(_Player)
		THEN
		ObjectClearFlag(_Player, "OpenWaypointUI", 0);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_Origins(_Player)
		AND
		NOT DB_IsPlayer(_Player)
		THEN
		ObjectClearFlag(_Player, "OpenWaypointUI", 0);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_GLO_LVHub_Henchmen_Recruitee(_, _Player)
		AND
		NOT DB_IsPlayer(_Player)
		THEN
		ObjectClearFlag(_Player, "OpenWaypointUI", 0);
		
		//END_REGION
		
		//REGION DOS2EE-5261 savegame fix
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		GetTemplate(S_GLO_Windego_d783285f-d3be-4cba-8333-db8976cef182, "UNIQUE_Windego_Undead_6d42f147-f097-4a9d-9cc0-ab6e53213c5b")
		THEN
		// Transforming to the current template does nothing -> transform her back to her default template and then to the undead one to apply the stats changes
		Transform(S_FTJ_SW_EscapedPrisoner_d783285f-d3be-4cba-8333-db8976cef182,"FTJ_Humans_Female_Civilian_6dbce959-1036-4053-a48e-8e42d188554b",0,0,0);
		Transform(S_FTJ_SW_EscapedPrisoner_d783285f-d3be-4cba-8333-db8976cef182,"UNIQUE_Windego_Undead_6d42f147-f097-4a9d-9cc0-ab6e53213c5b",0,0,1);
		
		//END_REGION
		
		//REGION DOS2EE-6223 savegame fix
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_RC_GY_RykerHouse_UpperFloor_Bodyguards((CHARACTERGUID)_Bodyguard)
		AND
		NOT DB_Dead(_Bodyguard)
		AND
		CharacterIsInCombat(_Bodyguard,0)
		THEN
		SetFaction(_Bodyguard,"RC_GY_Ryker_UpperFloor");
		
		//END_REGION
		
		//REGION DOS2EE-6326, DOS2EE-6327
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		ObjectGetFlag(S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df,"RC_BF_CapturedDemon_Free",1)
		AND
		NOT DB_Dead(S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df)
		AND
		ObjectIsOnStage(S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df,1)
		THEN
		ProcRemoveAllDialogEntriesForSpeaker(CHARACTERGUID_S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df);
		DB_Dialogs(CHARACTERGUID_S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df,"RC_BF_CapturedDemon_Freed");
		SetStoryEvent(S_RC_BF_Mhordkan_840032d5-63a7-44e3-909b-0338621340df,"RC_BF_CapturedDemon_SaveGameFix_3610");
		
		//END_REGION
		
		
		//REGION DOS2EE-5769
		IF
		ObjectFlagSet("QuestUpdate_RC_BI_TheVaultKid_TookKid",_Player,_)
		AND
		DB_IsPlayer((CHARACTERGUID)_Player)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_BI_TheVaults_TookKid");
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_IsPlayer(_Player)
		AND
		ObjectGetFlag(_Player,"QuestUpdate_RC_BI_TheVaultKid_TookKid",1)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_BI_TheVaults_TookKid");
		//END_REGION
		
		//REGION DOS2EE-7129
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 1, 0)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_IsPlayer(_OtherPlayer)
		AND
		_Player != _OtherPlayer
		AND
		CharacterIsInPartyWith(_Player,_OtherPlayer,1)
		AND
		DB_WaypointUnlocked(_WaypointID,_Player)
		AND
		NOT DB_WaypointUnlocked(_WaypointID,_OtherPlayer)
		THEN
		PROC_WayPoints_ShareWayPointState(_Player,_OtherPlayer);
		//END_REGION
		
		//REGION DOS2EE-7129
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		DB_CurrentLevel(_CurrentRegion)
		AND
		DB_WaypointInfo(_Shrine,_,_WaypointID)
		AND
		GetRegion(_Shrine,_Region)
		AND
		_Region != _CurrentRegion
		THEN
		PROC_LockWaypointForAll(_WaypointID);
		
		//END_REGION
		
		//REGION Workaround for bogus DB_IsPlayer entries, of which we have no idea where they come from (DOS2EE-6509)
		// We always set DB_IsPlayer after making a character a player character
		IF
		DB_IsPlayer(_Player)
		AND
		CharacterIsPlayer(_Player, 0)
		AND
		GetRegion(_Player, _Level)
		AND
		IsGameLevel(_Level,1)
		THEN
		DebugBreak("Character added to DB_IsPlayer without them being a player. Please file a JIRA for scripting and say when this happened. Bonus points for an Osirislog!");
		NOT DB_IsPlayer(_Player);
		
		QRY
		QRY_GLO_PartyMembers_LohseSaheilaMoment(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295)
		AND
		DB_FTJ_InLohseSaheilaEvent(1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GLO_PartyMembers_CleanDBIsPlayer()
		AND
		DB_IsPlayer(_Player)
		AND
		NOT CharacterIsPlayer(_Player, 1) //Also fails for non-existent characters.
		AND
		NOT QRY_GLO_PartyMembers_LohseSaheilaMoment(_Player)
		THEN
		DebugBreak("Character in DB_IsPlayer without them being a player. Please file a JIRA for scripting and if you can remember, explain what you did between the previous load and now.");
		NOT DB_IsPlayer(_Player);
		
		PROC
		PROC_GLO_PartyMembers_CleanDBIsPlayer()
		AND
		DB_IsPlayer(_Player)
		AND
		QRY_IsSummonOrPartyFollower(_Player)
		AND
		NOT QRY_GLO_PartyMembers_LohseSaheilaMoment(_Player)
		THEN
		DebugBreak("Character in DB_IsPlayer is a summon. Please file a JIRA for scripting and if you can remember, explain what you did between the previous load and now.");
		NOT DB_IsPlayer(_Player);
		
		IF
		DB_IsPlayer(_Summon)
		AND
		QRY_IsSummonOrPartyFollower(_Summon)
		THEN
		NOT DB_IsPlayer(_Summon);
		DebugBreak("Character in DB_IsPlayer is a summon. Please file a bug report.");
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		THEN
		PROC_GLO_PartyMembers_CleanDBIsPlayer();
		//END_REGION
		
		//REGION DOS2EE-7149
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 2, 0)
		AND
		DB_GLO_Attribute_Check_AgainstLevel("RC_GY_RykerHouse_SpiderRoom_Blocked",_Index,_Attribute,_Difficulty,_Target,_Level)
		THEN
		NOT DB_GLO_Attribute_Check_AgainstLevel("RC_GY_RykerHouse_SpiderRoom_Blocked",_Index,_Attribute,_Difficulty,_Target,_Level);
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 2, 0)
		THEN
		SysClear("DB_RC_GY_RykerHouse_Spider_DoorsStrength",2);
		DB_GLO_Attribute_Check_AgainstLevel("RC_GY_RykerHouse_SpiderRoom_Blocked",1,"Strength","Normal",2,11);
		DB_GLO_Attribute_Check_AgainstLevel("RC_GY_RykerHouse_SpiderRoom_Blocked_Hard",1,"Strength","Hard",2,11);
		SysClear("DB_RC_GY_RykerHouse_Spider_Doors",3);
		DB_RC_GY_RykerHouse_Spider_Doors((ITEMGUID)ITEMGUID_S_RC1_GY_RykerHouse_Stairs_ToSpider_1_2cd835f0-e601-415a-a398-b354377feb3c,1,(TRIGGERGUID)TRIGGERGUID_S_RC_GY_TP_RykerHouse_ToSpider_1_ea284e39-88a8-4298-91f5-5ab1095e494b,"RC_GY_RykerHouse_SpiderRoom_Blocked");
		DB_RC_GY_RykerHouse_Spider_Doors(ITEMGUID_S_RC_GY_RykerHouse_Stairs_ToSpider_2_0c6172ec-9b11-424c-befc-9d5fbfcc231a,2,TRIGGERGUID_S_RC_GY_TP_RykerHouse_ToSpider_2_60c3a08a-d98e-4353-8049-98f2cfaabdcd,"RC_GY_RykerHouse_SpiderRoom_Blocked_Hard");
		DB_RC_GY_RykerHouse_Spider_Doors(ITEMGUID_S_RC_GY_RykerHouse_Stairs_ToSpider_3_73991f0b-f29d-46e2-94bb-60db7ea3e610,3,TRIGGERGUID_S_RC_GY_TP_RykerHouse_ToSpider_3_2bcafc4b-adeb-48a1-a63e-3bb7f1f2c28d,"RC_GY_RykerHouse_SpiderRoom_Blocked_Hard");
		DB_RC_GY_RykerHouse_Spider_Doors(ITEMGUID_S_RC_GY_RykerHouse_Hatch_FromSpider_1_a4bb562f-59e9-4fdd-96de-365433f68c3e,1,TRIGGERGUID_S_RC_GY_TP_RykerHouse_FromSpider_1_7fd80de0-ac96-4f77-bf23-e9f3d6da1433,"RC_GY_RykerHouse_SpiderRoom_Blocked");
		DB_RC_GY_RykerHouse_Spider_Doors(ITEMGUID_S_RC_GY_RykerHouse_Hatch_FromSpider_2_d6a1a523-5b30-4fc4-b132-ce1297b85264,2,TRIGGERGUID_S_RC_GY_TP_RykerHouse_FromSpider_2_5c45d1a9-856b-41fd-b622-49bc1e89033f,"RC_GY_RykerHouse_SpiderRoom_Blocked_Hard");
		DB_RC_GY_RykerHouse_Spider_Doors(ITEMGUID_S_RC_GY_RykerHouse_Hatch_FromSpider_3_5f015a44-dc4c-4158-ba5f-65590352c670,3,TRIGGERGUID_S_RC_GY_TP_RykerHouse_FromSpider_3_2d34b930-afa5-4328-9272-1fcc2d93e144,"RC_GY_RykerHouse_SpiderRoom_Blocked_Hard");
		//END_REGION
		
		//REGION DOS2EE-7093
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 2, 0)
		THEN
		CharacterSetCanSpotSneakers(S_FTJ_SW_Warrior_SeekerCaptain_1329f018-23e4-4717-9bc8-074b28d04c54, 1);
		//END_REGION
		
		//REGION DOS2EE-7349
		IF
		SavegameLoaded(_,_,_,_)
		AND
		NOT DB_AppliedZaleskar_Patch(1)
		THEN
		PROC_ApplyZaleskarAlignmentPatch();
		
		PROC
		PROC_ApplyZaleskarAlignmentPatch()
		THEN
		DB_AppliedZaleskar_Patch(1);
		
		PROC
		PROC_ApplyZaleskarAlignmentPatch()
		AND
		ObjectExists(S_FTJ_IfanHandler_d0920841-a984-4ea4-92c6-31d236ee2540,1)
		THEN
		SetFaction(S_FTJ_IfanHandler_d0920841-a984-4ea4-92c6-31d236ee2540,"FTJ_Zaleskar");
		
		QRY
		QRY_GetZaleskarFixAlignment((CHARACTERGUID)_Player)
		AND
		DB_GLO_PartyMembers_DefaultFaction(_Player, _Faction2)
		THEN
		DB_ZaleskarFixAlignment(_Player,_Faction2);
		
		QRY
		QRY_GetZaleskarFixAlignment((CHARACTERGUID)_Player)
		AND
		NOT DB_GLO_PartyMembers_DefaultFaction(_Player, _)
		AND
		GetFaction(_Player,_Faction2)
		THEN
		DB_ZaleskarFixAlignment(_Player,_Faction2);
		
		PROC
		PROC_ApplyZaleskarAlignmentPatch()
		AND
		DB_HostileToPlayerGroup(S_FTJ_IfanHandler_d0920841-a984-4ea4-92c6-31d236ee2540, _Player)
		AND
		QRY_GetZaleskarFixAlignment(_Player)
		AND
		DB_ZaleskarFixAlignment(_Player,_Faction2)
		THEN
		NOT DB_ZaleskarFixAlignment(_Player,_Faction2);
		CharacterSetRelationFactionToFaction("FTJ_Zaleskar", _Faction2, 0);
		CharacterSetRelationFactionToFaction(_Faction2, "FTJ_Zaleskar", 0);
		CharacterSetRelationFactionToFaction("Neutral NPC", _Faction2, 50);
		CharacterSetRelationFactionToFaction(_Faction2, "Neutral NPC", 50);
		
		
		// Fix in case players already got into a combat with Zrilla because of the above
		IF
		SavegameLoaded(_,_,_,_)
		AND
		NOT DB_AppliedZaleskar_Patch(2)
		THEN
		PROC_ApplyZaleskarAlignmentCombatPatch();
		
		PROC
		PROC_ApplyZaleskarAlignmentCombatPatch()
		THEN
		DB_AppliedZaleskar_Patch(2);
		
		PROC
		PROC_ApplyZaleskarAlignmentCombatPatch()
		AND
		DB_CurrentLevel("LV_HoE_Main")
		AND
		DB_HostileToPlayerGroup(S_FTJ_IfanHandler_d0920841-a984-4ea4-92c6-31d236ee2540, _)
		AND
		DB_CombatCharacters(S_GLO_LV_HenchmenRecruiter_ed64ea06-9060-4b29-88dd-623ab008fae6, _ID)
		THEN
		LeaveCombat(S_GLO_LV_HenchmenRecruiter_ed64ea06-9060-4b29-88dd-623ab008fae6);
		DB_BUGFIX_Marker(S_GLO_LV_HenchmenRecruiter_ed64ea06-9060-4b29-88dd-623ab008fae6,"DOS2EE-7349");
		//END_REGION
		
		//REGION  DOS2EE-7434
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 3, 0)
		AND
		DB_IsPlayer(_Player)
		AND
		QuestAccepted(_Player,"FTJ_SW_Illusionist",1)
		AND
		ObjectGetFlag(_Player,"QuestUpdate_FTJ_SW_Illusionist_MeetIllusionist",0)
		AND
		ObjectGetFlag(_Player,"QuestUpdate_FTJ_SW_Illusionist_Start_FindEntrance",1)
		AND
		DB_CurrentLevel(_Level)
		AND
		_Level != "FJ_FortJoy_Main"
		THEN
		PartySetFlag(_Player,"QuestUpdate_FTJ_SW_Illusionist_CloseLeftFortJoyStillSecret");
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 3, 0)
		AND
		DB_QuestDef_CloseAtRegionEnded_Conditions_FalseObjFlag_TrueObjFlag("FTJ_SW_Illusionist","QuestUpdate_FTJ_SW_Illusionist_Start_CloseLeftFortJoyDungeon","FJ_FortJoy_Main","QuestUpdate_FTJ_SW_Illusionist_MeetIllusionist","QuestUpdate_FTJ_SW_Illusionist_Start_FindEntrance")
		THEN
		NOT DB_QuestDef_CloseAtRegionEnded_Conditions_FalseObjFlag_TrueObjFlag("FTJ_SW_Illusionist","QuestUpdate_FTJ_SW_Illusionist_Start_CloseLeftFortJoyDungeon","FJ_FortJoy_Main","QuestUpdate_FTJ_SW_Illusionist_MeetIllusionist","QuestUpdate_FTJ_SW_Illusionist_Start_FindEntrance");
		DB_QuestDef_CloseAtRegionEnded_Conditions_FalseObjFlag_TrueObjFlag("FTJ_SW_Illusionist","QuestUpdate_FTJ_SW_Illusionist_CloseLeftFortJoyStillSecret","FJ_FortJoy_Main","QuestUpdate_FTJ_SW_Illusionist_MeetIllusionist","QuestUpdate_FTJ_SW_Illusionist_Start_FindEntrance");
		
		//END_REGION
		
		//REGION 
		PROC
		PROC_GLO_PartyMembers_CleanDBIsPlayer()
		AND
		DB_GlobalFlag("RC_LV_NotAllPlayersOnBoard")
		AND
		NOT QRY_RC_LV_AnyPlayersNotOnBoard()
		THEN
		GlobalClearFlag("RC_LV_NotAllPlayersOnBoard");
		
		QRY
		QRY_RC_LV_AnyPlayersNotOnBoard()
		AND
		DB_IsPlayer(_Player)
		AND
		NOT DB_InRegion(_Player, S_RC_LV_OnBoard_3d5b3e43-2126-464e-81d1-3c0b60841276)
		THEN
		DB_NOOP(1);
		
		//END_REGION DOS2EE-8025
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 5, 0)
		AND
		NOT DB_CurrentLevel("TUT_Tutorial_A")
		AND
		NOT DB_CurrentLevel("FJ_FortJoy_Main")
		THEN
		ProcCharacterDisableCrime(S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620, "ActiveUndead");
		
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 5, 0)
		AND
		DB_Crime_WarningCount(_Count, "ActiveUndead", _Target, S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620)
		AND
		DB_CombatCharacters(S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620, _Combat)
		THEN
		NOT DB_Crime_WarningCount(_Count, "ActiveUndead", _Target, S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620);
		DB_BUGFIX_Marker(_Target,"DOS2EE-8025");
		EndCombat(_Combat);
		PROC_DOS2EE_8025_FixTarquinPlayerAttitude();
		
		PROC
		PROC_DOS2EE_8025_FixTarquinPlayerAttitude()
		AND
		DB_JoinedParty(_Player)
		AND
		ObjectExists(_Player, 1)
		AND
		CharacterGetAttitudeTowardsPlayer(S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620, _Player, _Attitude)
		AND
		_Attitude < 0
		AND
		IntegerSubtract(0, _Attitude, _Diff)
		THEN
		CharacterAddAttitudeTowardsPlayer(S_GLO_Tarquin_a3d0cdcc-d0b0-464d-9ad7-43b38baed620, _Player, _Diff);
		//REGION
		
		//REGION DOS2EE-8196
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 5, 0)
		AND
		DB_BI_AncestorTree_Enemy_BlackRing(_BlackRing)
		THEN
		DB_DontCreateMurder(_BlackRing);
		//END_REGION
		
		
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
