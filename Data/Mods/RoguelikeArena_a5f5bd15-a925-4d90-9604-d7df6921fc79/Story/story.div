		DB_Subregion(TRIGGERGUID_S_ARX_DivineTomb_EmptyCatacombs_SubregionBox_487af5bb-537d-4367-8e50-e3815fc32012,"ARX_DivineTomb_EmptyCatacombs",0);
		DB_Subregion(TRIGGERGUID_S_ARX_DivineTomb_DeathRoom_SubregionBox_f1670d09-2646-451f-96bb-74dcbdf06f1d,"ARX_DivineTomb_DeathRoom",0);
		DB_Subregion(TRIGGERGUID_S_ARX_DivineTomb_DivineCrypt_SubregionBox_e4e3f195-07da-4a38-ba4b-807ef0b91614,"ARX_DivineTomb_DivineCrypt",0);
		
		//Lizrd Consulate
		DB_Subregion(TRIGGERGUID_S_ARX_LizardConsulate_716b7fb5-bc77-473a-a9ad-4de792002624,"ARX_LizardConsulate",1);
		DB_Subregion(TRIGGERGUID_S_ARX_HorrorSleep_WarZone_59391e6d-a22d-4f33-982b-a5b65c023e21,"ARX_HorrorSleep_WarZone",0);
		DB_Subregion(TRIGGERGUID_S_ARX_HorrorSleep_Arena_1b8cf005-392f-434a-a564-ecae6778fab0,"ARX_HorrorSleep_Arena",0);
		DB_Subregion(TRIGGERGUID_S_ARX_HorrorSleep_Sunset_67df0f1c-9cf2-46c5-8b28-64376a9b274c,"ARX_HorrorSleep_Sunset",0);
		
		//Streets
		
		//Outskirts
		DB_Subregion(TRIGGERGUID_S_ARX_Outskirts_PilgrimCamp_Subregion_Box_0111fa13-4ffd-456c-957d-4e5bff0de0ef,"ARX_Outskirts_PilgrimCamp",1);
		DB_Subregion(TRIGGERGUID_S_ARX_Outskirts_DeathFogZone_Subregion_Box_9930dd4d-18db-49dc-b844-ad689f66834a,"ARX_Outskirts_DeathfogZone",1);
		DB_Subregion(TRIGGERGUID_S_ARX_Outskirts_Harbour_Subregion_Box_c14f8f58-aa68-4f8a-a18c-3a47dd16cf28,"ARX_Outskirts_Harbour",1);
		DB_Subregion(TRIGGERGUID_S_ARX_Outskirts_Harbour_CellarWithStuff_SubregionBox_a4faa3f4-0a2f-4513-9f07-002514938fed,"ARX_Harbour_CellarWithStuff",0);
		DB_Subregion(TRIGGERGUID_S_ARX_Outskirts_Harbour_CellarWithBoat_SubregionBox_89f6e8ef-440e-4bcf-9542-8e05cad5086e,"ARX_Harbour_CellarWithBoat",0);
		
		//END_REGION
		
		//REGION Autosave
		
		DB_AutoSaveTrigger(TRIGGERGUID_S_ARX_AutoSave_ArxStart_190de5c7-6e02-4d2c-8f6c-356efeae9773);
		DB_AutoSaveTrigger(TRIGGERGUID_S_ARX_AutoSave_Harbour_985e735e-08af-4386-bddb-7cadf7107835);
		DB_AutoSaveTrigger(TRIGGERGUID_S_ARX_Sewers_ToQueensRoom_PathRoom_984527f7-d450-4709-8b8e-08a95d8403a4);
		DB_AutoSaveTrigger(TRIGGERGUID_S_ARX_AutoSave_KemmVault_01_cbc16cff-26c7-4aeb-9cee-c5d51db4e769);
