		DB_QuestDef_CloseEvent("RC_BI_TheVaults_SUBC","QuestUpdate_RC_BI_TheVaultAdventurer_SavedAdventurer");
		
		DB_QuestDef_State("TUT_ShipInvestigation","Start_MagisterDead");
		DB_QuestDef_State("TUT_ShipInvestigation","AteVictimLimb_MagisterDead");
		DB_QuestDef_State("TUT_ShipInvestigation","SearchWoman_MagisterDead");
		
		DB_QuestDef_State("RC_DF_PolyLovers","DrankFirstPotion");
		
		//END_REGION
		
		//REGION PATCH 4
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 4, 0)
		THEN
		DB_QuestDef_State("FTJ_SW_HurtSeekers","AllDead",-1);
		//END_REGION
		
		//REGION PATCH 5
		// DOS2EE-8027
		IF
		SavegameLoaded(_Major,_Minor,_Rev,_Build)
		AND
		QRY_VersionIsOlderThan(_Major,_Minor,_Rev,_Build, 3, 6, 5, 0)
		THEN
		DB_QuestDef_QuestReward("RC_BI_TheVaults","QuestReward","QuestUpdate_RC_BI_TheVaults_QuestReward");
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
