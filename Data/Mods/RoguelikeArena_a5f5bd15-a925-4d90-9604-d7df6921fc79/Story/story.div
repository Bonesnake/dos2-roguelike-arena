	KB
	{
		//REGION Start Dialog when a Player uses the item
		IF
		CharacterUsedItemTemplate(_Player,"GLO_Debug_Item_bcf8f28d-9ed1-43c0-bfc6-284aff5a6d19",_)
		THEN
		Proc_StartDialog(0,"GEN_Debug_Item",_Player);
		
		IF
		ObjectFlagSet("Debug_GodMode_On",(CHARACTERGUID)_Player,_)
		AND
		DB_IsPlayer((CHARACTERGUID)_AllPlayers)
		THEN
		CharacterSetImmortal(_AllPlayers,1);
		ProcSetInvulnerable(_AllPlayers,1);
		
		IF
		ObjectFlagSet("Debug_GodMode_Off",(CHARACTERGUID)_Player,_)
		AND
		DB_IsPlayer((CHARACTERGUID)_AllPlayers)
		THEN
		CharacterSetImmortal(_AllPlayers,0);
		ProcSetInvulnerable(_AllPlayers,0);
		//END_REGION
		
		//REGION Add Origin To Party
		IF
		TextEventSet("Recruit_All")
		AND
		CharacterGetHostCharacter(_Player)
		THEN
		ObjectSetFlag(_Player,"Recruit_Ifan");
		ObjectSetFlag(_Player,"Recruit_Lohse");
		ObjectSetFlag(_Player,"Recruit_RedPrince");
		ObjectSetFlag(_Player,"Recruit_Sebille");
		
		IF
		ObjectFlagSet("Recruit_Ifan",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_Ifan_ad9a3327-4456-42a7-9bf4-7ad60cc9e54f,_Player);
		PROC_GLO_PartyMembers_Add(CHARACTERGUID_S_Player_Ifan_ad9a3327-4456-42a7-9bf4-7ad60cc9e54f,_Player);
		ObjectClearFlag(_Player,"Recruit_Ifan",0);
		ProcClearStoryMove(CHARACTERGUID_S_Player_Ifan_ad9a3327-4456-42a7-9bf4-7ad60cc9e54f);
		
		IF
		ObjectFlagSet("Recruit_Lohse",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295,_Player);
		PROC_GLO_PartyMembers_Add(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295,_Player);
		ObjectClearFlag(_Player,"Recruit_Lohse",0);
		ProcClearStoryMove(CHARACTERGUID_S_Player_Lohse_bb932b13-8ebf-4ab4-aac0-83e6924e4295);
		
		
		IF
		ObjectFlagSet("Recruit_RedPrince",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_RedPrince_a26a1efb-cdc8-4cf3-a7b2-b2f9544add6f,_Player);
		PROC_GLO_PartyMembers_Add(CHARACTERGUID_S_Player_RedPrince_a26a1efb-cdc8-4cf3-a7b2-b2f9544add6f,_Player);
		ObjectClearFlag(_Player,"Recruit_RedPrince",0);
		ProcClearStoryMove(CHARACTERGUID_S_Player_RedPrince_a26a1efb-cdc8-4cf3-a7b2-b2f9544add6f);
		
		
		IF
		ObjectFlagSet("Recruit_Sebille",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_Sebille_c8d55eaf-e4eb-466a-8f0d-6a9447b5b24c,_Player);
		PROC_GLO_PartyMembers_Add(CHARACTERGUID_S_Player_Sebille_c8d55eaf-e4eb-466a-8f0d-6a9447b5b24c,_Player);
		ObjectClearFlag(_Player,"Recruit_Sebille",0);
		ProcClearStoryMove(CHARACTERGUID_S_Player_Sebille_c8d55eaf-e4eb-466a-8f0d-6a9447b5b24c);
		
		IF
		ObjectFlagSet("Recruit_Beast",(CHARACTERGUID)_Player,_)
		THEN
		TeleportTo(CHARACTERGUID_S_Player_Beast_f25ca124-a4d2-427b-af62-df66df41a978,_Player);
		PROC_GLO_PartyMembers_Add(CHARACTERGUID_S_Player_Beast_f25ca124-a4d2-427b-af62-df66df41a978,_Player);
