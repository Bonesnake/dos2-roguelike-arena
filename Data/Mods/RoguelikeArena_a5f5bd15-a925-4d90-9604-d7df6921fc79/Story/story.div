		DB_Dialogs(CHARACTERGUID_S_RC_DW_Tavern_Magister_SurpriseDate_01_dc36b6c3-9908-4b8a-8d3f-f262729f71e0,"RC_DW_Tavern_Magister_SurpriseDate_01");
