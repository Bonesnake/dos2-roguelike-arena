		AND
		QueryOnlyOnce("ARX_AD_RedPrincessFlee")
		THEN
		RemoveHarmfulStatuses(CHARACTERGUID_S_ARX_KemmMansion_LizardNoble_003d31c6-e2bf-4850-a15d-389727593e42);
