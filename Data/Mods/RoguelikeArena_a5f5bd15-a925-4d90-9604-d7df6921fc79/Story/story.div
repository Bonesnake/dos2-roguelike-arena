		DB_RoguelikeArena_MutatorBuffs("APOTHEOSIS");
		DB_RoguelikeArena_MutatorBuffs("BLESSED");
		DB_RoguelikeArena_MutatorBuffs("CLEAR_MINDED");
		DB_RoguelikeArena_MutatorBuffs("DEATH_WISH");
		DB_RoguelikeArena_MutatorBuffs("ENCOURAGED");
		DB_RoguelikeArena_MutatorBuffs("FARSIGHT");
		DB_RoguelikeArena_MutatorBuffs("FIRE_BRAND");
		DB_RoguelikeArena_MutatorBuffs("FORTIFIED");
		DB_RoguelikeArena_MutatorBuffs("FROST_AURA");
		DB_RoguelikeArena_MutatorBuffs("GROUNDED");
		DB_RoguelikeArena_MutatorBuffs("HASTED");
		DB_RoguelikeArena_MutatorBuffs("HORNS");
		DB_RoguelikeArena_MutatorBuffs("INNER_DEMON");
		DB_RoguelikeArena_MutatorBuffs("MAGIC_SHELL");
		DB_RoguelikeArena_MutatorBuffs("MEND_METAL");
		DB_RoguelikeArena_MutatorBuffs("RESTED");
		DB_RoguelikeArena_MutatorBuffs("STEEL_SKIN");
		DB_RoguelikeArena_MutatorBuffs("THICK_OF_THE_FIGHT");
		DB_RoguelikeArena_MutatorBuffs("VAMPIRISM");
		DB_RoguelikeArena_MutatorBuffs("WIND_WALKER");
		
		DB_RoguelikeArena_MutatorDebuffs("ACID");
		DB_RoguelikeArena_MutatorDebuffs("BLEEDING");
		DB_RoguelikeArena_MutatorDebuffs("BLIND");
		DB_RoguelikeArena_MutatorDebuffs("BURNING");
		DB_RoguelikeArena_MutatorDebuffs("CHILLED");
		DB_RoguelikeArena_MutatorDebuffs("CRIPPLED");
		DB_RoguelikeArena_MutatorDebuffs("CURSED");
		DB_RoguelikeArena_MutatorDebuffs("DAMAGE_ON_MOVE");
		DB_RoguelikeArena_MutatorDebuffs("DEAF");
		DB_RoguelikeArena_MutatorDebuffs("DECAYING_TOUCH");
		DB_RoguelikeArena_MutatorDebuffs("DISEASED");
		DB_RoguelikeArena_MutatorDebuffs("DRUNK");
		DB_RoguelikeArena_MutatorDebuffs("MUTED");
		DB_RoguelikeArena_MutatorDebuffs("NECROFIRE");
		DB_RoguelikeArena_MutatorDebuffs("SHOCKED");
		DB_RoguelikeArena_MutatorDebuffs("SLOWED");
		DB_RoguelikeArena_MutatorDebuffs("SOURCE_MUTED");
		DB_RoguelikeArena_MutatorDebuffs("UNHEALABLE");
		DB_RoguelikeArena_MutatorDebuffs("WARM");
		DB_RoguelikeArena_MutatorDebuffs("WET");
		
		PROC_RoguelikeArena_StringPoolAddMutatorBuffs();
		PROC_RoguelikeArena_StringPoolAddMutatorDebuffs();
		
	}
	KB
	{
		PROC
		PROC_RoguelikeArena_StringPoolAddMutatorBuffs()
		AND
		DB_RoguelikeArena_MutatorBuffs(_Buff)
		THEN
		PROC_RoguelikeArena_StringPoolAdd("MutatorBuffs", _Buff);
		
		PROC
		PROC_RoguelikeArena_StringPoolAddMutatorDebuffs()
		AND
		DB_RoguelikeArena_MutatorDebuffs(_Debuff)
		THEN
		PROC_RoguelikeArena_StringPoolAdd("MutatorDebuffs", _Debuff);
		
		IF
		GlobalFlagSet(_Flag)
		AND
		DB_RoguelikeArena_Mutators(_Mutator)
		AND
		StringConcatenate("RoguelikeArena_Mutators_", _Mutator, _MutatorFlag)
		AND
		_Flag == _MutatorFlag
		THEN
		PROC_RoguelikeArena_EnableMutator(_Mutator);
		
		IF
		GlobalFlagCleared(_Flag)
		AND
		DB_RoguelikeArena_Mutators(_Mutator)
		AND
		StringConcatenate("RoguelikeArena_Mutators_", _Mutator, _MutatorFlag)
		AND
		_Flag == _MutatorFlag
		THEN
		PROC_RoguelikeArena_DisableMutator(_Mutator);
		
		PROC
		PROC_RoguelikeArena_EnableMutator((STRING)_Mutator)
		THEN
		DB_RoguelikeArena_EnabledMutators(_Mutator);
		
		PROC
		PROC_RoguelikeArena_DisableMutator((STRING)_Mutator)
		AND
		DB_RoguelikeArena_EnabledMutators(_Mutator)
		THEN
		NOT DB_RoguelikeArena_EnabledMutators(_Mutator);
		
		QRY
		QRY_RoguelikeArena_MutatorIsEnabled((STRING)_Mutator)
		AND
		DB_RoguelikeArena_EnabledMutators(_Mutator)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_RoguelikeArena_ArenaStarted(_Arena, _Level, _, _)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("AbsoluteBoneyage")
		AND
		QRY_RoguelikeArena_GetRandomPositionInArena(_Arena, "SPAWNER_ENEMY")
		AND
		DB_RoguelikeArena_RandomPositionResult(_X, _Y, _Z)
		AND
		DB_RoguelikeArena_BoneyTemplate(_BoneyTemplate)
		AND
		CharacterCreateAtPosition(_X, _Y, _Z, _BoneyTemplate, 0, _Boney)
		AND
		IntegertoString(_Arena, _CombatGroupID)
		THEN
		SetCombatGroupID(_Boney, _CombatGroupID);
		CharacterLevelUpTo(_Boney, _Level);
		
		PROC
		PROC_RoguelikeArena_ObjectEnteredArenaCombat(_Object, _, _)
		AND
		ObjectIsCharacter((CHARACTERGUID)_Object, 1)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("BolsteredAdversaries")
		AND
		GetFaction(_Object, "Evil NPC")
		AND
		CharacterIsSummon(_Object, 0)
		AND
		QRY_RoguelikeArena_StringPoolSelectRandom("MutatorBuffs")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("MutatorBuffs", _Buff)
		THEN
		ApplyStatus(_Object, _Buff, -1.0);
		
		PROC
		PROC_RoguelikeArena_ObjectEnteredArenaCombat(_Object, _, _)
		AND
		ObjectIsCharacter((CHARACTERGUID)_Object, 1)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("HinderedBeginnings")
		AND
		CharacterIsPlayer(_Object, 1)
		AND
		CharacterIsSummon(_Object, 0)
		AND
		QRY_RoguelikeArena_StringPoolSelectRandom("MutatorDebuffs")
		AND
		DB_RoguelikeArena_StringPoolSelectedValue("MutatorDebuffs", _Debuff)
		THEN
		ApplyStatus(_Object, _Debuff, 18.0, 1);
		
		PROC
		PROC_RoguelikeArena_ObjectEnteredArenaCombat(_Object, _, _)
		AND
		ObjectIsCharacter((CHARACTERGUID)_Object, 1)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("SourceDrain")
		AND
		CharacterIsPlayer(_Object, 1)
		AND
		CharacterIsSummon(_Object, 0)
		AND
		CharacterGetSourcePoints(_Object, _SourcePoints)
		AND
		IntegerProduct(_SourcePoints, -1, _SourcePointsToRemove)
		THEN
		CharacterAddSourcePoints(_Object, _SourcePointsToRemove);
		
		PROC
		PROC_RoguelikeArena_ObjectArenaTurnStarted(_Object, _)
		AND
		ObjectIsCharacter((CHARACTERGUID)_Object, 1)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("SourceFanatics")
		AND
		GetFaction(_Object, "Evil NPC")
		AND
		CharacterIsSummon(_Object, 0)
		THEN
		CharacterAddSourcePoints(_Object, 1);
		
		PROC
		PROC_RoguelikeArena_ObjectArenaTurnEnded(_Object, _)
		AND
		ObjectIsCharacter((CHARACTERGUID)_Object, 1)
		AND
		QRY_RoguelikeArena_MutatorIsEnabled("ThreadOfLife")
		AND
		CharacterIsPlayer(_Object, 1)
		AND
		CharacterIsSummon(_Object, 0)
		AND
		CharacterIsInCombat(_Object, 1)
		AND
		CharacterGetHitpointsPercentage(_Object, _HitpointsPercentage)
		AND
		RealSubtract(_HitpointsPercentage, 15.0, _NewHitpointsPercentage)
		THEN
		CharacterSetHitpointsPercentage(_Object, _NewHitpointsPercentage);
		
	}
	EXIT
	{
		
	}
}
Goal(591).Title("RoguelikeArena_Price");
Goal(591)
{
	INIT
	{
		
	}
	KB
	{
		// Generates a price to be used for ingame features and puts the result into the "RoguelikeArena_PriceResult" singleton.
		QRY
		QRY_RoguelikeArena_Price((INTEGER)_Level, (INTEGER)_Base, (INTEGER)_Modifier)
		AND
		IntegerProduct(_Base, _Level, _BaseModified)
		AND
		IntegerProduct(_Level, _Level, _LevelPow)
		AND
		IntegerProduct(_Modifier, _LevelPow, _ModifierModified)
		AND
		IntegerSum(_BaseModified, _ModifierModified, _Price)
		THEN
		DB_Singleton("RoguelikeArena_PriceResult", _Price);
		
	}
	EXIT
	{
		
	}
}
Goal(592).Title("RoguelikeArena_Progression");
Goal(592)
{
	INIT
	{
		
	}
	KB
	{
		// Increases arena level and resets difficulty.
		PROC
		PROC_RoguelikeArena_ProgressArena()
		AND
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_CurrentDifficulty)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_MaxDifficulty)
		AND
		_CurrentDifficulty >= _MaxDifficulty
		THEN
		PROC_RoguelikeArena_IncreaseArenaLevel();
		DB_RoguelikeArena_Singleton_CurrentDifficulty(0);
		
		// Increases arena difficulty.
		PROC
		PROC_RoguelikeArena_ProgressArena()
		AND
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_CurrentDifficulty)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_MaxDifficulty)
		AND
		_CurrentDifficulty < _MaxDifficulty
		THEN
		PROC_RoguelikeArena_IncreaseArenaDifficulty();
		
		PROC
		PROC_RoguelikeArena_IncreaseArenaLevel()
		AND
		DB_RoguelikeArena_Singleton_CurrentLevel(_CurrentLevel)
		AND
		IntegerSum(_CurrentLevel, 1, _NextLevel)
		AND
		IntegerMin(_NextLevel, 35, _NextLevelCorrected)
		THEN
		DB_RoguelikeArena_Singleton_CurrentLevel(_NextLevelCorrected);
		
		PROC
		PROC_RoguelikeArena_IncreaseArenaDifficulty()
		AND
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_CurrentDifficulty)
		AND
		IntegerSum(_CurrentDifficulty, 1, _NextDifficulty)
		AND
		DB_RoguelikeArena_Singleton_MinDifficulty(_MinDifficulty)
		AND
		IntegerMax(_NextDifficulty, _MinDifficulty, _NextDifficultyCorrected)
		THEN
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_NextDifficultyCorrected);
		
	}
	EXIT
	{
		
	}
}
Goal(593).Title("RoguelikeArena_Random");
Goal(593)
{
	INIT
	{
		
	}
	KB
	{
		// Generates a random number between min and max (inclusive) and puts the result into "DB_RoguelikeArena_RandomResult" singleton.
		QRY
		QRY_RoguelikeArena_RandomInclusive((INTEGER)_Min, (INTEGER)_Max)
		AND
		IntegerSubtract(_Max, _Min, _MaxOffsetted)
		AND
		IntegerSum(_MaxOffsetted, 1, _MaxOffsettedIncremented)
		AND
		Random(_MaxOffsettedIncremented, _ResultOffsetted)
		AND
		IntegerSum(_ResultOffsetted, _Min, _Result)
		THEN
		DB_RoguelikeArena_RandomResult(_Result);
		
		IF
		DB_RoguelikeArena_RandomResult(_Result)
		AND
		DB_RoguelikeArena_RandomResult(_ResultOther)
		AND
		_Result != _ResultOther
		THEN
		NOT DB_RoguelikeArena_RandomResult(_ResultOther);
		
		QRY
		QRY_RoguelikeArena_RandomCount((INTEGER)_Base, (INTEGER)_Modifier, (INTEGER)_Interval, (INTEGER)_Variance)
		AND
		IntegerProduct(_Base, _Modifier, _Product)
		AND
		IntegerSubtract(_Product, 1, _Dividend)
		AND
		IntegerDivide(_Dividend, _Interval, _Quotient)
		AND
		IntegerSum(_Quotient, 1, _Min)
		AND
		IntegerSum(_Min, _Variance, _Max)
		AND
		QRY_RoguelikeArena_RandomInclusive(_Min, _Max)
		THEN
		DB_NOOP(1);
		
	}
	EXIT
	{
		
	}
}
Goal(594).Title("RoguelikeArena_Singletons");
Goal(594)
{
	INIT
	{
		DB_RoguelikeArena_Singleton_MinLevel(1);
		DB_RoguelikeArena_Singleton_MaxLevel(35);
		DB_RoguelikeArena_Singleton_CurrentLevel(1);
		
		DB_RoguelikeArena_Singleton_MinDifficulty(1);
		DB_RoguelikeArena_Singleton_MaxDifficulty(5);
		DB_RoguelikeArena_Singleton_CurrentDifficulty(0);
		
	}
	KB
	{
		IF
		DB_RoguelikeArena_Singleton_MinLevel(_NewLevel)
		AND
		DB_RoguelikeArena_Singleton_MinLevel(_OldLevel)
		AND
		_NewLevel != _OldLevel
		THEN
		NOT DB_RoguelikeArena_Singleton_MinLevel(_OldLevel);
		
		IF
		DB_RoguelikeArena_Singleton_MaxLevel(_NewLevel)
		AND
		DB_RoguelikeArena_Singleton_MaxLevel(_OldLevel)
		AND
		_NewLevel != _OldLevel
		THEN
		NOT DB_RoguelikeArena_Singleton_MaxLevel(_OldLevel);
		
		IF
		DB_RoguelikeArena_Singleton_CurrentLevel(_NewLevel)
		AND
		DB_RoguelikeArena_Singleton_CurrentLevel(_OldLevel)
		AND
		_NewLevel != _OldLevel
		THEN
		NOT DB_RoguelikeArena_Singleton_CurrentLevel(_OldLevel);
		
		IF
		DB_RoguelikeArena_Singleton_MinDifficulty(_NewDifficulty)
		AND
		DB_RoguelikeArena_Singleton_MinDifficulty(_OldDifficulty)
		AND
		_NewDifficulty != _OldDifficulty
		THEN
		NOT DB_RoguelikeArena_Singleton_MinDifficulty(_OldDifficulty);
		
		IF
		DB_RoguelikeArena_Singleton_MaxDifficulty(_NewDifficulty)
		AND
		DB_RoguelikeArena_Singleton_MaxDifficulty(_OldDifficulty)
		AND
		_NewDifficulty != _OldDifficulty
		THEN
		NOT DB_RoguelikeArena_Singleton_MaxDifficulty(_OldDifficulty);
		
		IF
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_NewDifficulty)
		AND
		DB_RoguelikeArena_Singleton_CurrentDifficulty(_OldDifficulty)
		AND
		_NewDifficulty != _OldDifficulty
		THEN
		NOT DB_RoguelikeArena_Singleton_CurrentDifficulty(_OldDifficulty);
		
	}
	EXIT
	{
		
	}
}
Goal(595).Title("RoguelikeArena_TeleporterPyramids");
