		DB_RC_LV_QuestNPCDialogOnBoatBeforeGoingToCoS(CHARACTERGUID_S_FTJ_CapturedChild_53d4aa5c-dd91-4e12-9ca8-d66879cc6ffb,"RC_LV_Han");
		
