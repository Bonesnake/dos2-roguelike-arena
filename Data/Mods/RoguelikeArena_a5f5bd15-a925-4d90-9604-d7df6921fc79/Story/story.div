Goal(447).Title("RC_DW_WreckersBossFight");
Goal(447)
{
	INIT
	{
		SetVarObject(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"SpottedTrigger",TRIGGERGUID_S_RC_DW_WC_BossFight_ElderDialog_Box_41cbb421-efb9-4521-baac-fc0c4637fc6a);
		SetOnStage(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,0);
		
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_BossFight_ElderAtaraxian");
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_7443355b-750f-45b6-9989-f3dedcbde92d,"RC_DW_WC_BossFight_Dwarves_PossessedSourcerer");
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_163d7085-670d-40aa-b602-157b28cada00,"RC_DW_WC_BossFight_Humans_PossessedSourcerer");
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_69b23183-48f6-45cb-afea-c8c8fd4a52ee,"RC_DW_WC_BossFight_Lizards_PossessedSourcerer");
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_01_a48b8e36-5c99-4ef9-a0c8-b3906fed9eab,"RC_DW_WC_BossFight_Elves_PossessedSourcerer");
		
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_7443355b-750f-45b6-9989-f3dedcbde92d,CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_Ghost_d2925342-9e20-4be5-af78-2f5164d3b539,"RC_DW_WC_BossFight_Dwarves_PossessedSourcerer_Ghost");
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_69b23183-48f6-45cb-afea-c8c8fd4a52ee,CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_Ghost_2abadf45-6d65-4cdc-a244-d428eed3245c,"RC_DW_WC_BossFight_Lizards_PossessedSourcerer_Ghost");
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_163d7085-670d-40aa-b602-157b28cada00,CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_Ghost_4ead2a72-2ce6-48c0-8033-7f21993db76c,"RC_DW_WC_BossFight_Humans_PossessedSourcerer_Ghost");
		
		DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_7443355b-750f-45b6-9989-f3dedcbde92d);
		DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_163d7085-670d-40aa-b602-157b28cada00);
		DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_69b23183-48f6-45cb-afea-c8c8fd4a52ee);
		DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_01_a48b8e36-5c99-4ef9-a0c8-b3906fed9eab);
		
		// Mordus' amulet (proof to show to Lohar)
		ItemToInventory(ITEMGUID_QUEST_RC_Amulet_Mordus_000_49de20a2-8ab8-4424-b77e-d871884faaa9,CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		DB_HasStoryEvent(ITEMGUID_QUEST_RC_Amulet_Mordus_000_49de20a2-8ab8-4424-b77e-d871884faaa9,"RC_DW_HasMordusAmulet");
		DB_GiveItemToEvent(ITEMGUID_QUEST_RC_Amulet_Mordus_000_49de20a2-8ab8-4424-b77e-d871884faaa9,"RC_DW_GiveMordusAmulet");
		
		ObjectSetFlag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"GLO_BlockRegenAfterCombat");
		
		DB_KilledPartyEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b, "QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss");
		
	}
	KB
	{
		//REGION Intro dialog & fight start triggers
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"GLO_SpotterSneaker")
		AND
		GetVarObject(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"SpottedDude",_Player)
		THEN
		ProcForceStopDialog(_Player);
		Proc_StartDialog(0,"RC_DW_WC_BossFight_ElderAtaraxian",CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Player);
		
		
		IF
		DialogEnded("RC_DW_WC_BossFight_ElderAtaraxian",_Inst)
		THEN
		Proc_RC_DW_WC_BossFight_Start();
		
		
		IF
		AttackedByObject(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,(CHARACTERGUID)_Player,_,_,_)
		AND
		DB_IsPlayer(_Player)
		THEN
		Proc_RC_DW_WC_BossFight_Start();
		
		
		IF
		CharacterReceivedDamage(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853, _, _)
		THEN
		Proc_RC_DW_WC_BossFight_Start();
		
		
		IF
		AttackedByObject((CHARACTERGUID)_Sourcerer,(CHARACTERGUID)_Player,_,_,_)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Sourcerer)
		THEN
		Proc_RC_DW_WC_BossFight_Start();
		
		
		IF
		CharacterReceivedDamage(_Sourcerer, _, _)
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Sourcerer)
		THEN
		Proc_RC_DW_WC_BossFight_Start();
		
		//END_REGION
		
		
		//REGION Fight
		
		//--- Fight start
		IF
		GlobalFlagSet("RC_DW_WC_BossFight_Started")
		THEN
		DB_RC_DW_WC_BossFightOngoing(1);
		// No more wandering after fight
		CharacterSetReactionPriority(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"DefaultWanderInTrigger",0);
		
		PROC
		Proc_RC_DW_WC_BossFight_Start()
		AND
		QueryOnlyOnce("RC_DW_WC_BossFight_ElderSpawn")
		AND
		GlobalGetFlag("RC_DW_WC_BossFight_Started",0)
		THEN
		// Needs to be able to beg for his life at the end of the battle
		CharacterSetImmortal(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1);
		// Record the current Mordus
		DB_RC_DW_WC_CurrentMordus((CHARACTERGUID)S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		ProcForceStopDialog(S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		
		PROC
		Proc_RC_DW_WC_BossFight_Start()
		AND
		GlobalGetFlag("RC_DW_WC_BossFight_Started",0)
		THEN
		GlobalSetFlag("RC_DW_WC_BossFight_Started");
		SetFaction(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"Evil NPC");
		
		PROC
		Proc_RC_DW_WC_BossFight_Start()
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Sourcerer)
		THEN
		ProcForceStopDialog(_Sourcerer);
		
		IF
		CharacterDied(_Sourcerer)
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Sourcerer)
		THEN
		NOT DB_RC_DW_WC_PossessedSourcerer(_Sourcerer);
		
		// Mordus making fun of the players when they get damaged
		IF
		AttackedByObject((CHARACTERGUID)_Player,(CHARACTERGUID)_Source,_,_,_)
		AND
		DB_RC_DW_WC_BossFightOngoing(1)
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Source)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_RC_DW_WC_CurrentMordus(_Mordus)
		AND
		CombatGetIDForCharacter(_Mordus,_CombatID)
		AND
		CombatGetIDForCharacter(_Player,_CombatID)
		AND
		Random(5,_Rand)
		AND
		_Rand == 0
		THEN
		Proc_StartDialog(1,"RC_DW_WC_AD_BossFight_MordusPlayerHurtByPossessedSourcerer",_Mordus);
		
		//END_REGION
		
		//REGION Transformation of Mordus into giant insect
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_MordusFightTransformationCameraShake")
		THEN
		Proc_CameraShakeAroundCharacter(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,10,16.0);
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_MordusFightTransformation")
		AND
		GetPosition(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_X,_Y,_Z)
		AND
		QueryOnlyOnce("RC_DW_WC_MordusFightTransformation")
		THEN
		Poof(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		TeleportToPosition(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,_X,_Y,_Z,"",0);
		SetOnStage(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,1);
		NOT DB_RC_DW_WC_CurrentMordus(S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		DB_RC_DW_WC_CurrentMordus(S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b);
		DB_RC_DW_WC_MordusTransforming(1);
		
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_MordusFightTransformation")
		AND
		DB_CombatCharacters(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_ID)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_CombatCharacters(_Player,_ID)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_RC_DW_ShadowOverDriftwood_FoundMordus");
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_MordusFightTransformation")
		AND
		DB_IsPlayer(_Player)
		AND
		DB_InRegion(_Player,TRIGGERGUID_S_RC_DW_WC_BossFight_Area_Box_ec8d525b-6b89-4737-a069-8067ec3ec14d)
		AND
		ObjectGetFlag(_Player,"QuestUpdate_RC_DW_ShadowOverDriftwood_FoundMordus",0)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_RC_DW_ShadowOverDriftwood_FoundMordus");
		
		
		IF
		CombatEnded(_ID)
		AND
		DB_RC_DW_WC_MordusTransforming(1)
		THEN
		// Mordus skeleton was last one in combat -> combat ended -> have to wait for new combat start when insect joins
		// before we can jump to its turn
		NOT DB_RC_DW_WC_MordusTransforming(1);
		DB_RC_DW_WC_MordusTransform_WaitForNewStart(1);
		
		IF
		ObjectEnteredCombat(S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,_ID)
		AND
		DB_RC_DW_WC_MordusTransforming(1)
		AND
		QueryOnlyOnce("RC_DW_WC_TransformedMordusEnteredCombat")
		THEN 
		NOT DB_RC_DW_WC_MordusTransforming(1);
		JumpToTurn(S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b);
		
		IF
		CombatStarted(_ID)
		AND
		DB_RC_DW_WC_MordusTransform_WaitForNewStart(1)
		AND
		DB_CombatCharacters(S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,_ID)
		AND
		QueryOnlyOnce("RC_DW_WC_TransformedMordusEnteredCombat")
		THEN
		NOT DB_RC_DW_WC_MordusTransform_WaitForNewStart(1);
		JumpToTurn(S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b);
		
		//END_REGION
		
		//REGION Mordus-the-Insect gets beaten
		IF
		CharacterDied(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b)
		THEN
		ObjectSetFlag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"GLO_BlockRegenAfterCombat");
		SetTag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"NO_ARMOR_REGEN");
		GlobalSetFlag("RC_DW_WC_BossElderIsDead");
		//END_REGION
		
		//REGION Mordus-the-skeleton gets beaten for the first time
		IF
		CharacterReceivedDamage(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853, _, _Source)
		AND
		CharacterGetHitpointsPercentage(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Percentage)
		AND
		_Percentage <= 5.0
		THEN
		ObjectSetFlag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"GLO_BlockRegenAfterCombat");
		SetTag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"NO_ARMOR_REGEN");
		GlobalSetFlag("RC_DW_WC_BossElderIsDead");
		PROC_RC_DW_MordusKilledJournalUpdate(_Source);
		SetFaction(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"Neutral");
		
		// For the insect this is handled via DB_KilledPartyEvent, but since Mordus does not die, we have to check here
		PROC
		PROC_RC_DW_MordusKilledJournalUpdate((GUIDSTRING)_Source)
		AND
		DB_CombatCharacters(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853, _ID)
		AND
		DB_IsPlayer(_Player)
		AND
		DB_CombatCharacters(_Player, _ID)
		THEN
		PartySetFlag(_Player, "QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss");
		
		// Killed outside combat
		PROC
		PROC_RC_DW_MordusKilledJournalUpdate((GUIDSTRING)_Source)
		AND
		CharacterIsPlayer((CHARACTERGUID)_Source, 1)
		THEN
		PartySetFlag((CHARACTERGUID)_Source, "QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss");
		
		//END_REGION
		
		//REGION End of battle (either skeleton mordus, or giant insect mordus)
		// Remaining possessed sourcerers die/explode
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_RC_DW_WC_PossessedSourcerer(_Sourcerer)
		THEN
		CharacterDie(_Sourcerer,0,"Explode");
		
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		THEN
		NOT DB_RC_DW_WC_BossFightOngoing(1);
		
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_RC_DW_WC_CurrentMordus(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853)
		THEN
		NOT DB_RC_DW_WC_CurrentMordus(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_RC_DW_WC_CurrentMordus(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b)
		AND
		GetPosition(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,_X,_Y,_Z)
		THEN
		Poof(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b);
		CreateSurfaceAtPosition(_X,_Y,_Z,"SurfaceNone",2.0,-1.0);
		TeleportToPosition(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_X,_Y,_Z,"",0);
		SetOnStage(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1);
		NOT DB_RC_DW_WC_CurrentMordus(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b);
		
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		THEN
		SetFaction(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"Neutral");
		SetCanJoinCombat(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,0);
		PROC_RemoveDialogFromCharacter(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853);
		SetHasDialog(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1);
		ProcObjectTimer(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_RealMordusSpawned",500);
		PROC_RC_DW_WC_BossFight_EndQuest();
		
		PROC
		PROC_RC_DW_WC_BossFight_EndQuest()
		AND
		QRY_RC_DW_WC_GetMordusCombatID()
		AND
		DB_RC_DW_WC_MordusCombatID(_ID)
		AND
		IsCombatActive(_ID,1)
		THEN
		EndCombat(_ID);
		
		PROC
		PROC_RC_DW_WC_BossFight_EndQuest()
		AND
		DB_RC_DW_WC_MordusCombatID(_ID)
		THEN
		NOT DB_RC_DW_WC_MordusCombatID(_ID);
		
		PROC
		PROC_RC_DW_WC_BossFight_EndQuest()
		THEN
		ProcTriggerRegisterForPlayers(TRIGGERGUID_S_RC_DW_WC_BossFight_Area_Box_ec8d525b-6b89-4737-a069-8067ec3ec14d);
		GoalCompleted;
		//END_REGION
		
		PROC
		ProcRegionEnded("RC_Main")
		THEN
		GoalCompleted;
		
	}
	EXIT
	{
		NOT DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,"RC_DW_WC_BossFight_ElderAtaraxian");
		NOT DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_BossFight_Mordus");
		NOT DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_7443355b-750f-45b6-9989-f3dedcbde92d,"RC_DW_WC_BossFight_Dwarves_PossessedSourcerer");
		NOT DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_163d7085-670d-40aa-b602-157b28cada00,"RC_DW_WC_BossFight_Humans_PossessedSourcerer");
		NOT DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_69b23183-48f6-45cb-afea-c8c8fd4a52ee,"RC_DW_WC_BossFight_Lizards_PossessedSourcerer");
		
		NOT DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Mage_01_7443355b-750f-45b6-9989-f3dedcbde92d);
		NOT DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Warrior_01_163d7085-670d-40aa-b602-157b28cada00);
		NOT DB_RC_DW_WC_PossessedSourcerer((CHARACTERGUID)CHARACTERGUID_S_RC_DW_WC_BossFight_PossessedSourcerer_Ranger_02_69b23183-48f6-45cb-afea-c8c8fd4a52ee);
		
	}
}
Goal(448).Title("RC_DW_WreckersCave");
Goal(448)
{
	INIT
	{
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7,"RC_DW_WC_TraumatizedDwarf");
		
		//REGION Possessed dwarves
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5,"RC_DW_WC_BarrelChamber_PossessedDwarf_000");
		DB_DoNotFace(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5);
		// they're evil, but become good after Mordus is dead in case they haven't been killed
		DB_Dialogs(CHARACTERGUID_S_RC_WC_PossessedDwarf_01_a6ebba9d-2b70-4f04-b0d0-56d7581548d6,"RC_DW_WC_PossessedDwarf_01");
		DB_Dialogs(CHARACTERGUID_S_RC_WC_PossessedDwarf_02_3b1417dc-b796-4b38-975e-4c3f33baf5c6,"RC_DW_WC_PossessedDwarf_02");
		
		DB_RC_WC_PossessedDwarves((CHARACTERGUID)S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5);
		DB_RC_WC_PossessedDwarves(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1);
		DB_RC_WC_PossessedDwarves(CHARACTERGUID_S_RC_WC_PossessedDwarf_01_a6ebba9d-2b70-4f04-b0d0-56d7581548d6);
		DB_RC_WC_PossessedDwarves(CHARACTERGUID_S_RC_WC_PossessedDwarf_02_3b1417dc-b796-4b38-975e-4c3f33baf5c6);
		ApplyStatus(S_RC_WC_PossessedDwarf_01_a6ebba9d-2b70-4f04-b0d0-56d7581548d6,"POSSESSED",-1.0); 
		ApplyStatus(S_RC_WC_PossessedDwarf_02_3b1417dc-b796-4b38-975e-4c3f33baf5c6,"POSSESSED",-1.0);
		//END_REGION
		
		//REGION Entrance
		DB_OneShotPlayerTrigger((TRIGGERGUID)TRIGGERGUID_S_RC_DW_WC_EntranceVB_Box_579ad1fa-ebfb-4e24-ba12-158fc860db73);
		ProcTriggerRegisterForPlayers((TRIGGERGUID)TRIGGERGUID_S_RC_DW_WC_FoundTerrifiedDwarf_Box_c8cfce90-a56d-4af7-b396-f72d7e7293fa);
		ProcTriggerRegisterForPlayers(TRIGGERGUID_S_RC_DW_WC_Entrance_Box_1cf4ecef-a6a4-4471-9a3e-aad9367e1326);
		
		CharacterSetAnimationOverride(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7,"cower");
		DB_IgnoreAssault(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7);
		ProcCharacterDisableAllCrimes(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7);
		
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_DwarfBase_Rat_3d147173-a520-431c-bf3e-6d5ce7dcfd51,"RC_DW_WC_AmbushRat");
		
		//--- Ghosts at entrance
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_DwarfCorpse_01_d4d33255-81d9-4be4-bd48-88b8a99d6aa9,CHARACTERGUID_S_RC_DW_WC_DwarfGhost_01_4f6e6b8d-2b69-4032-8c5c-e737d38c7474,"RC_DW_WC_DwarfGhost_01");
		DB_Ghosts(CHARACTERGUID_S_RC_WC_DwarfCorpse_02_e5b03109-346c-4a12-8454-b8061257ac17,CHARACTERGUID_S_RC_DW_WC_DwarfGhost_02_d3033da6-baed-43e1-8d75-90633d902628,"RC_DW_WC_DwarfGhost_02");
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_DwarfCorpse_03_dc7b75f4-e6ce-45b5-9c34-dba9fc1bd353,CHARACTERGUID_S_RC_DW_WC_DwarfGhost_03_55b48f76-a3d7-4dd9-80cd-68c639b3bfe5,"RC_DW_WC_DwarfGhost_03");
		DB_Ghosts(CHARACTERGUID_S_RC_DW_WC_DwarfCorpse_07_16d8e7b8-96b8-418d-93d4-e75e87ad70fb,CHARACTERGUID_S_RC_DW_WC_DwarfGhost_07_68334b40-3e7c-4084-941f-35f3c1622de6,"RC_DW_WC_DwarfGhost_07");
		CharacterSetAnimationOverride(CHARACTERGUID_S_RC_DW_WC_DwarfGhost_01_4f6e6b8d-2b69-4032-8c5c-e737d38c7474,"cower");
		CharacterSetAnimationOverride(CHARACTERGUID_S_RC_DW_WC_DwarfGhost_03_55b48f76-a3d7-4dd9-80cd-68c639b3bfe5,"cower");
		//END_REGION
		
		//REGION AMBUSH (parts that are permanent even after turn-based ambush is over)
		DB_BidirShovelPileTunnel("RC_WC_TunnelFallback",TRIGGERGUID_S_RC_WC_Tunnel_Dig_Box_c0eb36c8-f133-4281-b3bf-7040571710f8,ITEMGUID_S_RC_WC_PUZ_SandWhitepile_Tunnel_9b191cb5-53cb-4a40-bc54-b5789ca21710,ITEMGUID_S_RC_WC_TunnelFallback_f300b6a2-68c2-456d-a6eb-57c0d5f198ac,TRIGGERGUID_S_RC_WC_TunnelDest_Dig_Box_e955eeba-2543-4424-b743-2ef72e491cde,ITEMGUID_S_RC_WC_PUZ_DirstWhitepile_TunnelDest_ad6f6d4e-dd3e-41e3-a838-81fcfd5aed21,ITEMGUID_S_RC_WC_TunnelFallback_Destination_c4f3d32d-88ca-4605-b03b-24078d4d71cf);
		
		// Fallback tunnel only gets placed on stage after a player has been abducted or an insect has been killed
		SetOnStage(ITEMGUID_S_RC_WC_PUZ_SandWhitepile_Tunnel_9b191cb5-53cb-4a40-bc54-b5789ca21710,0);
		
		// Rat in weapons chamber
		DB_Dialogs(CHARACTERGUID_S_RC_DW_WC_WeaponsChamberRat_4a92ad6a-4427-4034-957b-cbc7c2364de6,"RC_DW_WC_WeaponsChamberRat");
		//END_REGION
		
		//REGION Main 
		//--- Teleport dirt pile
		DB_ShovelArea(TRIGGERGUID_S_WeaponChamber_BoxTrigger_A_IN_a9a6b9e4-1f52-4409-bda0-6286110c14ab,"RC_DW_WC_WeaponChamber_A_IN",ITEMGUID_S_WeaponChamber_PUZ_Dirtpile_A_IN_298465bb-81de-4a66-aa91-e991f67fb00c);
		DB_ShovelRewardItemSpawn("RC_DW_WC_WeaponChamber_A_IN",ITEMGUID_S_WeaponChamber_Hole_A_IN_ebd86627-edae-42fe-88f2-10fd3a814a7c);
		DB_ShovelArea(TRIGGERGUID_S_WeaponChamber_BoxTrigger_A_OUT_a350415e-c07b-4f72-86d6-acaf3f121763,"RC_DW_WC_WeaponChamber_A_OUT",ITEMGUID_S_WeaponChamber_PUZ_Dirtpile_A_OUT_68c873d1-ef4a-404b-a3e5-505fe3a85293);
		DB_ShovelRewardItemSpawn("RC_DW_WC_WeaponChamber_A_OUT",ITEMGUID_S_WeaponChamber_Hole_A_OUT_73392949-a759-4443-a3d1-832a11a7e66b);
		
		DB_ShovelArea(TRIGGERGUID_S_RC_DW_WC_BoxTrigger_A_IN_000_9fc749d3-6fd8-4412-95a9-0851d9812f81,"RC_DW_WC_A_IN_000",ITEMGUID_S_RC_DW_WC_PUZ_Dirtpile_A_IN_000_73369595-4758-433a-97ae-64e785395e36);
		DB_ShovelRewardItemSpawn("RC_DW_WC_A_IN_000",ITEMGUID_S_RC_DW_WC_Hole_A_IN_000_7a2f5f99-8754-4cc5-8ba8-c966ff164938);
		DB_ShovelArea(TRIGGERGUID_S_RC_DW_WC_BoxTrigger_A_OUT_000_6daff452-cccd-432a-84a7-eb3ba24a490e,"RC_DW_WC_A_OUT_000",ITEMGUID_S_RC_DW_WC_PUZ_Dirtpile_A_OUT_000_21f2aa00-c380-4044-b5dd-ead45f6c761f);
		DB_ShovelRewardItemSpawn("RC_DW_WC_A_OUT_000",ITEMGUID_S_RC_DW_WC_Hole_A_OUT_000_e22dfc76-dd69-46f4-b42a-e769a1f0e0fc);
		
		DB_RC_DW_WC_TeleportTunnels(ITEMGUID_S_WeaponChamber_Hole_A_IN_ebd86627-edae-42fe-88f2-10fd3a814a7c, "RC_DW_WC_WeaponChamber_A_OUT");
		DB_RC_DW_WC_TeleportTunnels(ITEMGUID_S_WeaponChamber_Hole_A_OUT_73392949-a759-4443-a3d1-832a11a7e66b,"RC_DW_WC_WeaponChamber_A_IN");
		DB_RC_DW_WC_TeleportTunnels(ITEMGUID_S_RC_DW_WC_Hole_A_IN_000_7a2f5f99-8754-4cc5-8ba8-c966ff164938, "RC_DW_WC_A_OUT_000");
		DB_RC_DW_WC_TeleportTunnels(ITEMGUID_S_RC_DW_WC_Hole_A_OUT_000_e22dfc76-dd69-46f4-b42a-e769a1f0e0fc,"RC_DW_WC_A_IN_000");
		
