		DB_RC_DW_WC_Achievement_EggItem((ITEMGUID)ITEMGUID_S_RC_WC_Voideggs_Eggcluster_Big_C_002_b6751b33-efda-44d8-8bab-9804e147f931);
		DB_RC_DW_WC_Achievement_EggItem((ITEMGUID)ITEMGUID_S_RC_WC_Voideggs_Eggcluster_Big_C_003_26209629-ccd9-4094-a94f-bded74ee6cdb);
		DB_RC_DW_WC_Achievement_EggItem((ITEMGUID)ITEMGUID_S_RC_WC_Voideggs_Eggcluster_Big_C_004_e5988574-c691-4ced-8f18-8689007d5d9d);
		
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_000_6d8dbcff-c2b6-4cbd-92b7-348fd147dd33);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_001_f5811106-6bc6-43ff-a4cb-03010394917c);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_002_96ae9871-4405-4f8f-bcab-59427804f254);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_003_6c2540f5-a42a-4355-876f-7600b88efd15);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_004_080cdbe8-8f46-4dc1-881f-05fa04de672d);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_005_a7eb058f-590c-4327-8e37-5714dfbdb914);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_006_0ec0bf24-7d71-417c-8434-4cdf1d1ecd90);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_007_7c8aa22b-baa6-4f73-9561-24ec1e001a92);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_008_aa123b86-1b92-4ac9-a8b3-a77a96a57be1);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_009_10e369b2-1c9f-4d97-8e8a-5cbefb2d18bc);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_010_29ec45b6-5d02-428d-b4cc-bd572faa094b);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_011_69597683-7484-43f3-92e2-a89eddbc1fde);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_012_dfa34f71-0bca-47af-ac62-c50c3711b85d);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_013_51badf36-da46-4d7d-8b1c-8eabbbec8c0e);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_014_696f6010-bbdf-429c-a3b4-57bd76dc8df4);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_015_7786fee9-c989-4520-8650-a9ee81a7ed10);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_016_28523381-3a65-47ac-98b0-ec960f9c4144);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_017_860ba686-9083-44d4-875a-9d863c4fc7a3);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_018_93f74569-ec35-4453-bd19-4eb9ba5e9903);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_A_019_5a14aa35-f277-40fa-aa0c-13ddf6808570);
		
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_000_b29e52fc-028f-4b56-85d2-ca5cdc7703cb);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_001_cb5876ee-65b5-4e58-aae8-888d8738087a);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_002_ae1dad86-9320-4458-b72c-7fe1ade39abc);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_003_23a5ba3c-de3a-4f0e-b662-763447a2489a);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_004_95bc2935-e3b0-4075-9a16-ed72211a6f9f);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_005_193aa3b5-1581-4f2f-852f-edab16e0c2d4);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_006_e59504be-6629-474c-8b3a-a332d9c4f611);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_007_2285b0a4-2a6d-423f-bb51-f5a10318ef0d);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_008_4f899baa-0241-4faa-bdf7-f280454ed1e8);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_009_5cbaa6cb-d976-4a49-8388-4589e8a53f2a);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_010_15b33102-e339-49c9-a21c-c5d806db59e7);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_011_24cf97da-b697-4598-9fb3-fa3f26eca10e);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_012_8feb6084-6c31-4317-8002-b254fc0d3055);
		DB_RC_DW_WC_Achievement_EggChar((CHARACTERGUID)CHARACTERGUID_S_RC_WC_Voideggs_Big_B_Explo_013_1e1db26e-16da-478f-9f69-3df11cb91e62);
		
		//END_REGION
		
	}
	KB
	{
		//REGION Debug
		
		//DOSTWO-9488
		IF
		TextEventSet("rc_dw_wc_teleport1")
		THEN
		// This character is offstage
		TeleportTo(S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,ITEMGUID_S_RC_DW_WC_AmbushInsect_Helper_01_43c2ffd3-96fb-4bd4-9435-33cf12e44b16,"rc_dw_teleportevent",0);
		
		IF
		StoryEvent(S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,"rc_dw_teleportevent")
		THEN
		DebugBreak("Got off-stage character teleport event");
		
		
		//Burrowing/unburrowing
		IF
		TextEventSet("rc_dw_wc_unburrow1")
		AND
		DB_RC_DW_WC_AmbushUnburrowingHelper((CHARACTERGUID)S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,_EffectHelper)
		THEN
		SetCanJoinCombat(S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,0);
		PROC_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,_EffectHelper,"rc_dw_wc_debugunburrow1finished","Unburrow");
		
		IF
		StoryEvent(_Insect,"rc_dw_wc_debugunburrow1finished")
		THEN
		DebugText(_Insect,"Finished unburrowing");
		
		IF
		TextEventSet("rc_dw_wc_burrow1")
		AND
		DB_RC_DW_WC_AmbushBurrowingHelper((CHARACTERGUID)S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,_EffectHelper)
		THEN
		PROC_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,_EffectHelper,"rc_dw_wc_debugburrow1finished","Burrow");
		
		IF
		StoryEvent(_Insect,"rc_dw_wc_debugunburrow1finished")
		AND
		DB_RC_DW_WC_AmbushBurrowingHelper((CHARACTERGUID)S_RC_DW_WC_AmbushInsect_01_2a1d57f6-22e7-4f2c-86f2-108f7cec8c55,_ItemHelper)
		THEN
		DebugText(_ItemHelper,"Finished burrowing");
		//END_REGION
		
		//REGION init
		
		IF
		DB_RC_DW_VoidwokenIndivFight(_Trigger,_,_Creature)
		THEN
		DB_OneShotPlayerTrigger(_Trigger);
		SetOnStage(_Creature,0);
		
		
		// Source collars on corpses
		// (this goal is a subgoal of RC_DW_WreckersCaveBase, which completes when characters enter triggers;
		//  that happens by definition after GameStarted -> okay to play visual effects here)
		IF
		DB_RC_DW_WC_CollaredCorpse(_Corpse)
		AND
		NOT DB_RC_DW_WC_CollaredCorpse_OncePerCorpse((CHARACTERGUID)_Corpse)
		THEN
		DB_RC_DW_WC_CollaredCorpse_OncePerCorpse(_Corpse);
		PROC_LoopEffect("RS3_FX_GP_Status_HoECollar_01",_Corpse,"RC_DW_WC_SourceCollar","RC_Main","Dummy_NeckFX");
		
		//END_REGION
		
		//REGION Burrowing/unburrowing Helpers
		
		// _Action: "Burrow" (disappear) or "Unburrow" (appear/spawn)
		PROC
		PROC_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)_Insect,(ITEMGUID)_EffectHelper,(STRING)_FinishEvent,(STRING)_Action)
		AND
		StringConcatenate(_FinishEvent,"__TeleportFinished",_TeleportFinishEvent)
		THEN
		DB_RC_DW_WC_BurrowGiantInsect(_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,_Action);
		TeleportTo(_EffectHelper,_Insect,_TeleportFinishEvent,0);
		
		IF
		StoryEvent((ITEMGUID)_EffectHelper,_TeleportFinishEvent)
		AND
		DB_RC_DW_WC_BurrowGiantInsect(_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,_)
		THEN
		PROC_LoopEffect("RS3_FX_Char_Creatures_VoidWoken_Drillworm_A_Hole_Root_01",_EffectHelper,_FinishEvent,"RC_Main","Dummy_FX");
		
		IF
		StoryEvent((ITEMGUID)_EffectHelper,_TeleportFinishEvent)
		AND
		DB_RC_DW_WC_BurrowGiantInsect(_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,"Unburrow")
		THEN
		CharacterAppear(_Insect,1,_FinishEvent);
		
		IF
		StoryEvent((ITEMGUID)_EffectHelper,_TeleportFinishEvent)
		AND
		DB_RC_DW_WC_BurrowGiantInsect(_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,"Burrow")
		THEN
		SetScriptframe(_Insect,"DigIn");
		
		IF
		StoryEvent((CHARACTERGUID)_Insect,"RC_DW_WC_FinishedDiggingIn")
		AND
		DB_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,"Burrow")
		THEN
		ClearScriptframe(_Insect);
		SetStoryEvent(_Insect,_FinishEvent);
		
		IF
		StoryEvent((CHARACTERGUID)_Insect,_FinishEvent)
		AND
		DB_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,"Burrow")
		THEN
		SetOnStage(_Insect,0);
		// May have been disabled in case the insect burrowed because its abductee died
		SetCanJoinCombat(_Insect,1);
		
		IF
		StoryEvent((CHARACTERGUID)_Insect,_FinishEvent)
		AND
		DB_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,_Command)
		THEN
		NOT DB_RC_DW_WC_BurrowGiantInsect((CHARACTERGUID)_Insect,_EffectHelper,_FinishEvent,_TeleportFinishEvent,_Command);
		PROC_StopLoopEffect(_EffectHelper,_FinishEvent);
		
		//END_REGION
		
		
		//REGION Cave entrance, VBs, ADs
		
		// No CharacterEnteredTrigger(), because that is caught for the first player/party by the
		// parent goal
		IF
		DB_InRegion(_Player,TRIGGERGUID_S_RC_DW_WreckersCave_Box_759f16fa-f59d-4686-b052-b598f2f2410a)
		AND
		GlobalGetFlag("RC_DW_WC_BossElderIsDead",0)
		AND
		GlobalGetFlag("RC_DW_WC_BossFight_BossFlee",0)
		THEN
		ObjectSetFlag(_Player, "QuestUpdate_RC_DW_WC_AtaraxianLair_EnteredWreckersCave");
		
		
		PROC
		ProcOneShotTriggerEntered(_Player, TRIGGERGUID_S_RC_DW_WC_EntranceVB_Box_579ad1fa-ebfb-4e24-ba12-158fc860db73)
		THEN
		StartVoiceBark("RC_DW_WC_VB_EnteredWreckersCave",_Player);
		
		
		// Terrified dwarf
		IF
		CharacterEnteredTrigger(_Player,TRIGGERGUID_S_RC_DW_WC_FoundTerrifiedDwarf_Box_c8cfce90-a56d-4af7-b396-f72d7e7293fa)
		AND
		QueryOnlyOnce("RC_DW_WC_VB_FoundDwarfBase")
		THEN
		StartVoiceBark("RC_DW_WC_VB_FoundDwarfBase",_Player);
		
		IF
		CharacterReceivedDamage(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7, _, _)
		THEN
		ProcRCCoweringDwarfRunAway();
		
		IF
		CharacterPickpocketFailed(_,CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7)
		THEN
		ProcRCCoweringDwarfRunAway();
		
		PROC
		ProcRCCoweringDwarfRunAway()
		THEN
		CharacterSetAnimationOverride(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7,"");
		CharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_WC_TraumatizedDwarf_e293e0a9-fe49-4dd7-8370-11a1832c3cc7,75,1,"",0);
		
		
		// Collared corpse
		IF
		CharacterLootedCharacterCorpse(_Player,CHARACTERGUID_S_RC_DW_WC_CollaredCorpse_004_3bbbcb33-d156-4721-b985-6f731488d187)
		AND
		QueryOnlyOnce("RC_DW_WC_VB_FoundCollaredCorpse")
		THEN
		StartVoiceBark("RC_DW_WC_VB_FoundCollaredCorpse",_Player);
		
		
		//END_REGION
		
		
		//REGION Preambush - child scream - greeting voidwoken
		
		IF
		CharacterReceivedDamage(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5, _, _)
		AND
		QueryOnlyOnce("RC_DW_WC_EntranceVoidwokenLeave")
		AND
		GetClosestAlivePlayer(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,_Player,_)
		THEN
		CharacterMoveTo(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,TRIGGERGUID_S_RC_DW_WC_Entrance_GiantInsect_Point_000_27ff0f5f-6820-496f-8d6a-004563855f03,0,"RC_DW_WC_EntranceVW_MovedToPoint_000", 0);
		StartVoiceBark("RC_DW_WC_VB_EntranceVoidwokenLeaving",_Player);
		
		IF
		CharacterLeftTrigger(_Player, TRIGGERGUID_S_RC_DW_WC_Entrance_Box_1cf4ecef-a6a4-4471-9a3e-aad9367e1326)
		AND
		QRY_AnyRegionActive()
		AND
		DB_InRegion(_Player,TRIGGERGUID_S_RC_DW_WreckersCave_Box_759f16fa-f59d-4686-b052-b598f2f2410a)
		AND
		QueryOnlyOnce("RC_DW_WC_EntranceVoidwokenLeave")
		THEN
		ProcTriggerUnregisterForPlayers(TRIGGERGUID_S_RC_DW_WC_Entrance_Box_1cf4ecef-a6a4-4471-9a3e-aad9367e1326);
		CharacterLookAt(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,_Player);
		CharacterMoveTo(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,TRIGGERGUID_S_RC_DW_WC_Entrance_GiantInsect_Point_000_27ff0f5f-6820-496f-8d6a-004563855f03,0,"RC_DW_WC_EntranceVW_MovedToPoint_000", 0);
		StartVoiceBark("RC_DW_WC_VB_EntranceVoidwokenLeaving",_Player);
		
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,"RC_DW_WC_EntranceVW_MovedToPoint_000")
		AND
		GetClosestAlivePlayer(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,_Player,_)
		THEN
		CharacterMoveTo(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,TRIGGERGUID_S_RC_DW_WC_Entrance_GiantInsect_Point_001_f554ae35-6d75-4da2-befb-29f5ce4d8285,0,"RC_DW_WC_EntranceVW_MovedToPoint_001",0);
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,"RC_DW_WC_EntranceVW_MovedToPoint_001")
		THEN
		PROC_RC_DW_WC_BurrowGiantInsect(CHARACTERGUID_S_RC_DW_WC_Entrance_GiantInsect_000_a11bf16f-ae85-40ab-9b19-c5ecedf342e5,S_RC_DW_WC_EntranceInsect_BurrowingHelper_d6d08324-021f-45d4-ac40-bf7ee6f65197,"DB_RC_DW_WC_EntranceVW_Burrowed","Burrow");
		
		// Traumatised dwarf
		IF
		DialogEnded("RC_DW_WC_TraumatizedDwarf",_ID)
		AND
		DB_InRegion(_Player,TRIGGERGUID_S_RC_DW_WC_VB_FoundTerrifiedDwarf_Box_c8cfce90-a56d-4af7-b396-f72d7e7293fa)
		AND
		CharacterIsDead(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,0)
		THEN
		ObjectSetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_FoundTerrifiedDwarf");
		
		
		//END_REGION
		
		//REGION Turn-based Ambush
		
		// Ensure this is only said by a player that saw the original ambush
		PROC
		ProcBidirShovelTunnelOpenedOnSide(_Player,"RC_WC_TunnelFallback",1)
		AND
		DB_IsPlayer(_MeOrOtherPlayer)
		AND
		ObjectGetFlag(_MeOrOtherPlayer,"RC_DW_WC_SawInsectSpawn",1)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Player,_MeOrOtherPlayer)
		AND
		QueryOnlyOnce("RC_DW_WC_CommentHiddenTunnel")
		THEN
		StartVoiceBark("RC_DW_WC_VB_FoundTunnelFallback",_MeOrOtherPlayer);
		
		//END_REGION
		
		//REGION Separate chambers / indiv ambush
		
		PROC
		ProcOneShotTriggerEntered(_Player, _Trigger)
		AND
		DB_RC_DW_VoidwokenIndivFight(_Trigger,_SpawnPoint,_Voidwoken)
		AND
		DB_RC_DW_VoidwokenIndivUnburrowHelper(_Voidwoken,_EffectHelper)
		THEN
		TeleportTo(_EffectHelper,_SpawnPoint);
		PROC_RC_DW_WC_BurrowGiantInsect(_Voidwoken,_EffectHelper,"RC_DW_WC_InsectIndividualFight","Unburrow");
		
		PROC
		ProcOneShotTriggerEntered(_Player, _Trigger)
		AND
		DB_RC_DW_VoidwokenIndivFight(TRIGGERGUID_S_RC_DW_WC_VoidwokenIndivFight_Box_004_7cc4a550-fd19-497c-9039-c008806647f0,_,_)
		AND
		ObjectGetFlag(_Player,"RC_DW_WC_HaveBeenAbductedBefore",1)
		THEN
		StartVoiceBark("RC_DW_WC_VB_SeeVoidwokenSpawnOutsideWeaponsChamber",(CHARACTERGUID)_Player);
		
		// Weapon chamber
		IF
		CharacterUsedItem(_Player,_Chest)
		AND
		DB_RC_DW_WC_SourceWeaponChest(_Chest)
		AND
		QueryOnlyOnce("RC_DW_WC_AD_WeaponChamber_SourceWeaponChest")
		THEN
		Proc_StartDialog(1,"RC_DW_WC_AD_WeaponChamber_SourceWeaponChest",_Player);
		
		
		// barrel chamber
		PROC
		PROC_RC_DW_WC_BarrelChamber_SetAlignment()
		AND
		GlobalGetFlag("RC_DW_WC_BossElderIsDead",0)
		AND
		QueryOnlyOnce("RC_DW_WC_BarrelChamberFightStart")
		THEN
		RemoveStatus(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5,"CURSED");
		ApplyStatus(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5,"POSSESSED",-1.0);
		SetFaction(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5,"Evil NPC");
		CharacterAppear(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1,1,"");
		ApplyStatus(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1,"POSSESSED",-1.0);
		
		IF
		DialogEnded("RC_DW_WC_BarrelChamber_PossessedDwarf_000",_)
		THEN
		PROC_RC_DW_WC_BarrelChamber_SetAlignment();
		
		IF
		ObjectEnteredCombat(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_f40e9760-f9aa-43bc-8f3a-e8106599a9e5,_)
		THEN
		PROC_RC_DW_WC_BarrelChamber_SetAlignment();
		//END_REGION
		
		//REGION Possessed Dwarves after Mordus dies
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_RC_WC_PossessedDwarves(_Dwarf)
		AND
		NOT DB_Dead(_Dwarf)
		THEN
		NOT DB_DoNotFace(_Dwarf);
		RemoveStatus(_Dwarf,"CURSED");
		RemoveStatus(_Dwarf,"POSSESSED");
		SetFaction(_Dwarf,"Good");
		
		IF
		ObjectFlagSet("RC_DW_WC_PossessedDwarf_000_LookAtShadow",(CHARACTERGUID)_Dwarf,_)
		THEN
		CharacterLookAt(_Dwarf,TRIGGERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_000_LookAtPoint_3c4d7028-400e-47f3-a2d6-5296f8569599);
		
		// In case they're fighting just against players (if they're in the combat
		// with the eggs, they will rejoin on the side of the players) 
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_RC_WC_PossessedDwarves(_Dwarf)
		AND
		CharacterIsInCombat(_Dwarf,1)
		THEN
		LeaveCombat(_Dwarf);
		
		//Make sure dwarves don't remember players, if they had contact while POSSESSED
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		DB_IsPlayer(_Char)
		AND
		DB_RC_WC_PossessedDwarves(_Dwarf)
		AND
		NOT DB_Dead(_Dwarf)
		THEN
		ChangeAttitude(_Dwarf,_Char,0);
		
		// Spawned dwarf immediately runs away
		IF
		GlobalFlagSet("RC_DW_WC_BossElderIsDead")
		AND
		ObjectIsOnStage(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1,1)
		AND
		NOT DB_Dead(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1)
		THEN
		NOT DB_RC_WC_PossessedDwarves(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1);
		CharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_WC_BarrelChamber_PossessedDwarf_001_579d36bf-8118-4548-bdc7-687f5aa3e3f1,90,0,"",0);
		
		// Rest leaves when last player has left the Wrecker's cave
		IF
		CharacterLeftTrigger(_Player,TRIGGERGUID_S_RC_DW_WreckersCave_Box_759f16fa-f59d-4686-b052-b598f2f2410a)
		AND
		QRY_AnyRegionActive()
		AND
		NOT DB_InRegion(_,TRIGGERGUID_S_RC_DW_WreckersCave_Box_759f16fa-f59d-4686-b052-b598f2f2410a)
		AND
		DB_RC_WC_PossessedDwarves(_Dwarf)
		AND
		GlobalGetFlag("RC_DW_WC_BossElderIsDead",1)
		AND
		NOT DB_Dead(_Dwarf)
		AND
		ObjectIsOnStage(_Dwarf,1)
		THEN
		NOT DB_RC_WC_PossessedDwarves(_Dwarf);
		CharacterDisappearOutOfSight(_Dwarf,90,0,"",0);
		
		IF
		DB_Dead(_Dwarf)
		AND
		DB_RC_WC_PossessedDwarves(_Dwarf)
		AND
		GlobalGetFlag("RC_DW_WC_BossElderIsDead",1)
		THEN
		ObjectSetFlag(_Dwarf,"RC_WC_DiedWhileNoLongerPossessed");
		//END_REGION
		
		
		//REGION Dwarven Scholars
		IF
		GlobalFlagSet("RC_WC_RevealVault")
		THEN
		SetStoryEvent(ITEMGUID_S_RC_WC_SecretVault_b08917da-fad5-4e2b-a1c8-4ff39ad05259, "StoryReveal");
		
		IF
		DialogEnded("RC_DW_DwarvenScholar1", _)
		AND
		GlobalGetFlag("RC_WC_ScholarsFlee", 1)
		THEN
		DialogRequestStop(CHARACTERGUID_S_RC_DW_DwarvenScholar_01_2555841d-a987-4c92-b87e-93c829e8fed0);
		DialogRequestStop(CHARACTERGUID_S_RC_DW_DwarvenScholar_02_f2bd4946-8aba-42be-b70a-b8a6d48fce47);
		ProcCharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_DwarvenScholar_01_2555841d-a987-4c92-b87e-93c829e8fed0, 0, 1, "", 0);
		ProcCharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_DwarvenScholar_02_f2bd4946-8aba-42be-b70a-b8a6d48fce47, 0, 1, "", 0);
		
		IF
		DialogEnded("RC_DW_DwarvenScholar2", _)
		AND
		GlobalGetFlag("RC_WC_ScholarsFlee", 1)
		THEN
		DialogRequestStop(CHARACTERGUID_S_RC_DW_DwarvenScholar_01_2555841d-a987-4c92-b87e-93c829e8fed0);
		DialogRequestStop(CHARACTERGUID_S_RC_DW_DwarvenScholar_02_f2bd4946-8aba-42be-b70a-b8a6d48fce47);
		ProcCharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_DwarvenScholar_01_2555841d-a987-4c92-b87e-93c829e8fed0, 0, 1, "", 0);
		ProcCharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_DwarvenScholar_02_f2bd4946-8aba-42be-b70a-b8a6d48fce47, 0, 1, "", 0);
		
		IF
		ObjectFlagSet("RC_WC_ShowSecretVault", _Player, _)
		THEN
		ProcShowMarker((CHARACTERGUID)_Player, "RC_WC_SecretVault");
		//END_REGION
		
		
		//REGION Teleport paths, holes & dirtpile 
		
		IF
		CharacterUsedItem(_Player,_Hole)
		AND
		DB_RC_DW_WC_TeleportTunnels(_Hole,_Target)
		AND
		DB_ShovelArea(_TargetBox,_Target,_TargetPile)
		THEN
		NOT DB_ShovelArea(_TargetBox,_Target,_TargetPile);
		SetOnStage(_TargetPile,0);
		PlayEffect(_TargetPile,"RS3_FX_GP_ScriptedEvent_Teleport_GenericSmoke_01");
		ProcShovelRewards(_Player,_Target);
		
		
		// Prison:
		IF
		CharacterUsedItem(_Player,ITEMGUID_S_RC_DW_WC_Prison_Hole_A_IN_13acb4b7-d86c-4f94-9dc5-dfa8aec87bba)
		AND
		QueryOnlyOnce("RC_DW_WC_Prison_Hole_A_OUT_SetOnStage")
		THEN
		SetOnStage(ITEMGUID_S_RC_DW_WC_Prison_Hole_A_OUT_1f42fa72-7c1e-45c1-b886-f4b528313bbb,1);
		PlayEffect(ITEMGUID_S_RC_DW_WC_Prison_Hole_A_OUT_1f42fa72-7c1e-45c1-b886-f4b528313bbb,"RS3_FX_GP_ScriptedEvent_Teleport_GenericSmoke_01");
		
		
		//Egg chamber:
		IF
		CharacterUsedItem(_Player,ITEMGUID_S_RC_DW_WreckersCave_EggChamberOut_7ad8fec5-f79b-4be8-91b7-36d604d6d507)
		AND
		QueryOnlyOnce("RC_DW_WC_EggChamber_RevealFissure")
		THEN
		SetStoryEvent(ITEMGUID_S_RC_DW_WreckersCave_EggChamberIn_cec93e05-de99-46a3-9315-fc5032d1f213,"StoryReveal");
		
		// Weapons chamber
		IF
		ObjectFlagSet("RC_DW_WC_WeaponsChamberRatExit",(CHARACTERGUID)_Player,_)
		THEN
		ProcShowMarker(_Player,"RC_DW_WC_WeaponsChamberRatExit");
		
		// Hatch to Mordus' Office
		//IF
		//CharacterUsedItem(_Player,(ITEMGUID)S_RC_DW_WC_HatchFromMordusCaveToOffice_e52b704f-554b-4726-86f3-0cd4dd63e117)
		PROC
		ProcBlockUseOfItem(_Player,(ITEMGUID)S_RC_DW_WC_HatchFromMordusCaveToOffice_e52b704f-554b-4726-86f3-0cd4dd63e117)
		AND
		NOT DB_RC_DW_WC_HatchToMordusCave_Unlocked(1)
		THEN
		DB_CustomUseItemResponse(_Player,S_RC_DW_WC_HatchFromMordusCaveToOffice_e52b704f-554b-4726-86f3-0cd4dd63e117,0);
		PROC_RC_DW_WC_HatchToMordusCave_TryUnlock(_Player);
		
		PROC
		PROC_RC_DW_WC_HatchToMordusCave_TryUnlock((CHARACTERGUID)_Player)
		AND
		QryTakeItemFromMagicPockets(_Player,(ITEMGUID)QUEST_RC_Amulet_Mordus_000_49de20a2-8ab8-4424-b77e-d871884faaa9,_Player)
		THEN
		DB_RC_DW_WC_HatchToMordusCave_Unlocked(1);
		ItemUnLock((ITEMGUID)S_RC_DW_WC_HatchFromMordusCaveToOffice_e52b704f-554b-4726-86f3-0cd4dd63e117);
		Proc_StartDialog(1,"RC_DW_WC_AD_HatchToMordusCaveUnlocked",_Player);
		
		PROC
		PROC_RC_DW_WC_HatchToMordusCave_TryUnlock(_Player)
		AND
		NOT DB_RC_DW_WC_HatchToMordusCave_Unlocked(1)
		THEN
		Proc_StartDialog(1,"RC_DW_WC_AD_HatchToMordusCaveLocked",_Player);
		//END_REGION
		
		//REGION Learning about death fog
		IF
		ObjectFlagSet("RC_DW_WC_AskedMordusAboutDeathFogWeapons",(CHARACTERGUID)_Player,_)
		THEN
		ProcDefineReflectionDialog("RC_DW_WC_RD_LucianDeathfog",_Player);
		PartySetFlag((CHARACTERGUID)_Player,"QuestUpdate_RC_DW_ShadowOverDriftwood_MordusToldAboutDeathFog");
		
		IF
		GameBookInterfaceClosed(ITEMGUID_S_RC_WH_Peacemaker_Note_288d664c-efa7-463b-8d0b-dc99be3c37b1,(CHARACTERGUID)_Player)
		THEN
		ProcDefineReflectionDialog("RC_DW_WC_RD_LucianDeathfog",_Player);
		
		IF
		GameBookInterfaceClosed(ITEMGUID_S_RC_DW_WC_PeacekeeperManifesto_1d25feb1-d456-4609-a263-9be77b5dd0f2,(CHARACTERGUID)_Player)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_KnowAboutDeathFogInCave");
		ProcDefineReflectionDialog("RC_DW_WC_RD_LucianDeathfog",_Player);
		
		IF
		GameBookInterfaceClosed(ITEMGUID_S_RC_DW_WC_PeacekeeperManifesto_1d25feb1-d456-4609-a263-9be77b5dd0f2,(CHARACTERGUID)_Player)
		AND
		QueryOnlyOnce("RC_WC_BST_VB_MissingDeathFog")
		AND
		ObjectIsInTrigger(_Player, TRIGGERGUID_S_RC_WC_BST_MissingDeathFog_1d83272f-98d1-46be-a1ac-55cc82f957b9, 1)
		THEN
		StartVoiceBark("RC_WC_BST_VB_MissingDeathFog", _Player);
		//END_REGION
		
		//REGION Achievement - DOS2_Quest40
		
		IF
		ItemDestroyed(_EggItem)
		AND
		DB_RC_DW_WC_Achievement_EggItem(_EggItem)
		THEN
		NOT DB_RC_DW_WC_Achievement_EggItem(_EggItem);
		Proc_ProgressAchievement(NULL_00000000-0000-0000-0000-000000000000,"DOS2_Quest40"); //Proc_RC_DW_WC_Achievement_CheckRemainingEgg();
		
		IF
		CharacterDied(_EggChar)
		AND
		DB_RC_DW_WC_Achievement_EggChar(_EggChar)
		THEN
		NOT DB_RC_DW_WC_Achievement_EggChar(_EggChar);
		Proc_ProgressAchievement(NULL_00000000-0000-0000-0000-000000000000,"DOS2_Quest40"); //Proc_RC_DW_WC_Achievement_CheckRemainingEgg();
		
		
		//END_REGION
		
	}
	EXIT
	{
		
	}
}
Goal(449).Title("RC_DW_WreckersCave_AfterBossFight");
Goal(449)
{
	INIT
	{
		
	}
	KB
	{
		//REGION Moved here from RC_DW_WreckersBossFight because we need it for savegame patching
		// RC_DW_WreckersBossFight completes after the fight ends, and the patching is post-fight
		QRY
		QRY_RC_DW_WC_GetMordusCombatID()
		AND
		// Insect is dead -> left combat
		DB_WasInCombat(CHARACTERGUID_S_RC_DW_WC_BossFight_GiantInsect_Boss_5362d05e-1cb2-451f-9f5a-69078100a01b,_ID)
		THEN
		DB_RC_DW_WC_MordusCombatID(_ID);
		
		QRY
		QRY_RC_DW_WC_GetMordusCombatID()
		AND
		// Mordus skeleton in combat or not (set faction to neutral, but combat may not yet have ended)
		DB_CombatCharacters(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_ID)
		THEN
		DB_RC_DW_WC_MordusCombatID(_ID);
		
		QRY
		QRY_RC_DW_WC_GetMordusCombatID()
		AND
		// Mordus skeleton in combat or not (set faction to neutral, but combat may not yet have ended)
		DB_WasInCombat(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_ID)
		THEN
		DB_RC_DW_WC_MordusCombatID(_ID);
		//END_REGION
		
		//REGION Players entering the fight zone after Mordus has been killed
		IF
		CharacterEnteredTrigger(_Player, TRIGGERGUID_S_RC_DW_WC_BossFight_Area_Box_ec8d525b-6b89-4737-a069-8067ec3ec14d)
		AND
		ObjectGetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_EnteredWreckersCave",1)
		AND
		PartyGetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss",0)
		THEN
		PartySetFlag(_Player, "QuestUpdate_RC_DW_WC_AtaraxianLair_DidNotKillBoss");
		TriggerUnregisterForCharacter(TRIGGERGUID_S_RC_DW_WC_BossFight_Area_Box_ec8d525b-6b89-4737-a069-8067ec3ec14d, _Player);
		//END_REGION
		
		//REGION Mordus after the battle
		PROC
		PROC_RC_DW_WC_BossFight_EndQuest()
		THEN
		DB_RC_DW_WC_MordusCombatFinished(1);
		CharacterSetHitpointsPercentage(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1.0);
		SetStoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"ClearPeaceReturn");
		//END_REGION
		
		
		//REGION Dialog with Mordus after the battle
		PROC
		PROC_GLOBAL_DialogStartRequested(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Player)
		AND
		DB_RC_DW_WC_MordusCombatFinished(1)
		THEN
		NOT DB_RC_DW_WC_MordusCombatFinished(1);
		RemoveStatus(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"CHICKEN");
		Proc_StartDialog(0,"RC_DW_WC_BossFight_Mordus",CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Player);
		
		PROC
		ProcObjectTimerFinished(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_RealMordusSpawned")
		AND
		DB_RC_DW_WC_MordusCombatFinished(1)
		THEN
		SetStoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RestartSpotting");
		
		PROC
		ProcObjectTimerFinished(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_RealMordusSpawned")
		THEN 	
		CharacterSetAnimationOverride(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"cower");
		
		PROC
		ProcObjectTimerFinished(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_RealMordusSpawned")
		AND
		DB_RC_DW_WC_MordusCombatFinished(1)
		AND
		DB_IsPlayer(_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Player,CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853)
		AND
		QueryOnlyOnce("RC_DW_WC_BossFight_Mordus")
		THEN
		NOT DB_RC_DW_WC_MordusCombatFinished(1);
		RemoveStatus(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"CHICKEN");
		Proc_StartDialog(0,"RC_DW_WC_BossFight_Mordus",CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Player);
		
		IF
		StoryEvent(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"GLO_SpotterSneaker")
		AND
		DB_RC_DW_WC_MordusCombatFinished(1)
		AND
		GetVarObject(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"SpottedDude",_Player)
		THEN
		NOT DB_RC_DW_WC_MordusCombatFinished(1);
		ProcForceStopDialog(_Player);
		RemoveStatus(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"CHICKEN");
		Proc_StartDialog(0,"RC_DW_WC_BossFight_Mordus",CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,_Player);
		
		
		// Player in the dialog consumes the voidwoken heart
		// The undead version of the dialog does not mention you get sick -> don't eat void version
		// (not consistent with mechanics :( )
		IF
		ObjectFlagSet("RC_DW_WC_AteVoidwokenHeart",_Player,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		AND
		IsTagged(_Player,"UNDEAD",1)
		AND
		CharacterConsume((CHARACTERGUID)_Player,"CON_BodyPart_Dummy",_)
		THEN
		DB_NOOP(1);
		
		IF
		ObjectFlagSet("RC_DW_WC_AteVoidwokenHeart",_Player,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		AND
		IsTagged(_Player,"UNDEAD",0)
		AND
		CharacterConsume((CHARACTERGUID)_Player,"CON_BodyPart_Void",_)
		THEN
		// Compensate for the fact that we're story NPC and that the effect would probably be blocked by armor anyway
		ApplyStatus(_Player,"DISEASED",6.0,1);
		
		IF
		DialogEnded("RC_DW_WC_BossFight_Mordus",_Inst)
		AND
		DB_DialogPlayers(_Inst,_Player,1)
		AND
		PartyGetFlag((CHARACTERGUID)_Player,"RC_DW_WC_MordusTaughtSource",1)
		THEN
		PartySetFlag((CHARACTERGUID)_Player,"RC_DW_Meistr_SourceKnowledge_Mordus");
		
		IF
		DialogEnded("RC_DW_WC_BossFight_Mordus",_ID)
		AND
		GlobalGetFlag("RC_DW_WC_BossFight_AttackBoss",1)
		THEN
		CharacterSetImmortal(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,0);
		CharacterDie(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1,"DoT");
		
		IF
		DialogEnded("RC_DW_WC_BossFight_Mordus",_ID)
		AND
		DB_GlobalFlag("RC_DW_WC_BossFight_AttackBoss")
		AND
		DB_DialogPlayers(_ID,_Player,_)
		THEN
		ObjectSetFlag(_Player,"GLO_PathOfBlood_MurderedInnocent");
		
		IF
		DialogEnded("RC_DW_WC_BossFight_Mordus",_ID)
		AND
		ObjectGetFlag(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,"RC_DW_WC_MordusDieWithTreasure",1)
		THEN
		CharacterSetImmortal(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,0);
		CharacterDie(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,1,"DoT");
		
		IF
		DialogEnded("RC_DW_WC_BossFight_Mordus",_ID)
		AND
		GlobalGetFlag("RC_DW_WC_BossFight_BossFlee",1)
		THEN
		CharacterDisappearOutOfSight(CHARACTERGUID_S_RC_DW_WC_BossFight_Skeleton_Mordus_d46ade3f-f786-4fcc-975c-361a106f2853,170,1,"",1);
		//END_REGION
		
		//REGION Debug
		IF
		TextEventSet("mordusfled")
		AND
		CharacterGetHostCharacter(_Player)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss");
		GlobalSetFlag("RC_DW_WC_BossFight_BossFlee");
		
		IF
		TextEventSet("mordusdead")
		AND
		CharacterGetHostCharacter(_Player)
		THEN
		PartySetFlag(_Player,"QuestUpdate_RC_DW_WC_AtaraxianLair_KilledBoss");
		GlobalSetFlag("RC_DW_WC_BossFight_AttackBoss");
		
		//END_REGION
		
		PROC
		ProcRegionEnded("RC_Main")
		THEN
		TriggerUnregisterForPlayers(TRIGGERGUID_S_RC_DW_WC_BossFight_Area_Box_ec8d525b-6b89-4737-a069-8067ec3ec14d);
		GoalCompleted;
		
	}
	EXIT
	{
		
	}
}
