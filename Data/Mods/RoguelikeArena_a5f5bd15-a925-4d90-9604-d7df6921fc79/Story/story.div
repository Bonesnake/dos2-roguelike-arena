		DB_LV_Runner_TranslatedStringVar(78,"Translate78_00cbecbb-5ea5-42c2-a305-9421bef0fc80");
		DB_LV_Runner_TranslatedStringVar(79,"Translate79_f1c159d9-84c2-4625-ba6f-4efc8ff7b969");
